# Text files are stored and checked out with LF line endings on every platform,
# so the bytes a Linux Bridge reads are the bytes a Windows editor wrote.
* text=auto eol=lf

# Digested files. Their bytes must keep matching the digests recorded in
# ro-crate-metadata.json, so git must never normalise them.
schema/**             -text
fixtures/in/**        -text
fixtures/expected/**  -text
fixtures/findings/**  -text
fixtures/facts/**     -text
