PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX v3:     <urn:hl7-org:v3>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ccda:   <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A code an allergy states that the concept map allergy.rq reads it through
# does not hold. A path holds the values of every observation an allergy nests,
# so the accounting cannot name the map; this does, by template.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?refinement ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?actSlot ?act .
  ?act a v3:act .
  {
    ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?statementSlot ?allergy .
    BIND (CONCAT(STRAFTER(STR(?relationshipSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?innerSlots)
  }
  UNION
  {
    ?act ?statementSlot ?allergy .
    BIND (STRAFTER(STR(?statementSlot), "#_") AS ?innerSlots)
  }
  ?allergy a v3:observation ; ?templateSlot ?template .
  ?template a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.7" .
  ?row ccda:statementAt ?slots ; ccda:refinement ?refinement .
  FILTER (?slots = CONCAT(
          STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
          STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
          STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?actSlot), "#_"), ".", ?innerSlots))
  {
    ?allergy ?vS ?coded . ?coded a v3:value ; xyz:code ?value .
    FILTER NOT EXISTS {
      ?concept skos:inScheme ?scheme ; skos:notation ?key .
      FILTER (?scheme IN (ccda:allergyIntoleranceTypes, ccda:allergyIntoleranceCategories))
      FILTER (?key = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
    }
    BIND (ccda:allergyTypeNotMapped AS ?gap)
  }
  UNION
  {
    ?allergy (!rdf:type)+ ?observation .
    ?observation a v3:observation ; ?otS ?ot ; ?ovS ?coded .
    ?ot a v3:templateId ; xyz:root ?nested .
    ?coded a v3:value ; xyz:code ?value .
    VALUES (?nested ?scheme ?gap) {
      ("2.16.840.1.113883.10.20.22.4.28"  ccda:allergyStatuses ccda:allergyStatusNotMapped)
      ("2.16.840.1.113883.10.20.22.4.145" ccda:criticalities   ccda:criticalityNotMapped)
      ("2.16.840.1.113883.10.20.22.4.8"   ccda:severities      ccda:severityNotMapped)
    }
    FILTER NOT EXISTS {
      ?concept skos:inScheme ?scheme ; skos:notation ?key .
      FILTER (?key = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
    }
  }
  UNION
  {
    {
      ?allergy ?paS ?participant . ?participant a v3:participant ; ?prS ?role .
      ?role a v3:participantRole ; ?peS ?entity . ?entity a v3:playingEntity .
      { ?entity ?cS ?coding . ?coding a v3:code }
      UNION
      { ?entity ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
    }
    UNION
    {
      ?allergy ?rS ?reactionRelationship . ?reactionRelationship a v3:entryRelationship ; ?oS ?reaction .
      ?reaction a v3:observation ; ?rtS ?rt ; ?vS ?coding .
      ?rt a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.9" .
      ?coding a v3:value .
    }
    ?coding xyz:code ?codeValue ; xyz:codeSystem ?value .
    FILTER NOT EXISTS {
      ?system skos:inScheme ccda:codeSystems ; skos:notation ?systemKey .
      FILTER (?systemKey = LCASE(REPLACE(?value, "^urn:oid:", "")))
    }
    BIND (ccda:codeSystemNotMapped AS ?gap)
  }
}
