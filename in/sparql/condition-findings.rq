PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX v3:     <urn:hl7-org:v3>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ccda:   <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A status a problem states that the concept map condition.rq reads it through
# does not hold: its Problem Status Observation's, or, where it has none, its
# concern act's. And a code of its value with no code system, or a code
# system that is no OID, or no code, and a nullFlavor on its time or a bound of it that is no NullFlavor
# code, so no reason for the absent date is carried.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?refinement ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?actSlot ?act .
  ?act a v3:act .
  {
    ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?statementSlot ?condition .
    BIND (CONCAT(STRAFTER(STR(?relationshipSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?innerSlots)
  }
  UNION
  {
    ?act ?statementSlot ?condition .
    BIND (STRAFTER(STR(?statementSlot), "#_") AS ?innerSlots)
  }
  ?condition a v3:observation .
  FILTER EXISTS {
    ?condition ?templateSlot ?template .
    ?template a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.4" .
  }
  FILTER EXISTS {
    ?act ?concernSlot ?concern .
    ?concern a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.3" .
  }
  BIND (CONCAT(
          STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
          STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
          STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?actSlot), "#_"), ".", ?innerSlots) AS ?slots)
  ?row ccda:statementAt ?slots ; ccda:refinement ?refinement .
  BIND (EXISTS {
          ?condition ?anyS ?anyRelationship . ?anyRelationship a v3:entryRelationship ; ?anyO ?anyStatus .
          ?anyStatus a v3:observation ; ?anyT ?anyTemplate .
          ?anyTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
        } AS ?statedStatus)
  {
    ?condition ?rS ?statusRelationship . ?statusRelationship a v3:entryRelationship ; ?oS ?observation .
    ?observation a v3:observation ; ?otS ?ot ; ?ovS ?coded .
    ?ot a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
    ?coded a v3:value ; xyz:code ?value .
    OPTIONAL { ?coded xyz:codeSystem ?codeSystem }
    FILTER (COALESCE(REPLACE(?codeSystem, "^urn:oid:", ""), "") != "2.16.840.1.113883.6.96" || NOT EXISTS {
      ?concept skos:inScheme ccda:problemStatuses ; skos:notation ?key .
      FILTER (?key = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
    })
    BIND (ccda:problemStatusNotMapped AS ?gap)
  }
  UNION
  {
    ?act ?sS ?status . ?status a v3:statusCode ; xyz:code ?value .
    FILTER NOT EXISTS {
      ?concept skos:inScheme ccda:concernStatuses ; skos:notation ?key .
      FILTER (?key = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
    }
    BIND (ccda:concernStatusNotMapped AS ?gap)
  }
  UNION
  {
    { ?condition ?vS ?coding . ?coding a v3:value }
    UNION
    { ?condition ?vS ?coded . ?coded a v3:value ; ?trS ?coding . ?coding a v3:translation }
    OPTIONAL { ?coding xyz:code ?statedCode }
    OPTIONAL { ?coding xyz:codeSystem ?statedSystem }
    FILTER (BOUND(?statedCode) || BOUND(?statedSystem))
    BIND (LCASE(REPLACE(REPLACE(?statedSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")) AS ?statedKey)
    FILTER (!BOUND(?statedCode) || !BOUND(?statedSystem) || !REGEX(?statedKey, "^[0-2](\\.(0|[1-9][0-9]*))+$") || REPLACE(?statedCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") = "")
    BIND (COALESCE(?statedSystem, ?statedCode) AS ?value)
    BIND (ccda:codeNotCarried AS ?gap)
  }
  UNION
  {
    ?condition ?flavourTimeSlot ?flavourTime . ?flavourTime a v3:effectiveTime .
    { ?flavourTime xyz:nullFlavor ?value }
    UNION
    { ?flavourTime ?flavourBoundSlot ?flavourBound . ?flavourBound a ?flavourBoundType ; xyz:nullFlavor ?value .
      VALUES ?flavourBoundType { v3:low v3:high } }
    FILTER NOT EXISTS {
      ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey .
      FILTER (?flavourKey = LCASE(REPLACE(?value, "^[ \t\r\n]+|[ \t\r\n]+$", "")))
    }
    BIND (ccda:nullFlavorNotListed AS ?gap)
  }
  FILTER (?gap != ccda:concernStatusNotMapped || !?statedStatus)
}
