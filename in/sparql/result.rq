PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX xsi:      <http://www.w3.org/2001/XMLSchema-instance>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX v3:       <urn:hl7-org:v3>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX ccda:     <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A Result Observation the document table makes a record of.
#
# Only an observation's first value and first reference range are read. The
# value is of one of five kinds: a PQ, INT or REAL, or an IVL_PQ with one
# bound, is a quantity; an RTO a ratio; an IVL_PQ with two bounds a range, each
# number a node result-quantities.rq writes; a CD, CE, CV or CO is coded, its
# code and translations in SNOMED CT and LOINC written as code IRIs; an ST is
# text. A value with a null flavour has no kind: its flavour is the reason it is
# absent, the version's node #absent-resultValueKind, as a time's is the reason
# its property is absent. Of each text, the first of these the source states:
#   - the test's name: the narrative its code's originalText references, the
#     originalText's own text, the code's displayName;
#   - an ST value: its text; a CD, CE, CV or CO value: the narrative its
#     originalText references, the originalText's own text, its displayName.
#     Any other type is a finding of result-findings.rq. A value holding a
#     number result-quantities.rq refuses is text instead, its numbers as the
#     document wrote them and a PQ's or one-bound IVL_PQ's unit as its text,
#     so that no number is lost; result-findings.rq reports the number;
#   - a reference range: its text, through its reference first, else its
#     IVL_PQ written as the FHIR R4 adapter writes a range with no text, a
#     range with one bound as >=low or <=high; its typed bounds are
#     result-quantities.rq's.
# A narrative element is read whole, its text with element breaks, each break
# and run of whitespace one space; one holding no text falls through to the next of these, as does a
# reference to an ID two elements hold or one with no '#' (docs/format.md,
# "Narrative references").
# The test's code and each translation is carried, every one: one in LOINC or
# SNOMED CT as a cascade:testCode IRI, in the IRI space the vocabulary names;
# one in another code system as a cascade:testCodeInOtherSystem literal typed by
# the system's FHIR URI where ../../vocab/ccda-code-systems.ttl lists its OID,
# else by urn:oid: and the OID (docs/format.md, "Codes"). Every interpretation
# flag, and each translation of one, in HL7 ObservationInterpretation is a
# cascade:resultInterpretationCode IRI, its code as written; one in another
# code system is a finding of result-findings.rq. A time is read as allergy.rq
# reads an onset.
#
# Each template test, each narrative, each first value and range, and each set
# of fields is a subquery joined to the rows, never a FILTER [NOT] EXISTS, a
# comparison of strings or a UNION beside them: an engine may evaluate those
# once per row, scanning the whole document each time.

CONSTRUCT {
  ?version ?p ?o .
  ?version cascade:paddedDateTime ?paddedNode .
  ?paddedNode cascade:paddedDateTimeProperty ?p ;
    cascade:writtenDate ?writtenTime .
  ?version cascade:valueAbsentForReason ?absentNode .
  ?absentNode cascade:absentValueProperty ?absentProperty ;
    cascade:absentReasonCode ?absentReason .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?organizerSlot ?organizer .
  ?organizer a v3:organizer ; ?memberSlot ?member .
  ?member a v3:component ; ?statementSlot ?result .
  ?result a v3:observation .
  BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
               STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
               STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?organizerSlot), "#_"), ".",
               STRAFTER(STR(?memberSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?slots)
  ?row ccda:statementAt ?slots ; ccda:recordClass "Observation" .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?slots))) AS ?version)

  {
    {
      SELECT ?result ?p (MIN(?ranked) AS ?first) WHERE {
        {
          SELECT ?result ?p ?tier ?at ?within ?value WHERE {
            {
              ?result ?cS ?code . ?code a v3:code ; ?otS ?originalText . ?originalText a v3:originalText .
              {
                SELECT ?originalText ?within ?value WHERE {
                  ?originalText a v3:originalText ; ?rfS ?reference . ?reference a v3:reference ; xyz:value ?pointer .
                  BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?reference_)
                  FILTER (STRSTARTS(?reference_, "#") && STRLEN(?reference_) > 1)
                  BIND (STRAFTER(?reference_, "#") AS ?anchor)
                  {
                    SELECT ?anchor ?within ?value WHERE {
                      {
                        SELECT ?anchor (SAMPLE(?written) AS ?value) WHERE {
                          ?narrative xyz:ID ?anchor .
                          OPTIONAL {
                            ?narrative bridge:textWithElementBreaks ?text .
                            BIND (REPLACE(REPLACE(?text, "^[\\p{Z}\\p{Cc}\\p{Cf}]+|[\\p{Z}\\p{Cc}\\p{Cf}]+$", ""), "[\\p{Z}\\p{Cc}]+", " ") AS ?written)
                            FILTER (STRLEN(?written) > 0)
                          }
                        } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?written) = 1)
                      }
                      FILTER (isLiteral(?value))
                      BIND ("" AS ?within)
                    }
                  }
                }
              }
              BIND (cascade:testName AS ?p)
              BIND (STRAFTER(STR(?cS), "#_") AS ?at)
              BIND ("1" AS ?tier)
            }
            UNION
            {
              ?result ?cS ?code . ?code a v3:code ; ?otS ?originalText . ?originalText a v3:originalText ; ?vS ?value .
              FILTER (isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
              BIND (cascade:testName AS ?p)
              BIND (STRAFTER(STR(?cS), "#_") AS ?at)
              BIND ("2" AS ?tier)
              BIND (STRAFTER(STR(?vS), "#_") AS ?within)
            }
            UNION
            {
              ?result ?cS ?code . ?code a v3:code ; xyz:displayName ?value .
              BIND (cascade:testName AS ?p)
              BIND (STRAFTER(STR(?cS), "#_") AS ?at)
              BIND ("3" AS ?tier)
            }
            UNION
            {
              {
                SELECT ?result ?vlS ?resultValue WHERE {
                  ?result ?vlS ?resultValue . ?resultValue a v3:value .
                  {
                    SELECT ?result (MIN(xsd:integer(STRAFTER(STR(?anyS), "#_"))) AS ?firstAt) WHERE {
                      ?result ?anyS ?any . ?any a v3:value .
                    } GROUP BY ?result
                  }
                  FILTER (xsd:integer(STRAFTER(STR(?vlS), "#_")) = ?firstAt)
                }
              }
              {
                SELECT ?resultValue ?p ?tier ?value ?within WHERE {
                  {
                    ?resultValue a v3:value ; xsi:type ?written ; ?vS ?value .
                    FILTER (REPLACE(?written, "^.*:", "") = "ST" && isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
                    BIND (cascade:resultValue AS ?p)
                    BIND ("1" AS ?tier)
                    BIND (STRAFTER(STR(?vS), "#_") AS ?within)
                  }
                  UNION
                  {
                    ?resultValue a v3:value ; xsi:type ?written ; ?otS ?originalText . ?originalText a v3:originalText .
                    FILTER (REPLACE(?written, "^.*:", "") IN ("CD", "CE", "CV", "CO"))
                    {
                      SELECT ?originalText ?within ?value WHERE {
                        ?originalText a v3:originalText ; ?rfS ?reference . ?reference a v3:reference ; xyz:value ?pointer .
                        BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?reference_)
                        FILTER (STRSTARTS(?reference_, "#") && STRLEN(?reference_) > 1)
                        BIND (STRAFTER(?reference_, "#") AS ?anchor)
                        {
                          SELECT ?anchor ?within ?value WHERE {
                            {
                              SELECT ?anchor (SAMPLE(?written) AS ?value) WHERE {
                                ?narrative xyz:ID ?anchor .
                                OPTIONAL {
                                  ?narrative bridge:textWithElementBreaks ?text .
                                  BIND (REPLACE(REPLACE(?text, "^[\\p{Z}\\p{Cc}\\p{Cf}]+|[\\p{Z}\\p{Cc}\\p{Cf}]+$", ""), "[\\p{Z}\\p{Cc}]+", " ") AS ?written)
                                  FILTER (STRLEN(?written) > 0)
                                }
                              } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?written) = 1)
                            }
                            FILTER (isLiteral(?value))
                            BIND ("" AS ?within)
                          }
                        }
                      }
                    }
                    BIND (cascade:resultValue AS ?p)
                    BIND ("1" AS ?tier)
                  }
                  UNION
                  {
                    ?resultValue a v3:value ; xsi:type ?written ; ?otS ?originalText . ?originalText a v3:originalText ; ?vS ?value .
                    FILTER (REPLACE(?written, "^.*:", "") IN ("CD", "CE", "CV", "CO")
                            && isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
                    BIND (cascade:resultValue AS ?p)
                    BIND ("2" AS ?tier)
                    BIND (STRAFTER(STR(?vS), "#_") AS ?within)
                  }
                  UNION
                  {
                    ?resultValue a v3:value ; xsi:type ?written ; xyz:displayName ?value .
                    FILTER (REPLACE(?written, "^.*:", "") IN ("CD", "CE", "CV", "CO"))
                    BIND (cascade:resultValue AS ?p)
                    BIND ("3" AS ?tier)
                  }
                }
              }
              BIND (STRAFTER(STR(?vlS), "#_") AS ?at)
            }
            UNION
            {
              {
                SELECT ?result ?rrS ?range WHERE {
                  ?result ?rrS ?range . ?range a v3:referenceRange .
                  {
                    SELECT ?result (MIN(xsd:integer(STRAFTER(STR(?anyS), "#_"))) AS ?firstAt) WHERE {
                      ?result ?anyS ?any . ?any a v3:referenceRange .
                    } GROUP BY ?result
                  }
                  FILTER (xsd:integer(STRAFTER(STR(?rrS), "#_")) = ?firstAt)
                }
              }
              {
                SELECT ?range ?tier ?value ?within WHERE {
                  {
                    ?range a v3:referenceRange ; ?orS ?observationRange . ?observationRange a v3:observationRange ; ?txS ?text . ?text a v3:text .
                    {
                      SELECT ?text ?within ?value WHERE {
                        ?text a v3:text ; ?rfS ?reference . ?reference a v3:reference ; xyz:value ?pointer .
                        BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?reference_)
                        FILTER (STRSTARTS(?reference_, "#") && STRLEN(?reference_) > 1)
                        BIND (STRAFTER(?reference_, "#") AS ?anchor)
                        {
                          SELECT ?anchor ?within ?value WHERE {
                            {
                              SELECT ?anchor (SAMPLE(?written) AS ?value) WHERE {
                                ?narrative xyz:ID ?anchor .
                                OPTIONAL {
                                  ?narrative bridge:textWithElementBreaks ?text .
                                  BIND (REPLACE(REPLACE(?text, "^[\\p{Z}\\p{Cc}\\p{Cf}]+|[\\p{Z}\\p{Cc}\\p{Cf}]+$", ""), "[\\p{Z}\\p{Cc}]+", " ") AS ?written)
                                  FILTER (STRLEN(?written) > 0)
                                }
                              } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?written) = 1)
                            }
                            FILTER (isLiteral(?value))
                            BIND ("" AS ?within)
                          }
                        }
                      }
                    }
                    BIND ("1" AS ?tier)
                  }
                  UNION
                  {
                    ?range a v3:referenceRange ; ?orS ?observationRange . ?observationRange a v3:observationRange ; ?txS ?text .
                    ?text a v3:text ; ?vS ?value .
                    FILTER (isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
                    BIND ("2" AS ?tier)
                    BIND (STRAFTER(STR(?vS), "#_") AS ?within)
                  }
                  UNION
                  {
                    ?range a v3:referenceRange ; ?orS ?observationRange . ?observationRange a v3:observationRange ; ?bdS ?bounds .
                    ?bounds a v3:value .
                    OPTIONAL {
                      SELECT ?bounds ?lowValue ?lowUnit WHERE {
                        ?bounds ?lS ?low . ?low a v3:low ; xyz:value ?lowValue .
                        OPTIONAL { ?low xyz:unit ?lowUnit }
                      }
                    }
                    OPTIONAL {
                      SELECT ?bounds ?highValue ?highUnit WHERE {
                        ?bounds ?hS ?high . ?high a v3:high ; xyz:value ?highValue .
                        OPTIONAL { ?high xyz:unit ?highUnit }
                      }
                    }
                    FILTER (BOUND(?lowValue) || BOUND(?highValue))
                    BIND (IF(BOUND(?lowValue) && BOUND(?highValue), CONCAT(?lowValue, "-", ?highValue),
                             IF(BOUND(?lowValue), CONCAT(">=", ?lowValue), CONCAT("<=", ?highValue))) AS ?rangeBounds)
                    BIND (COALESCE(?lowUnit, ?highUnit) AS ?rangeUnit)
                    BIND (CONCAT(?rangeBounds, IF(BOUND(?rangeUnit), CONCAT(" ", ?rangeUnit), "")) AS ?value)
                    BIND ("3" AS ?tier)
                  }
                }
              }
              BIND (cascade:referenceRange AS ?p)
              BIND (STRAFTER(STR(?rrS), "#_") AS ?at)
            }
            UNION
            {
              ?result ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?value .
              FILTER (REGEX(?value, "^[0-9]{4}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?)?)?)?([+-][0-9]{4})?$"))
              BIND (cascade:resultClinicallyRelevantTime AS ?p)
              BIND (STRAFTER(STR(?eS), "#_") AS ?at)
              BIND ("1" AS ?tier)
            }
            UNION
            {
              ?result ?eS ?time . ?time a v3:effectiveTime ; ?lS ?low . ?low a v3:low ; xyz:value ?value .
              FILTER (REGEX(?value, "^[0-9]{4}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?)?)?)?([+-][0-9]{4})?$"))
              BIND (cascade:resultClinicallyRelevantTime AS ?p)
              BIND (STRAFTER(STR(?eS), "#_") AS ?at)
              BIND ("2" AS ?tier)
            }
            UNION
            {
              ?result ?eS ?time . ?time a v3:effectiveTime .
              { ?time xyz:nullFlavor ?flavour } UNION { ?time ?lS ?low . ?low a v3:low ; xyz:nullFlavor ?flavour }
              ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey ; skos:exactMatch ?flavourCode .
              FILTER (?flavourKey = LCASE(REPLACE(?flavour, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
              BIND (CONCAT("nullFlavor ", STR(?flavourCode)) AS ?value)
              BIND (cascade:resultClinicallyRelevantTime AS ?p)
              BIND ("9" AS ?tier)
              BIND (STRAFTER(STR(?eS), "#_") AS ?at)
            }
            UNION
            {
              ?result ?sS ?statusCode . ?statusCode a v3:statusCode ; xyz:code ?code .
              ?concept skos:inScheme ccda:resultStatuses ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
              ?match skos:notation ?value .
              FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
              BIND (cascade:workflowStatus AS ?p)
              BIND (STRAFTER(STR(?sS), "#_") AS ?at)
              BIND ("1" AS ?tier)
            }
          }
        }
        {
          SELECT DISTINCT ?result WHERE {
            ?result a v3:observation ; ?tS ?t .
            ?t a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.2" .
          }
        }
        BIND (COALESCE(?within, "") AS ?inner)
        BIND (CONCAT(?tier, SUBSTR("0000000000", STRLEN(?at) + 1), ?at,
                     SUBSTR("00000000000000000000", STRLEN(?inner) + 1), ?inner, "|", ?value) AS ?ranked)
      } GROUP BY ?result ?p
    }
    BIND (STRAFTER(?first, "|") AS ?value)
    BIND (IF(?p != cascade:resultClinicallyRelevantTime, ?value,
          IF(REGEX(?value, "^[0-9]{10}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2),
                          "T", SUBSTR(?value, 9, 2), ":", IF(REGEX(?value, "^[0-9]{12}"), SUBSTR(?value, 11, 2), "00"), ":",
                          IF(REGEX(?value, "^[0-9]{14}"), REPLACE(?value, "^[0-9]{12}([0-9]{2}(\\.[0-9]+)?).*$", "$1"), "00"),
                          IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")),
                   xsd:dateTime),
          IF(REGEX(?value, "^[0-9]{8}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:date),
          IF(REGEX(?value, "^[0-9]{6}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYearMonth),
          IF(REGEX(?value, "^[0-9]{4}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYear),
             1/0))))) AS ?o)
    BIND (IF(?p IN (cascade:resultClinicallyRelevantTime) && REGEX(?value, "^[0-9]{10}([0-9]{2})?([+-][0-9]{4})?$"),
             CONCAT("#padded-", STRAFTER(STR(?p), "#")), 1/0) AS ?paddedFragment)
    BIND (IF(BOUND(?paddedFragment), ?value, 1/0) AS ?writtenTime)
    BIND (IF(STRSTARTS(?value, "nullFlavor "), CONCAT("#absent-", STRAFTER(STR(?p), "#")), 1/0) AS ?absentFragment)
    BIND (IF(BOUND(?absentFragment), ?p, 1/0) AS ?absentProperty)
    BIND (IF(BOUND(?absentFragment), IRI(STRAFTER(?value, "nullFlavor ")), 1/0) AS ?absentReason)
  }
  UNION
  {
    SELECT ?result ?p ?o WHERE {
      {
        { ?result ?cS ?coding . ?coding a v3:code }
        UNION
        { ?result ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
        ?coding xyz:code ?statedTestCode ; xyz:codeSystem ?codeSystem .
        ?system skos:notation ?systemKey ; void:uriSpace ?stem .
        VALUES ?system { ccda:codeSystemLoinc ccda:codeSystemSnomedCt }
        FILTER (?systemKey = LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")))
        BIND (REPLACE(?statedTestCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?testCode)
        FILTER (?testCode != "")
        BIND (cascade:testCode AS ?p)
        BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?testCode))) AS ?o)
      }
      UNION
      {
        { ?result ?cS ?coding . ?coding a v3:code }
        UNION
        { ?result ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
        ?coding xyz:code ?testCode ; xyz:codeSystem ?codeSystem .
        BIND (COALESCE(LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")), "") AS ?systemKey)
        OPTIONAL { ?listed skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; cascade:codingSystemUri ?listedUri }
        BIND (COALESCE(STR(?listedUri), IF(REGEX(?systemKey, "^[0-2](\\.(0|[1-9][0-9]*))+$"), CONCAT("urn:oid:", ?systemKey), 1/0)) AS ?datatype)
        FILTER (?datatype NOT IN ("http://loinc.org", "http://snomed.info/sct"))
        BIND (REPLACE(?testCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?otherCode)
        FILTER (?otherCode != "")
        BIND (cascade:testCodeInOtherSystem AS ?p)
        BIND (STRDT(?otherCode, IRI(?datatype)) AS ?o)
      }
      UNION
      {
        { ?result ?iS ?flagCoding . ?flagCoding a v3:interpretationCode }
        UNION
        { ?result ?iS ?flagged . ?flagged a v3:interpretationCode ; ?ftS ?flagCoding . ?flagCoding a v3:translation }
        ?flagCoding xyz:code ?flag ; xyz:codeSystem ?flagSystem .
        ccda:codeSystemObservationInterpretation skos:notation ?flagKey ; void:uriSpace ?flagStem .
        FILTER (?flagKey = LCASE(REPLACE(REPLACE(?flagSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")))
        BIND (REPLACE(?flag, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?flagCode)
        FILTER (?flagCode != "")
        BIND (cascade:resultInterpretationCode AS ?p)
        BIND (IRI(CONCAT(?flagStem, ENCODE_FOR_URI(?flagCode))) AS ?o)
      }
      UNION
      {
        {
          SELECT ?result ?resultValue ?type WHERE {
            ?result ?vlS ?resultValue . ?resultValue a v3:value ; xsi:type ?written .
            {
              SELECT ?result (MIN(xsd:integer(STRAFTER(STR(?anyS), "#_"))) AS ?firstAt) WHERE {
                ?result ?anyS ?any . ?any a v3:value .
              } GROUP BY ?result
            }
            FILTER (xsd:integer(STRAFTER(STR(?vlS), "#_")) = ?firstAt)
            BIND (REPLACE(?written, "^.*:", "") AS ?type)
          }
        }
        OPTIONAL {
          {
            SELECT ?resultValue (COUNT(DISTINCT ?bound) AS ?bounds) WHERE {
              ?resultValue a v3:value ; ?boundS ?bound . ?bound a ?side ; xyz:value ?boundValue .
              VALUES ?side { v3:low v3:high }
            } GROUP BY ?resultValue
          }
        }
        OPTIONAL { ?resultValue xyz:nullFlavor ?absent }
        FILTER (!BOUND(?absent))
        OPTIONAL {
          {
            SELECT DISTINCT ?resultValue (true AS ?valueRefused) WHERE {
              ?resultValue a v3:value .
              {
                ?resultValue xyz:value ?refusedWritten .
                BIND (false AS ?refusedOpen)
              }
              UNION
              {
                ?resultValue ?refusedS ?refusedPart . ?refusedPart a ?refusedSide ; xyz:value ?refusedWritten .
                VALUES ?refusedSide { v3:numerator v3:denominator v3:low v3:high }
                OPTIONAL { ?refusedPart xyz:inclusive ?refusedInclusive }
                OPTIONAL {
                  {
                    SELECT ?resultValue (COUNT(DISTINCT ?refusedAnyBound) AS ?refusedBounds) WHERE {
                      ?resultValue a v3:value ; ?refusedAnyS ?refusedAnyBound .
                      ?refusedAnyBound a ?refusedAnySide ; xyz:value ?refusedAnyValue .
                      VALUES ?refusedAnySide { v3:low v3:high }
                    } GROUP BY ?resultValue
                  }
                }
                BIND (COALESCE(?refusedInclusive, "true") = "false" && COALESCE(?refusedBounds, 0) = 2 AS ?refusedOpen)
              }
              BIND (REPLACE(REPLACE(?refusedWritten, "^[+-]", ""), "[eE].*$", "") AS ?refusedMantissa)
              BIND (IF(CONTAINS(?refusedMantissa, "."), STRBEFORE(?refusedMantissa, "."), ?refusedMantissa) AS ?refusedWhole)
              BIND (STRLEN(?refusedWhole)
                    + IF(REGEX(?refusedWritten, "[eE]"), xsd:integer(REPLACE(?refusedWritten, "^[^eE]*[eE]", "")), 0) AS ?refusedPoint)
              FILTER (!REGEX(?refusedWritten, "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$")
                      || COALESCE(?refusedPoint + 20 < 0
                                  || ?refusedPoint - STRLEN(CONCAT(?refusedWhole, STRAFTER(?refusedMantissa, "."))) > 20, true)
                      || ?refusedOpen)
            }
          }
        }
        BIND (cascade:resultValueKind AS ?p)
        BIND (IF(BOUND(?valueRefused), cascade:TextResultValue,
              IF(?type IN ("PQ", "INT", "REAL") || (?type = "IVL_PQ" && COALESCE(?bounds, 0) = 1), cascade:QuantityResultValue,
              IF(STRSTARTS(?type, "RTO"), cascade:RatioResultValue,
              IF(?type = "IVL_PQ" && COALESCE(?bounds, 0) = 2, cascade:RangeResultValue,
              IF(?type IN ("CD", "CE", "CV", "CO"), cascade:CodedResultValue,
              IF(?type = "ST", cascade:TextResultValue, 1/0)))))) AS ?o)
      }
      UNION
      {
        {
          SELECT ?result ?resultValue ?type WHERE {
            ?result ?vlS ?resultValue . ?resultValue a v3:value ; xsi:type ?written .
            {
              SELECT ?result (MIN(xsd:integer(STRAFTER(STR(?anyS), "#_"))) AS ?firstAt) WHERE {
                ?result ?anyS ?any . ?any a v3:value .
              } GROUP BY ?result
            }
            FILTER (xsd:integer(STRAFTER(STR(?vlS), "#_")) = ?firstAt)
            BIND (REPLACE(?written, "^.*:", "") AS ?type)
          }
        }
        {
          SELECT DISTINCT ?resultValue (true AS ?valueRefused) WHERE {
            ?resultValue a v3:value .
            {
              ?resultValue xyz:value ?refusedWritten .
              BIND (false AS ?refusedOpen)
            }
            UNION
            {
              ?resultValue ?refusedS ?refusedPart . ?refusedPart a ?refusedSide ; xyz:value ?refusedWritten .
              VALUES ?refusedSide { v3:numerator v3:denominator v3:low v3:high }
              OPTIONAL { ?refusedPart xyz:inclusive ?refusedInclusive }
              OPTIONAL {
                {
                  SELECT ?resultValue (COUNT(DISTINCT ?refusedAnyBound) AS ?refusedBounds) WHERE {
                    ?resultValue a v3:value ; ?refusedAnyS ?refusedAnyBound .
                    ?refusedAnyBound a ?refusedAnySide ; xyz:value ?refusedAnyValue .
                    VALUES ?refusedAnySide { v3:low v3:high }
                  } GROUP BY ?resultValue
                }
              }
              BIND (COALESCE(?refusedInclusive, "true") = "false" && COALESCE(?refusedBounds, 0) = 2 AS ?refusedOpen)
            }
            BIND (REPLACE(REPLACE(?refusedWritten, "^[+-]", ""), "[eE].*$", "") AS ?refusedMantissa)
            BIND (IF(CONTAINS(?refusedMantissa, "."), STRBEFORE(?refusedMantissa, "."), ?refusedMantissa) AS ?refusedWhole)
            BIND (STRLEN(?refusedWhole)
                  + IF(REGEX(?refusedWritten, "[eE]"), xsd:integer(REPLACE(?refusedWritten, "^[^eE]*[eE]", "")), 0) AS ?refusedPoint)
            FILTER (!REGEX(?refusedWritten, "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)([eE][+-]?[0-9]+)?$")
                    || COALESCE(?refusedPoint + 20 < 0
                                || ?refusedPoint - STRLEN(CONCAT(?refusedWhole, STRAFTER(?refusedMantissa, "."))) > 20, true)
                    || ?refusedOpen)
          }
        }
        OPTIONAL { ?resultValue xyz:value ?plainValue }
        OPTIONAL { ?resultValue xyz:unit ?plainUnit }
        OPTIONAL {
          SELECT ?resultValue ?numeratorValue WHERE {
            ?resultValue a v3:value ; ?nS ?numerator . ?numerator a v3:numerator ; xyz:value ?numeratorValue .
          }
        }
        OPTIONAL {
          SELECT ?resultValue ?denominatorValue WHERE {
            ?resultValue a v3:value ; ?dS ?denominator . ?denominator a v3:denominator ; xyz:value ?denominatorValue .
          }
        }
        OPTIONAL {
          SELECT ?resultValue ?lowValue ?lowUnit ?lowInclusive WHERE {
            ?resultValue a v3:value ; ?lS ?low . ?low a v3:low ; xyz:value ?lowValue .
            OPTIONAL { ?low xyz:unit ?lowUnit }
            OPTIONAL { ?low xyz:inclusive ?lowInclusive }
          }
        }
        OPTIONAL {
          SELECT ?resultValue ?highValue ?highUnit ?highInclusive WHERE {
            ?resultValue a v3:value ; ?hS ?high . ?high a v3:high ; xyz:value ?highValue .
            OPTIONAL { ?high xyz:unit ?highUnit }
            OPTIONAL { ?high xyz:inclusive ?highInclusive }
          }
        }
        BIND (BOUND(?lowValue) && BOUND(?highValue) AS ?twoBounds)
        BIND (IF(?type IN ("PQ", "INT", "REAL"), ?plainValue,
              IF(STRSTARTS(?type, "RTO"), CONCAT(COALESCE(?numeratorValue, ""), ":", COALESCE(?denominatorValue, "")),
              IF(?twoBounds, CONCAT(?lowValue, "-", ?highValue, IF(BOUND(?lowUnit) || BOUND(?highUnit), CONCAT(" ", COALESCE(?lowUnit, ?highUnit)), "")),
              IF(BOUND(?lowValue), CONCAT(IF(COALESCE(?lowInclusive, "true") = "false", ">", ">="), ?lowValue),
                 CONCAT(IF(COALESCE(?highInclusive, "true") = "false", "<", "<="), ?highValue))))) AS ?text)
        BIND (IF(?type IN ("PQ", "INT", "REAL"), ?plainUnit,
              IF(?type = "IVL_PQ" && !?twoBounds, COALESCE(?lowUnit, ?highUnit), 1/0)) AS ?unit)
        VALUES ?p { cascade:resultValue cascade:resultUnit }
        BIND (IF(?p = cascade:resultValue, ?text, ?unit) AS ?o)
      }
      UNION
      {
        {
          SELECT ?result ?resultValue ?type WHERE {
            ?result ?vlS ?resultValue . ?resultValue a v3:value ; xsi:type ?written .
            {
              SELECT ?result (MIN(xsd:integer(STRAFTER(STR(?anyS), "#_"))) AS ?firstAt) WHERE {
                ?result ?anyS ?any . ?any a v3:value .
              } GROUP BY ?result
            }
            FILTER (xsd:integer(STRAFTER(STR(?vlS), "#_")) = ?firstAt)
            BIND (REPLACE(?written, "^.*:", "") AS ?type)
          }
        }
        {
          SELECT ?resultValue ?answer ?answerSystem WHERE {
            { ?resultValue a v3:value ; xyz:code ?answer ; xyz:codeSystem ?answerSystem . }
            UNION
            { ?resultValue a v3:value ; ?atS ?answerCoding . ?answerCoding a v3:translation ; xyz:code ?answer ; xyz:codeSystem ?answerSystem . }
          }
        }
        ?answerScheme skos:notation ?answerOid ; void:uriSpace ?answerStem .
        VALUES ?answerScheme { ccda:codeSystemSnomedCt ccda:codeSystemLoinc }
        FILTER (?type IN ("CD", "CE", "CV", "CO") && REPLACE(?answerSystem, "^urn:oid:", "") = ?answerOid)
        BIND (cascade:resultCode AS ?p)
        BIND (IRI(CONCAT(?answerStem, ENCODE_FOR_URI(?answer))) AS ?o)
      }
    }
  }
  UNION
  {
    {
      SELECT ?result (MIN(xsd:integer(STRAFTER(STR(?anyS), "#_"))) AS ?firstAt) WHERE {
        ?result ?anyS ?any . ?any a v3:value .
      } GROUP BY ?result
    }
    ?result ?vlS ?resultValue . ?resultValue a v3:value ; xyz:nullFlavor ?flavour .
    FILTER (xsd:integer(STRAFTER(STR(?vlS), "#_")) = ?firstAt)
    ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey ; skos:exactMatch ?absentReason .
    FILTER (?flavourKey = LCASE(REPLACE(?flavour, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
    BIND ("#absent-resultValueKind" AS ?absentFragment)
    BIND (cascade:resultValueKind AS ?absentProperty)
  }
  BIND (IF(BOUND(?paddedFragment), IRI(CONCAT(STR(?version), ?paddedFragment)), 1/0) AS ?paddedNode)
  BIND (IF(BOUND(?absentFragment), IRI(CONCAT(STR(?version), ?absentFragment)), 1/0) AS ?absentNode)
}
