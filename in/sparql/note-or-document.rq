PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX dom:      <https://dom.spec.whatwg.org/#dom-node->
PREFIX v3:       <urn:hl7-org:v3>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX ccda:     <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A note the document table makes a record of: a Note Activity, an entry's own
# act, as C-CDA on FHIR maps it to a DocumentReference, or a note section that
# holds no entry (docs/format.md, "What a record is").
#
# A Note Activity's type is its code's translations where it has one, else its
# code, as C-CDA on FHIR's notes page maps the root code 34109-9 and a more
# specific translation; its type name is the first translation's displayName,
# else its code's; its date is its first author's time; its text is the text of
# the narrative element its text references, else its text's own, else the
# decoded text of its text in base64 where that is plain text (no media type, or
# text/plain): HTML or RTF decoded would be markup, not the note's words, and is
# left out, as a PDF is; note-findings.rq names that loss. A text in base64 is
# also the note's one attachment, with its media type. An unstructured
# document's nonXMLBody is a note too, typed by its document's code, dated by
# its effectiveTime, its text read as a Note Activity's base64 is, and its text
# its one attachment, with its media type and the address of a file it only
# references. A
# section's type is its code, its type name the code's displayName, its title
# its title's text, its date the document's effectiveTime and its text its
# text's. A text is the lift's text with element breaks, a line for each block
# of the narrative. A note's status is current: a C-CDA states no other. A LOINC
# type is a cascade:noteOrDocumentType IRI, any other a
# cascade:noteOrDocumentTypeInOtherSystem literal typed by its system's URI. A
# time is typed by its precision, as result.rq types a result's.

CONSTRUCT {
  ?version ?p ?o .
  ?version cascade:paddedDateTime ?paddedNode .
  ?paddedNode cascade:paddedDateTimeProperty ?p ;
    cascade:writtenDate ?writtenTime .
  ?version cascade:attachment ?attachment .
  ?attachment cascade:attachmentContentType ?contentType ;
    cascade:attachmentUrl ?attachmentUrl .
}
WHERE {
  {
    ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
    ?outer a v3:component ; ?bodySlot ?body .
    ?body a v3:structuredBody ; ?componentSlot ?component .
    ?component a v3:component ; ?sectionSlot ?statement .
    ?statement a v3:section .
    BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
                 STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_")) AS ?slots)
  }
  UNION
  {
    ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
    ?outer a v3:component ; ?bodySlot ?body .
    ?body a v3:structuredBody ; ?componentSlot ?component .
    ?component a v3:component ; ?sectionSlot ?section .
    ?section a v3:section ; ?entrySlot ?entry . ?entry a v3:entry ; ?statementSlot ?statement . ?statement a v3:act .
    BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
                 STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
                 STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?slots)
  }
  UNION
  {
    ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
    ?outer a v3:component ; ?bodySlot ?statement . ?statement a v3:nonXMLBody .
    BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_")) AS ?slots)
  }
  ?row ccda:statementAt ?slots ; ccda:recordClass "DocumentReference" .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?slots))) AS ?version)

  {
    {
      SELECT ?statement ?p (MIN(?ranked) AS ?first) WHERE {
        {
          SELECT DISTINCT ?statement WHERE {
            {
              ?statement ?tS ?t . ?t a v3:templateId ; xyz:root ?templateRoot .
              VALUES ?templateRoot {
                "2.16.840.1.113883.10.20.22.4.202"
                "2.16.840.1.113883.10.20.22.2.8" "2.16.840.1.113883.10.20.22.2.9" "2.16.840.1.113883.10.20.22.2.10"
                "1.3.6.1.4.1.19376.1.5.3.1.3.4" "1.3.6.1.4.1.19376.1.5.3.1.3.5"
              }
            }
            UNION
            { ?statement a v3:nonXMLBody }
          }
        }
        {
          ?statement a v3:act ; ?cS ?code . ?code a v3:code ; ?trS ?translation .
          ?translation a v3:translation ; xyz:displayName ?value .
          FILTER (STRLEN(?value) > 0)
          BIND (cascade:noteOrDocumentTypeName AS ?p)
          BIND ("1" AS ?tier)
          BIND (STRAFTER(STR(?trS), "#_") AS ?at)
        }
        UNION
        {
          ?statement ?cS ?code . ?code a v3:code ; xyz:displayName ?value .
          FILTER (STRLEN(?value) > 0)
          BIND (cascade:noteOrDocumentTypeName AS ?p)
          BIND ("2" AS ?tier)
          BIND (STRAFTER(STR(?cS), "#_") AS ?at)
        }
        UNION
        {
          ?statement a v3:nonXMLBody .
          ?document a fx:root, v3:ClinicalDocument ; ?cS ?code . ?code a v3:code ; xyz:displayName ?value .
          FILTER (STRLEN(?value) > 0)
          BIND (cascade:noteOrDocumentTypeName AS ?p)
          BIND ("2" AS ?tier)
          BIND (STRAFTER(STR(?cS), "#_") AS ?at)
        }
        UNION
        {
          ?statement a v3:section ; ?tlS ?title . ?title a v3:title ; dom:textcontent ?written .
          BIND (REPLACE(REPLACE(?written, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "[ \\t\\r\\n]+", " ") AS ?value)
          BIND (cascade:noteOrDocumentTitle AS ?p)
          BIND ("1" AS ?tier)
          BIND (STRAFTER(STR(?tlS), "#_") AS ?at)
        }
        UNION
        {
          ?statement a ?statementType .
          VALUES ?statementType { v3:section v3:nonXMLBody }
          ?document a fx:root, v3:ClinicalDocument ; ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?value .
          FILTER (REGEX(?value, "^[0-9]{4}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?)?)?)?([+-][0-9]{4})?$"))
          BIND (cascade:noteOrDocumentDate AS ?p)
          BIND ("1" AS ?tier)
          BIND (STRAFTER(STR(?eS), "#_") AS ?at)
        }
        UNION
        {
          ?statement a v3:act ; ?aS ?author . ?author a v3:author ; ?atS ?time . ?time a v3:time ; xyz:value ?value .
          FILTER (REGEX(?value, "^[0-9]{4}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?)?)?)?([+-][0-9]{4})?$"))
          BIND (cascade:noteOrDocumentDate AS ?p)
          BIND ("1" AS ?tier)
          BIND (STRAFTER(STR(?aS), "#_") AS ?at)
        }
        UNION
        {
          ?statement ?xS ?text . ?text a v3:text ; ?rfS ?reference . ?reference a v3:reference ; xyz:value ?pointer .
          BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?trimmed)
          FILTER (STRSTARTS(?trimmed, "#") && STRLEN(?trimmed) > 1)
          BIND (STRAFTER(?trimmed, "#") AS ?anchor)
          {
            SELECT ?anchor (SAMPLE(?passage) AS ?value) WHERE {
              ?narrative xyz:ID ?anchor .
              OPTIONAL { ?narrative bridge:textWithElementBreaks ?passage }
            } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?passage) = 1)
          }
          BIND (cascade:narrativeText AS ?p)
          BIND ("1" AS ?tier)
          BIND (STRAFTER(STR(?xS), "#_") AS ?at)
        }
        UNION
        {
          ?statement ?xS ?text . ?text a v3:text ; bridge:textWithElementBreaks ?value .
          OPTIONAL { ?text xyz:representation ?representation }
          FILTER (COALESCE(UCASE(?representation), "") != "B64")
          BIND (cascade:narrativeText AS ?p)
          BIND ("2" AS ?tier)
          BIND (STRAFTER(STR(?xS), "#_") AS ?at)
        }
        UNION
        {
          ?statement ?xS ?text . ?text a v3:text ; bridge:textDecodedFromBase64 ?value .
          OPTIONAL { ?text xyz:mediaType ?decodedMediaType }
          FILTER (!BOUND(?decodedMediaType) || REGEX(?decodedMediaType, "^[ \\t]*text/plain[ \\t]*(;.*)?$", "i"))
          BIND (cascade:narrativeText AS ?p)
          BIND ("3" AS ?tier)
          BIND (STRAFTER(STR(?xS), "#_") AS ?at)
        }
        UNION
        {
          BIND (cascade:workflowStatus AS ?p)
          BIND ("current" AS ?value)
          BIND ("1" AS ?tier)
          BIND ("0" AS ?at)
        }
        BIND (CONCAT(?tier, SUBSTR("0000000000", STRLEN(?at) + 1), ?at, "|", ?value) AS ?ranked)
      } GROUP BY ?statement ?p
    }
    BIND (STRAFTER(?first, "|") AS ?value)
    FILTER (STRLEN(?value) > 0)
    BIND (IF(?p != cascade:noteOrDocumentDate, ?value,
          IF(REGEX(?value, "^[0-9]{10}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2),
                          "T", SUBSTR(?value, 9, 2), ":", IF(REGEX(?value, "^[0-9]{12}"), SUBSTR(?value, 11, 2), "00"), ":",
                          IF(REGEX(?value, "^[0-9]{14}"), REPLACE(?value, "^[0-9]{12}([0-9]{2}(\\.[0-9]+)?).*$", "$1"), "00"),
                          IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")),
                   xsd:dateTime),
          IF(REGEX(?value, "^[0-9]{8}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:date),
          IF(REGEX(?value, "^[0-9]{6}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYearMonth),
          IF(REGEX(?value, "^[0-9]{4}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYear),
             1/0))))) AS ?o)
    BIND (IF(?p = cascade:noteOrDocumentDate && REGEX(?value, "^[0-9]{10}([0-9]{2})?([+-][0-9]{4})?$"),
             "#padded-noteOrDocumentDate", 1/0) AS ?paddedFragment)
    BIND (IF(BOUND(?paddedFragment), ?value, 1/0) AS ?writtenTime)
  }
  UNION
  {
    SELECT ?statement ?p ?o WHERE {
      {
        SELECT ?statement ?coding WHERE {
          {
            ?statement a v3:section ; ?cS ?coding . ?coding a v3:code .
          }
          UNION
          {
            ?statement a v3:act ; ?cS ?coding . ?coding a v3:code .
            FILTER NOT EXISTS { ?coding ?anyS ?any . ?any a v3:translation }
          }
          UNION
          {
            ?statement a v3:act ; ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation .
          }
          UNION
          {
            ?statement a v3:nonXMLBody .
            ?document a fx:root, v3:ClinicalDocument ; ?cS ?coding . ?coding a v3:code .
          }
        }
      }
      ?coding xyz:code ?statedCode ; xyz:codeSystem ?codeSystem .
      BIND (REPLACE(?statedCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?typeCode)
      FILTER (?typeCode != "")
      BIND (COALESCE(LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")), "") AS ?systemKey)
      OPTIONAL { ccda:codeSystemLoinc skos:notation ?systemKey ; void:uriSpace ?loincStem }
      OPTIONAL { ?listed skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; cascade:codingSystemUri ?listedUri }
      BIND (COALESCE(STR(?listedUri), IF(REGEX(?systemKey, "^[0-2](\\.(0|[1-9][0-9]*))+$"), CONCAT("urn:oid:", ?systemKey), 1/0)) AS ?datatype)
      BIND (IF(BOUND(?loincStem), cascade:noteOrDocumentType, cascade:noteOrDocumentTypeInOtherSystem) AS ?p)
      BIND (IF(BOUND(?loincStem), IRI(CONCAT(STR(?loincStem), ENCODE_FOR_URI(?typeCode))), STRDT(?typeCode, IRI(?datatype))) AS ?o)
    }
  }
  UNION
  {
    # An unstructured document's note carries its document's id as its master
    # identifier, FHIR's DocumentReference.masterIdentifier, mapped as
    # result-identifiers.rq maps a result's ids.
    ?statement a v3:nonXMLBody .
    ?document a fx:root, v3:ClinicalDocument ; ?documentIdSlot ?documentId .
    ?documentId a v3:id ; xyz:root ?documentIdRoot .
    FILTER NOT EXISTS { ?documentId xyz:nullFlavor ?documentIdNullFlavor }
    OPTIONAL { ?documentId xyz:extension ?documentIdExtension FILTER (STRLEN(?documentIdExtension) > 0) }
    BIND (IF(REGEX(?documentIdRoot, "^[0-2](\\.(0|[1-9][0-9]*))+$"), CONCAT("urn:oid:", ?documentIdRoot),
          IF(REGEX(?documentIdRoot, "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"),
             CONCAT("urn:uuid:", LCASE(?documentIdRoot)), 1/0)) AS ?documentRootIri)
    BIND (IF(?documentIdRoot = "2.16.840.1.113883.4.6", "http://hl7.org/fhir/sid/us-npi", ?documentRootIri) AS ?documentIdSystem)
    BIND (cascade:noteOrDocumentMasterIdentifier AS ?p)
    BIND (IF(BOUND(?documentIdExtension), STRDT(?documentIdExtension, IRI(?documentIdSystem)),
             IF(?documentIdSystem = ?documentRootIri, STRDT(?documentRootIri, <urn:ietf:rfc:3986>), 1/0)) AS ?o)
  }
  UNION
  {
    ?statement a ?attachedType ; ?xS ?text . ?text a v3:text .
    VALUES ?attachedType { v3:act v3:nonXMLBody }
    OPTIONAL { ?text xyz:representation ?representation }
    OPTIONAL {
      ?text ?referenceSlot ?fileReference . ?fileReference a v3:reference ; xyz:value ?url .
      FILTER (?attachedType = v3:nonXMLBody)
    }
    FILTER (UCASE(COALESCE(?representation, "")) = "B64" || BOUND(?url))
    OPTIONAL { ?text xyz:mediaType ?mediaType }
    BIND (COALESCE(?mediaType, IF(BOUND(?url), 1/0, "text/plain")) AS ?contentType)
    BIND (IF(BOUND(?url), STRDT(?url, xsd:anyURI), 1/0) AS ?attachmentUrl)
    BIND ("#attachment-1" AS ?attachmentFragment)
  }
  BIND (IF(BOUND(?paddedFragment), IRI(CONCAT(STR(?version), ?paddedFragment)), 1/0) AS ?paddedNode)
  BIND (IF(BOUND(?attachmentFragment), IRI(CONCAT(STR(?version), ?attachmentFragment)), 1/0) AS ?attachment)
}
