PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX v3:     <urn:hl7-org:v3>
PREFIX sdtc:   <urn:hl7-org:sdtc>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ccda:   <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A nullFlavor that is no NullFlavor code where patient.rq would carry it as a
# reason, and a gender code patient.rq's concept map does not hold, or holds in
# another code system; each valued as written.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?refinement ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?rtSlot ?recordTarget .
  ?recordTarget a v3:recordTarget ; ?prSlot ?patientRole .
  ?patientRole a v3:patientRole ; ?pS ?patient .
  ?patient a v3:patient .
  {
    VALUES ?flavouredType { v3:birthTime v3:administrativeGenderCode sdtc:deceasedTime }
    ?patient ?eS ?element . ?element a ?flavouredType ; xyz:nullFlavor ?value .
    FILTER (?flavouredType != sdtc:deceasedTime || EXISTS {
      ?patient ?iS ?indicator . ?indicator a sdtc:deceasedInd ; xyz:value ?indicatorValue . FILTER (REPLACE(?indicatorValue, "^[ \t\r\n]+|[ \t\r\n]+$", "") = "true")
    })
    FILTER NOT EXISTS {
      ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey .
      FILTER (?flavourKey = LCASE(REPLACE(?value, "^[ \t\r\n]+|[ \t\r\n]+$", "")))
    }
    BIND (ccda:nullFlavorNotListed AS ?gap)
  }
  UNION
  {
    ?patient ?gS ?gender . ?gender a v3:administrativeGenderCode ; xyz:code ?value .
    OPTIONAL { ?gender xyz:codeSystem ?codeSystem }
    FILTER (COALESCE(REPLACE(?codeSystem, "^urn:oid:", ""), "") != "2.16.840.1.113883.5.1" || NOT EXISTS {
      ?concept skos:inScheme ccda:administrativeGenders ; skos:notation ?key .
      FILTER (?key = LCASE(REPLACE(?value, "^[ \t\r\n]+|[ \t\r\n]+$", "")))
    })
    BIND (ccda:administrativeGenderNotMapped AS ?gap)
  }
  BIND (CONCAT(STRAFTER(STR(?rtSlot), "#_"), ".", STRAFTER(STR(?prSlot), "#_")) AS ?slots)
  ?row ccda:statementAt ?slots ; ccda:refinement ?refinement .
}
