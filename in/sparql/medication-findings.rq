PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX xsi:    <http://www.w3.org/2001/XMLSchema-instance>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX v3:     <urn:hl7-org:v3>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ccda:   <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# Each element of a structured dosage a medication states, at the element,
# valued by its name. A periodic effectiveTime is a dosage's timing; an
# interval one is the medication's start and end. A route and a site are the
# accounting's ccda:codedRouteAndSite, and a status and codes
# entry-statement-findings.rq's.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?refinement ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?statementSlot ?medication .
  ?medication a v3:substanceAdministration .
  ?row ccda:recordClass "MedicationRequest" ; ccda:statementAt ?slots ; ccda:refinement ?medicationAt .
  FILTER (?slots = CONCAT(
          STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
          STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
          STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")))
  {
    ?medication ?dosingSlot ?dosing . ?dosing a ?dosingType .
    FILTER (?dosingType IN (v3:doseQuantity, v3:rateQuantity, v3:maxDoseQuantity, v3:administrationUnitCode)
            || (?dosingType = v3:effectiveTime && EXISTS {
                  ?dosing xsi:type ?written .
                  FILTER (REPLACE(?written, "^.*:", "") IN ("PIVL_TS", "EIVL_TS", "SXPR_TS"))
                }))
    {
      SELECT ?dosing (COUNT(?earlierDosing) + 1 AS ?dosingAt) WHERE {
        ?dosingParent ?dosingS ?dosing . ?dosingParent a v3:substanceAdministration . ?dosing a ?type .
        FILTER (?type IN (v3:doseQuantity, v3:rateQuantity, v3:maxDoseQuantity, v3:administrationUnitCode, v3:effectiveTime))
        OPTIONAL {
          ?dosingParent ?dosingE ?earlierDosing . ?earlierDosing a ?type .
          FILTER (xsd:integer(STRAFTER(STR(?dosingE), "#_")) < xsd:integer(STRAFTER(STR(?dosingS), "#_")))
        }
      } GROUP BY ?dosing
    }
    BIND (STRAFTER(STR(?dosingType), "urn:hl7-org:v3") AS ?value)
    BIND (ccda:structuredDosage AS ?gap)
    BIND (CONCAT("/*[local-name()='", ?value, "' and namespace-uri()='urn:hl7-org:v3'][", STR(?dosingAt), "]") AS ?dosingStep)
  }
  BIND (CONCAT(?medicationAt, COALESCE(?dosingStep, "")) AS ?refinement)
}
