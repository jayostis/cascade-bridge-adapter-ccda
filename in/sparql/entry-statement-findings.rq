PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX sh:     <http://www.w3.org/ns/shacl#>
PREFIX oa:     <http://www.w3.org/ns/oa#>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX fx:     <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX v3:     <urn:hl7-org:v3>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ccda:   <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A status an immunization, a procedure or a medication states that the
# concept map its mapping reads it through does not hold; a vaccine's code in a
# code system no predicate of an immunization carries; a code of a drug or a
# procedure with no code system, or a code system that is no OID, or no code, or
# a code of blanks; a procedure's CPT code other than the first, the one
# procedure.rq writes, as onlyFirstCarried; and a nullFlavor on its time or a
# bound of it that is no NullFlavor code. A statement whose negationInd is true is
# not-done whatever its statusCode says.

CONSTRUCT {
  [] a oa:Annotation ;
    oa:hasTarget [
      oa:hasSource bridge:thisRecord ;
      oa:hasSelector [ a oa:XPathSelector ; rdf:value ?refinement ]
    ] ;
    oa:hasBody ?gap ;
    oa:motivatedBy oa:classifying ;
    sh:value ?value .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?statementSlot ?statement .
  BIND (CONCAT(
          STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
          STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
          STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?slots)
  ?row ccda:statementAt ?slots ; ccda:recordClass ?class ; ccda:refinement ?refinement .
  {
    ?statement ?sS ?status . ?status a v3:statusCode ; xyz:code ?value .
    VALUES (?class ?scheme ?gap) {
      ("Immunization" ccda:immunizationStatuses ccda:immunizationStatusNotMapped)
      ("Procedure"    ccda:procedureStatuses    ccda:procedureStatusNotMapped)
      ("MedicationRequest" ccda:medicationStatuses ccda:medicationStatusNotMapped)
    }
    FILTER NOT EXISTS { ?statement xyz:negationInd "true" }
    FILTER NOT EXISTS {
      ?concept skos:inScheme ?scheme ; skos:notation ?key .
      FILTER (?key = LCASE(REPLACE(?value, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
    }
  }
  UNION
  {
    ?statement ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
    ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial ; ?cS ?code .
    ?code a v3:code .
    VALUES ?class { "Immunization" }
    { ?code xyz:codeSystem ?value . }
    UNION
    { ?code ?trS ?translation . ?translation a v3:translation ; xyz:codeSystem ?value . }
    FILTER (REPLACE(?value, "^urn:oid:", "") != "2.16.840.1.113883.12.292")
    BIND (ccda:codeNotCarried AS ?gap)
  }
  UNION
  {
    {
      ?statement ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
      ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial .
      { ?material ?cS ?coding . ?coding a v3:code }
      UNION
      { ?material ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
      BIND ("MedicationRequest" AS ?class)
    }
    UNION
    {
      { ?statement ?cS ?coding . ?coding a v3:code }
      UNION
      { ?statement ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
      BIND ("Procedure" AS ?class)
    }
    OPTIONAL { ?coding xyz:code ?statedCode }
    OPTIONAL { ?coding xyz:codeSystem ?statedSystem }
    FILTER (BOUND(?statedCode) || BOUND(?statedSystem))
    BIND (LCASE(REPLACE(REPLACE(?statedSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")) AS ?statedKey)
    FILTER (!BOUND(?statedCode) || !BOUND(?statedSystem) || !REGEX(?statedKey, "^[0-2](\\.(0|[1-9][0-9]*))+$") || REPLACE(?statedCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") = "")
    BIND (COALESCE(?statedSystem, ?statedCode) AS ?value)
    BIND (ccda:codeNotCarried AS ?gap)
  }
  UNION
  {
    {
      SELECT ?statement (MIN(?ranked) AS ?firstCpt) WHERE {
        { ?statement ?cS ?cpt . ?cpt a v3:code . BIND ("0" AS ?tier) BIND (STRAFTER(STR(?cS), "#_") AS ?at) }
        UNION
        { ?statement ?cS ?own . ?own a v3:code ; ?trS ?cpt . ?cpt a v3:translation . BIND ("1" AS ?tier) BIND (STRAFTER(STR(?trS), "#_") AS ?at) }
        ?cpt xyz:code ?stated ; xyz:codeSystem ?system .
        FILTER (LCASE(REPLACE(REPLACE(?system, "^[ \t\r\n]+|[ \t\r\n]+$", ""), "^urn:oid:", "", "i")) = "2.16.840.1.113883.6.12")
        BIND (REPLACE(?stated, "^[ \t\r\n]+|[ \t\r\n]+$", "") AS ?firstCode)
        FILTER (?firstCode != "")
        BIND (CONCAT(?tier, SUBSTR("0000000000", STRLEN(?at) + 1), ?at, "|", ?firstCode) AS ?ranked)
      } GROUP BY ?statement
    }
    { ?statement ?cS ?coding . ?coding a v3:code }
    UNION
    { ?statement ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
    ?coding xyz:code ?laterStated ; xyz:codeSystem ?laterSystem .
    FILTER (LCASE(REPLACE(REPLACE(?laterSystem, "^[ \t\r\n]+|[ \t\r\n]+$", ""), "^urn:oid:", "", "i")) = "2.16.840.1.113883.6.12")
    BIND (REPLACE(?laterStated, "^[ \t\r\n]+|[ \t\r\n]+$", "") AS ?value)
    FILTER (?value != "" && ?value != STRAFTER(?firstCpt, "|"))
    BIND ("Procedure" AS ?class)
    BIND (ccda:onlyFirstCarried AS ?gap)
  }
  UNION
  {
    ?statement ?flavourTimeSlot ?flavourTime . ?flavourTime a v3:effectiveTime .
    { ?flavourTime xyz:nullFlavor ?value }
    UNION
    { ?flavourTime ?flavourBoundSlot ?flavourBound . ?flavourBound a ?flavourBoundType ; xyz:nullFlavor ?value .
      VALUES ?flavourBoundType { v3:low v3:high } }
    FILTER NOT EXISTS {
      ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey .
      FILTER (?flavourKey = LCASE(REPLACE(?value, "^[ \t\r\n]+|[ \t\r\n]+$", "")))
    }
    BIND (ccda:nullFlavorNotListed AS ?gap)
  }
}
