PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX v3:       <urn:hl7-org:v3>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX ccda:     <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# An Allergy Intolerance Observation. Where the vocabulary holds one value and
# the source states several, the first in document order is carried:
#   - the allergen's name, read in this order: the narrative its code's
#     originalText references, the originalText's own text, the playing
#     entity's name, the code's displayName;
#   - the severity, from a Severity Observation on the allergy itself, else on
#     its first reaction, where C-CDA R2.1 puts it.
# A coded value is carried only through the concept map its rows were
# transcribed into, and only in the code system that map reads; a code outside it is a finding of allergy-findings.rq. An
# NDC names a packaged product, not the substance a person is allergic to, so it
# is never written as an allergen or a manifestation. A time is typed by its
# precision: a year, a month, a day, or a date-time where it states the second;
# one stating the hour or the minute is padded to the second, beside a node
# <version>#padded-<property> keeping what was written (docs/format.md,
# "Timestamps"). A null flavour where the time would be, with no time beside it,
# is a node <version>#absent-<property>, the reason the time is absent.

CONSTRUCT {
  ?version ?p ?o .
  ?version cascade:paddedDateTime ?paddedNode .
  ?paddedNode cascade:paddedDateTimeProperty ?p ;
    cascade:writtenDate ?writtenTime .
  ?version cascade:valueAbsentForReason ?absentNode .
  ?absentNode cascade:absentValueProperty ?absentProperty ;
    cascade:absentReasonCode ?absentReason .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?actSlot ?act .
  ?act a v3:act .
  {
    ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?statementSlot ?allergy .
    BIND (CONCAT(STRAFTER(STR(?relationshipSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?innerSlots)
  }
  UNION
  {
    ?act ?statementSlot ?allergy .
    BIND (STRAFTER(STR(?statementSlot), "#_") AS ?innerSlots)
  }
  ?allergy a v3:observation .
  FILTER EXISTS {
    ?allergy ?templateSlot ?template .
    ?template a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.7" .
  }
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(CONCAT(
          STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
          STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
          STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?actSlot), "#_"), ".", ?innerSlots)))) AS ?version)

  {
    {
      SELECT ?allergy ?p (MIN(?ranked) AS ?first) WHERE {
        ?allergy a v3:observation ; ?tS ?t . ?t a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.7" .
        {
          ?allergy ?paS ?participant . ?participant a v3:participant ; ?prS ?role .
          ?role a v3:participantRole ; ?peS ?entity . ?entity a v3:playingEntity .
          BIND (STRAFTER(STR(?paS), "#_") AS ?at)
          BIND (cascade:allergen AS ?p)
          {
            ?entity ?cS ?code . ?code a v3:code ; ?otS ?originalText . ?originalText a v3:originalText ; ?rfS ?reference .
            ?reference a v3:reference ; xyz:value ?pointer .
            BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?reference_)
            FILTER (STRSTARTS(?reference_, "#") && STRLEN(?reference_) > 1)
            BIND (STRAFTER(?reference_, "#") AS ?anchor)
            {
              SELECT ?anchor (SAMPLE(?nS) AS ?narrativeSlot) (SAMPLE(?run) AS ?value) WHERE {
                ?narrative xyz:ID ?anchor .
                OPTIONAL { ?narrative ?nS ?run . FILTER (STRSTARTS(STR(?nS), STR(rdf:_))) }
              } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?nS) = 1)
            }
            FILTER (isLiteral(?value))
            BIND ("1" AS ?tier)
            BIND (STRAFTER(STR(?narrativeSlot), "#_") AS ?within)
          }
          UNION
          {
            ?entity ?cS ?code . ?code a v3:code ; ?otS ?originalText . ?originalText a v3:originalText ; ?vS ?value .
            FILTER (isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
            BIND ("2" AS ?tier)
            BIND (STRAFTER(STR(?vS), "#_") AS ?within)
          }
          UNION
          {
            ?entity ?nmS ?name . ?name a v3:name ; ?vS ?value .
            FILTER (isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
            BIND ("3" AS ?tier)
            BIND (CONCAT(SUBSTR("0000000000", STRLEN(STRAFTER(STR(?nmS), "#_")) + 1), STRAFTER(STR(?nmS), "#_"),
                         STRAFTER(STR(?vS), "#_")) AS ?within)
          }
          UNION
          {
            ?entity ?cS ?code . ?code a v3:code ; xyz:displayName ?value .
            BIND ("4" AS ?tier)
          }
        }
        UNION
        {
          ?allergy ?vS ?coded . ?coded a v3:value ; xyz:code ?code ; xyz:codeSystem ?codeSystem .
          FILTER (REPLACE(?codeSystem, "^urn:oid:", "") = "2.16.840.1.113883.6.96")
          VALUES (?p ?scheme) { (cascade:allergyType ccda:allergyIntoleranceTypes) (cascade:allergyCategory ccda:allergyIntoleranceCategories) }
          ?concept skos:inScheme ?scheme ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
          ?match skos:notation ?value .
          FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
          BIND (STRAFTER(STR(?vS), "#_") AS ?at)
          BIND ("1" AS ?tier)
        }
        UNION
        {
          ?allergy ?rS ?relationship . ?relationship a v3:entryRelationship ; ?oS ?observation .
          ?observation a v3:observation ; ?otS ?ot ; ?ovS ?coded .
          ?ot a v3:templateId ; xyz:root ?template .
          ?coded a v3:value ; xyz:code ?code ; xyz:codeSystem ?codeSystem .
          VALUES (?template ?p ?scheme ?system) {
            ("2.16.840.1.113883.10.20.22.4.28"  cascade:clinicalStatus      ccda:allergyStatuses "2.16.840.1.113883.6.96")
            ("2.16.840.1.113883.10.20.22.4.145" cascade:allergyCriticality ccda:criticalities   "2.16.840.1.113883.5.1063")
            ("2.16.840.1.113883.10.20.22.4.8"   cascade:allergySeverity    ccda:severities      "2.16.840.1.113883.6.96")
          }
          FILTER (REPLACE(?codeSystem, "^urn:oid:", "") = ?system)
          ?concept skos:inScheme ?scheme ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
          ?match skos:notation ?value .
          FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
          BIND (STRAFTER(STR(?rS), "#_") AS ?at)
          BIND ("1" AS ?tier)
        }
        UNION
        {
          ?allergy ?rS ?relationship . ?relationship a v3:entryRelationship ; ?oS ?reaction .
          ?reaction a v3:observation ; ?rtS ?rt ; ?reS ?severityRelationship .
          ?rt a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.9" .
          ?severityRelationship a v3:entryRelationship ; ?sS ?severity .
          ?severity a v3:observation ; ?stS ?st ; ?svS ?coded .
          ?st a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.8" .
          ?coded a v3:value ; xyz:code ?code ; xyz:codeSystem ?codeSystem .
          FILTER (REPLACE(?codeSystem, "^urn:oid:", "") = "2.16.840.1.113883.6.96")
          ?concept skos:inScheme ccda:severities ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
          ?match skos:notation ?value .
          FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
          BIND (cascade:allergySeverity AS ?p)
          BIND (STRAFTER(STR(?rS), "#_") AS ?at)
          BIND ("2" AS ?tier)
        }
        UNION
        {
          ?allergy ?eS ?time . ?time a v3:effectiveTime .
          { ?time xyz:value ?value . BIND ("1" AS ?tier) }
          UNION
          { ?time ?lS ?low . ?low a v3:low ; xyz:value ?value . BIND ("2" AS ?tier) }
          FILTER (REGEX(?value, "^[0-9]{4}"))
          BIND (cascade:onsetDate AS ?p)
          BIND (STRAFTER(STR(?eS), "#_") AS ?at)
        }
        UNION
        {
          ?allergy ?eS ?time . ?time a v3:effectiveTime .
          { ?time xyz:nullFlavor ?flavour } UNION { ?time ?lS ?low . ?low a v3:low ; xyz:nullFlavor ?flavour }
          ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey ; skos:exactMatch ?flavourCode .
          FILTER (?flavourKey = LCASE(REPLACE(?flavour, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
          BIND (CONCAT("nullFlavor ", STR(?flavourCode)) AS ?value)
          BIND (cascade:onsetDate AS ?p)
          BIND ("9" AS ?tier)
          BIND (STRAFTER(STR(?eS), "#_") AS ?at)
        }
        BIND (COALESCE(?within, "") AS ?inner)
        BIND (CONCAT(?tier, SUBSTR("0000000000", STRLEN(?at) + 1), ?at,
                     SUBSTR("00000000000000000000", STRLEN(?inner) + 1), ?inner, "|", ?value) AS ?ranked)
      } GROUP BY ?allergy ?p
    }
    BIND (STRAFTER(?first, "|") AS ?value)
    BIND (IF(?p != cascade:onsetDate, ?value,
          IF(REGEX(?value, "^[0-9]{10}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2),
                          "T", SUBSTR(?value, 9, 2), ":", IF(REGEX(?value, "^[0-9]{12}"), SUBSTR(?value, 11, 2), "00"), ":",
                          IF(REGEX(?value, "^[0-9]{14}"), REPLACE(?value, "^[0-9]{12}([0-9]{2}(\\.[0-9]+)?).*$", "$1"), "00"),
                          IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")),
                   xsd:dateTime),
          IF(REGEX(?value, "^[0-9]{8}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:date),
          IF(REGEX(?value, "^[0-9]{6}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYearMonth),
          IF(REGEX(?value, "^[0-9]{4}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYear),
             1/0))))) AS ?o)
    BIND (IF(?p IN (cascade:onsetDate) && REGEX(?value, "^[0-9]{10}([0-9]{2})?([+-][0-9]{4})?$"),
             CONCAT("#padded-", STRAFTER(STR(?p), "#")), 1/0) AS ?paddedFragment)
    BIND (IF(BOUND(?paddedFragment), ?value, 1/0) AS ?writtenTime)
    BIND (IF(STRSTARTS(?value, "nullFlavor "), CONCAT("#absent-", STRAFTER(STR(?p), "#")), 1/0) AS ?absentFragment)
    BIND (IF(BOUND(?absentFragment), ?p, 1/0) AS ?absentProperty)
    BIND (IF(BOUND(?absentFragment), IRI(STRAFTER(?value, "nullFlavor ")), 1/0) AS ?absentReason)
  }
  UNION
  {
    ?allergy ?paS ?participant . ?participant a v3:participant ; ?prS ?role .
    ?role a v3:participantRole ; ?peS ?entity . ?entity a v3:playingEntity .
    { ?entity ?cS ?coding . ?coding a v3:code }
    UNION
    { ?entity ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
    ?coding xyz:code ?codeValue ; xyz:codeSystem ?codeSystem .
    ?system skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; void:uriSpace ?stem .
    FILTER (?systemKey = LCASE(REPLACE(?codeSystem, "^urn:oid:", "")) && ?systemKey IN ("2.16.840.1.113883.6.88", "2.16.840.1.113883.6.96", "2.16.840.1.113883.6.1", "2.16.840.1.113883.6.90", "2.16.840.1.113883.6.103", "2.16.840.1.113883.6.12", "2.16.840.1.113883.12.292", "2.16.840.1.113883.4.9"))
    BIND (cascade:allergenCode AS ?p)
    BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?codeValue))) AS ?o)
  }
  UNION
  {
    ?allergy ?rS ?reactionRelationship . ?reactionRelationship a v3:entryRelationship ; ?oS ?reaction .
    ?reaction a v3:observation ; ?rtS ?rt ; ?vS ?coded .
    ?rt a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.9" .
    ?coded a v3:value .
    {
      ?coded xyz:displayName ?o .
      BIND (cascade:reactionManifestationText AS ?p)
    }
    UNION
    {
      ?coded xyz:code ?codeValue ; xyz:codeSystem ?codeSystem .
      ?system skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; void:uriSpace ?stem .
      FILTER (?systemKey = LCASE(REPLACE(?codeSystem, "^urn:oid:", "")) && ?systemKey IN ("2.16.840.1.113883.6.88", "2.16.840.1.113883.6.96", "2.16.840.1.113883.6.1", "2.16.840.1.113883.6.90", "2.16.840.1.113883.6.103", "2.16.840.1.113883.6.12", "2.16.840.1.113883.12.292", "2.16.840.1.113883.4.9"))
      BIND (cascade:reactionManifestationCode AS ?p)
      BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?codeValue))) AS ?o)
    }
  }
  BIND (IF(BOUND(?paddedFragment), IRI(CONCAT(STR(?version), ?paddedFragment)), 1/0) AS ?paddedNode)
  BIND (IF(BOUND(?absentFragment), IRI(CONCAT(STR(?version), ?absentFragment)), 1/0) AS ?absentNode)
}
