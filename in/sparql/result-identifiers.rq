PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX dct:      <http://purl.org/dc/terms/>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX v3:       <urn:hl7-org:v3>
PREFIX ccda:     <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# Each id of a Result Observation the document table makes a record of is a
# business identifier of its version, as HL7's CDA-to-FHIR identifier mapping
# makes it one and document-organizations.rq maps an organization's: a root the
# FHIR identifier registry gives a URI, the NPI's, is that URI; a root and an
# extension give the extension, typed by that URI, or else by urn:oid: and the
# root (urn:uuid: and the root in lower case for a UUID root); a root alone
# gives its urn:oid: or urn:uuid: IRI, typed urn:ietf:rfc:3986, unless the
# registry names it, as a system and no identifier. A root that is neither an
# OID nor a UUID, and an id with a null flavour, give none. So a result a FHIR
# source sent with the system and value this mapping gives is carried alike.

CONSTRUCT {
  ?version dct:identifier ?identifier .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?organizerSlot ?organizer .
  ?organizer a v3:organizer ; ?memberSlot ?member .
  ?member a v3:component ; ?statementSlot ?result .
  ?result a v3:observation ; ?idSlot ?id .
  ?id a v3:id ; xyz:root ?idRoot .
  BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
               STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
               STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?organizerSlot), "#_"), ".",
               STRAFTER(STR(?memberSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?slots)
  ?row ccda:statementAt ?slots ; ccda:recordClass "Observation" .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?slots))) AS ?version)
  FILTER NOT EXISTS { ?id xyz:nullFlavor ?idNullFlavor }
  OPTIONAL { ?id xyz:extension ?idExtension FILTER (STRLEN(?idExtension) > 0) }
  BIND (IF(REGEX(?idRoot, "^[0-2](\\.(0|[1-9][0-9]*))+$"), CONCAT("urn:oid:", ?idRoot),
        IF(REGEX(?idRoot, "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"),
           CONCAT("urn:uuid:", LCASE(?idRoot)), 1/0)) AS ?rootIri)
  BIND (IF(?idRoot = "2.16.840.1.113883.4.6", "http://hl7.org/fhir/sid/us-npi", ?rootIri) AS ?idSystem)
  BIND (IF(BOUND(?idExtension), STRDT(?idExtension, IRI(?idSystem)),
           IF(?idSystem = ?rootIri, STRDT(?rootIri, <urn:ietf:rfc:3986>), 1/0)) AS ?identifier)
}
