PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX v3:       <urn:hl7-org:v3>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX ccda:     <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A Procedure Activity Procedure. Where the vocabulary holds one value and the
# source states several, the first in document order is carried: the name, read
# in this order: the narrative its code's originalText references, the
# originalText's own text, the code's displayName; and the CPT code, the code's
# own before a translation's. Every SNOMED CT code of the code and its
# translations is carried. Each code is the IRI
# ../../vocab/ccda-code-systems.ttl gives it. Every code in another code system,
# of the code and its translations, is a cascade:procedureCodeInOtherSystem
# literal, as result.rq writes a test's. The status is not-done where
# negationInd is true, the procedure not performed, and otherwise the
# statusCode, where it maps to a procedure status. A time is written as
# allergy.rq writes it.

CONSTRUCT {
  ?version ?p ?o .
  ?version cascade:procedureCodeInOtherSystem ?otherSystemCode .
  ?version cascade:snomedCode ?snomedIri .
  ?version cascade:paddedDateTime ?paddedNode .
  ?paddedNode cascade:paddedDateTimeProperty ?p ;
    cascade:writtenDate ?writtenTime .
  ?version cascade:valueAbsentForReason ?absentNode .
  ?absentNode cascade:absentValueProperty ?absentProperty ;
    cascade:absentReasonCode ?absentReason .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?statementSlot ?procedure .
  ?procedure a v3:procedure .
  FILTER EXISTS {
    ?procedure ?templateSlot ?template .
    ?template a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.14" .
  }
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(CONCAT(
          STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
          STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
          STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_"))))) AS ?version)

  {
    SELECT ?procedure ?p (MIN(?ranked) AS ?first) WHERE {
      ?procedure a v3:procedure ; ?tS ?t .
      ?t a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.14" .
      {
        ?procedure ?cS ?code . ?code a v3:code .
        BIND (STRAFTER(STR(?cS), "#_") AS ?at)
        {
          BIND (cascade:procedureName AS ?p)
          {
            ?code ?otS ?originalText . ?originalText a v3:originalText ; ?rfS ?reference .
            ?reference a v3:reference ; xyz:value ?pointer .
            BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?reference_)
            FILTER (STRSTARTS(?reference_, "#") && STRLEN(?reference_) > 1)
            BIND (STRAFTER(?reference_, "#") AS ?anchor)
            {
              SELECT ?anchor (SAMPLE(?written) AS ?value) WHERE {
                ?narrative xyz:ID ?anchor .
                OPTIONAL {
                  ?narrative bridge:textWithElementBreaks ?text .
                  BIND (REPLACE(REPLACE(?text, "^[\\p{Z}\\p{Cc}\\p{Cf}]+|[\\p{Z}\\p{Cc}\\p{Cf}]+$", ""), "[\\p{Z}\\p{Cc}]+", " ") AS ?written)
                  FILTER (STRLEN(?written) > 0)
                }
              } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?written) = 1)
            }
            FILTER (isLiteral(?value))
            BIND ("1" AS ?tier)
            BIND ("" AS ?within)
          }
          UNION
          {
            ?code ?otS ?originalText . ?originalText a v3:originalText ; ?vS ?value .
            FILTER (isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
            BIND ("2" AS ?tier)
            BIND (STRAFTER(STR(?vS), "#_") AS ?within)
          }
          UNION
          {
            ?code xyz:displayName ?value .
            BIND ("3" AS ?tier)
          }
        }
        UNION
        {
          {
            ?procedure ?ownS ?coding . ?coding a v3:code .
            BIND ("1" AS ?tier)
          }
          UNION
          {
            ?procedure ?ownS ?translated . ?translated a v3:code ; ?trS ?coding . ?coding a v3:translation .
            BIND ("2" AS ?tier)
            BIND (STRAFTER(STR(?trS), "#_") AS ?within)
          }
          ?coding xyz:code ?statedCode ; xyz:codeSystem ?codeSystem .
          BIND (REPLACE(?statedCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?value)
          FILTER (?value != "")
          VALUES (?system ?p) {
            ("2.16.840.1.113883.6.12" cascade:cptCode)
          }
          FILTER (?system = LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")))
        }
      }
      UNION
      {
        ?procedure xyz:negationInd "true" .
        BIND (cascade:workflowStatus AS ?p)
        BIND ("not-done" AS ?value)
        BIND ("" AS ?at)
        BIND ("0" AS ?tier)
      }
      UNION
      {
        ?procedure ?sS ?status . ?status a v3:statusCode ; xyz:code ?code .
        ?concept skos:inScheme ccda:procedureStatuses ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
        ?match skos:notation ?value .
        FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
        BIND (cascade:workflowStatus AS ?p)
        BIND (STRAFTER(STR(?sS), "#_") AS ?at)
        BIND ("1" AS ?tier)
      }
      UNION
      {
        ?procedure ?eS ?time . ?time a v3:effectiveTime .
        { ?time xyz:value ?value . BIND ("1" AS ?tier) }
        UNION
        { ?time ?lS ?low . ?low a v3:low ; xyz:value ?value . BIND ("2" AS ?tier) }
        FILTER (REGEX(?value, "^[0-9]{4}"))
        BIND (cascade:procedureDate AS ?p)
        BIND (STRAFTER(STR(?eS), "#_") AS ?at)
      }
      UNION
      {
        ?procedure ?eS ?time . ?time a v3:effectiveTime .
        { ?time xyz:nullFlavor ?flavour } UNION { ?time ?lS ?low . ?low a v3:low ; xyz:nullFlavor ?flavour }
        ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey ; skos:exactMatch ?flavourCode .
        FILTER (?flavourKey = LCASE(REPLACE(?flavour, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
        BIND (CONCAT("nullFlavor ", STR(?flavourCode)) AS ?value)
        BIND (cascade:procedureDate AS ?p)
        BIND ("9" AS ?tier)
        BIND (STRAFTER(STR(?eS), "#_") AS ?at)
      }
      BIND (COALESCE(?within, "") AS ?inner)
      BIND (CONCAT(?tier, SUBSTR("0000000000", STRLEN(?at) + 1), ?at,
                   SUBSTR("00000000000000000000", STRLEN(?inner) + 1), ?inner, "|", ?value) AS ?ranked)
    } GROUP BY ?procedure ?p
  }
  UNION
  {
    SELECT ?procedure ?otherSystemCode WHERE {
      ?procedure a v3:procedure .
      { ?procedure ?cS ?coding . ?coding a v3:code }
      UNION
      { ?procedure ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
      ?coding xyz:code ?codeValue ; xyz:codeSystem ?codeSystem .
      BIND (COALESCE(LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")), "") AS ?systemKey)
      OPTIONAL { ?listed skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; cascade:codingSystemUri ?listedUri }
      BIND (COALESCE(STR(?listedUri), IF(REGEX(?systemKey, "^[0-2](\\.(0|[1-9][0-9]*))+$"), CONCAT("urn:oid:", ?systemKey), 1/0)) AS ?datatype)
      FILTER (?datatype NOT IN ("http://snomed.info/sct", "http://www.ama-assn.org/go/cpt"))
      BIND (REPLACE(?codeValue, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?otherCode)
      FILTER (?otherCode != "")
      BIND (STRDT(?otherCode, IRI(?datatype)) AS ?otherSystemCode)
    }
  }
  UNION
  {
    SELECT ?procedure ?snomedIri WHERE {
      ?procedure a v3:procedure .
      { ?procedure ?cS ?coding . ?coding a v3:code }
      UNION
      { ?procedure ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
      ?coding xyz:code ?statedSnomed ; xyz:codeSystem ?codeSystem .
      ccda:codeSystemSnomedCt skos:notation ?snomedKey ; void:uriSpace ?snomedStem .
      FILTER (?snomedKey = LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")))
      BIND (REPLACE(?statedSnomed, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?snomed)
      FILTER (?snomed != "")
      BIND (IRI(CONCAT(?snomedStem, ENCODE_FOR_URI(?snomed))) AS ?snomedIri)
    }
  }
  BIND (STRAFTER(?first, "|") AS ?value)
  ccda:codeSystemCpt void:uriSpace ?cptStem .
  BIND (IF(?p = cascade:cptCode, IRI(CONCAT(?cptStem, ENCODE_FOR_URI(?value))),
        IF(?p != cascade:procedureDate, ?value,
        IF(REGEX(?value, "^[0-9]{10}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?([+-][0-9]{4})?$"),
           STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2),
                        "T", SUBSTR(?value, 9, 2), ":", IF(REGEX(?value, "^[0-9]{12}"), SUBSTR(?value, 11, 2), "00"), ":",
                        IF(REGEX(?value, "^[0-9]{14}"), REPLACE(?value, "^[0-9]{12}([0-9]{2}(\\.[0-9]+)?).*$", "$1"), "00"),
                        IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")),
                 xsd:dateTime),
        IF(REGEX(?value, "^[0-9]{8}([+-][0-9]{4})?$"),
           STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:date),
        IF(REGEX(?value, "^[0-9]{6}([+-][0-9]{4})?$"),
           STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYearMonth),
        IF(REGEX(?value, "^[0-9]{4}([+-][0-9]{4})?$"),
           STRDT(CONCAT(SUBSTR(?value, 1, 4), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYear),
           1/0)))))) AS ?o)
  BIND (IF(?p IN (cascade:procedureDate) && REGEX(?value, "^[0-9]{10}([0-9]{2})?([+-][0-9]{4})?$"),
           CONCAT("#padded-", STRAFTER(STR(?p), "#")), 1/0) AS ?paddedFragment)
  BIND (IF(BOUND(?paddedFragment), ?value, 1/0) AS ?writtenTime)
  BIND (IF(STRSTARTS(?value, "nullFlavor "), CONCAT("#absent-", STRAFTER(STR(?p), "#")), 1/0) AS ?absentFragment)
  BIND (IF(BOUND(?absentFragment), ?p, 1/0) AS ?absentProperty)
  BIND (IF(BOUND(?absentFragment), IRI(STRAFTER(?value, "nullFlavor ")), 1/0) AS ?absentReason)
  BIND (IF(BOUND(?paddedFragment), IRI(CONCAT(STR(?version), ?paddedFragment)), 1/0) AS ?paddedNode)
  BIND (IF(BOUND(?absentFragment), IRI(CONCAT(STR(?version), ?absentFragment)), 1/0) AS ?absentNode)
}
