PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>
PREFIX xsi:    <http://www.w3.org/2001/XMLSchema-instance>
PREFIX fx:    <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:    <http://sparql.xyz/facade-x/data/>
PREFIX dom:    <https://dom.spec.whatwg.org/#dom-node->
PREFIX v3:     <urn:hl7-org:v3>
PREFIX sdtc:   <urn:hl7-org:sdtc>
PREFIX bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX ccda:   <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# One row per clinical statement this release maps, holding what its name is
# computed from, so that a statement's name can be weighed against every other
# statement's. A row is keyed by the statement's slots, the rdf:_n numbers from
# the document element down to it, which a mapping can compute without
# counting siblings; a refinement counts them, as a selector must.
#
# The key fields and member exclusions are declared here, once per class, and
# the fingerprints they are summed into are ../../docs/format.md#fingerprints:
#
#   Patient            given, family, birthTime and gender, as patient/name and
#                      the patient's elements state them.
#   AllergyIntolerance the allergen's code, code system and name; the
#                      observation's value code (its type), its effectiveTime,
#                      statusCode, and the value of its Allergy Status
#                      Observation.
#   Condition          the value's code, code system and originalText; the
#                      effectiveTime, its low and high, statusCode, negationInd,
#                      and the value of its Problem Status Observation.
#   Immunization       the vaccine's code, code system and originalText; the
#   Procedure          procedure's, its own; then effectiveTime, statusCode,
#                      negationInd and the vaccine's lot.
#   MedicationRequest  the mood; the drug's code, code system and name; each
#                      effectiveTime's value, low and high; statusCode. Not the
#                      dose, so a changed dose is a version of one medication.
#   Observation        a result's code and code system; its effectiveTime's
#                      value, low and high; its value's value, unit, code and
#                      text; statusCode.
#   DiagnosticReport   a Result Organizer's code and code system; its
#   DocumentReference  effectiveTime's value, low and high; statusCode; and a
#                      Note Activity's translations' codes and code systems and
#                      its author's time. A note section's code, code system and
#                      kept text, never its document's time. An
#                      unstructured document's body: its document's id, else its
#                      code, code system and effectiveTime.
#   Excluded members, every class, also: the text values the lift writes of an
#   element, which restate its runs.
#   Excluded members, every class: each ID attribute and each reference's
#   value, which point into the narrative and move when nothing else does.
#
# Each template test and each set of fields is a subquery joined to the
# statements, never a FILTER EXISTS or a pattern beside them: an engine may
# evaluate those once per statement, scanning the whole document each time.
#
# Beside the rows, one triple for each ID a reference nested in a mapped
# statement points to (ccda:referencedAnchor), and one for each of those a
# mapping reads (ccda:readAnchor): the reference of a statement's own text, an
# organizer's sdtc:text, an allergen's, a vaccine's or a drug's, a procedure's
# code originalText, a condition's value originalText, a medication's sig (the
# Medication Free Text Sig nested in it), and of an organizer's Result
# Observation (the 4.2 template, as result.rq maps it) its text, its code's
# originalText, its first value's originalText when that is coded, and its first
# reference range's observation range text. A statement nested in a mapped one,
# a reaction, an indication, a comment, is read by no mapping. The set of mapped
# statements is the one the kept text of a note section is decided by below, and
# is written four times in this query, each alike.

CONSTRUCT {
  [] ccda:referencedAnchor ?referencedAnchor .
  [] ccda:readAnchor ?readAnchor .
  [] ccda:statementAt ?slots ;
    ccda:recordClass ?class ;
    ccda:refinement ?refinement ;
    ccda:identifier ?identifier ;
    ccda:identifierRoot ?identifierRoot ;
    ccda:identifierExtension ?identifierExtension ;
    ccda:keyFingerprint ?keyFingerprint ;
    ccda:membersFingerprint ?membersFingerprint ;
    ccda:keptText ?keptText .
}
WHERE {
  {
  {
    SELECT ?statement ?class ?slots ?refinement ?noteSection WHERE {
      ?root a fx:root, v3:ClinicalDocument .
      {
        ?root ?rtSlot ?recordTarget . ?recordTarget a v3:recordTarget .
        ?recordTarget ?prSlot ?statement . ?statement a v3:patientRole .
        {
          SELECT ?recordTarget (COUNT(?earlierRt) AS ?rtAt) WHERE {
            ?rtParent ?rtS ?recordTarget . ?recordTarget a v3:recordTarget .
            ?rtParent ?rtE ?earlierRt . ?earlierRt a v3:recordTarget .
            FILTER (xsd:integer(STRAFTER(STR(?rtE), "#_")) <= xsd:integer(STRAFTER(STR(?rtS), "#_")))
          } GROUP BY ?recordTarget
        }
        {
          SELECT ?statement (COUNT(?earlierPr) AS ?prAt) WHERE {
            ?prParent ?prS ?statement . ?statement a v3:patientRole .
            ?prParent ?prE ?earlierPr . ?earlierPr a v3:patientRole .
            FILTER (xsd:integer(STRAFTER(STR(?prE), "#_")) <= xsd:integer(STRAFTER(STR(?prS), "#_")))
          } GROUP BY ?statement
        }
        BIND ("Patient" AS ?class)
        BIND (CONCAT(STRAFTER(STR(?rtSlot), "#_"), ".", STRAFTER(STR(?prSlot), "#_")) AS ?slots)
        BIND (CONCAT(
          "*[local-name()='recordTarget' and namespace-uri()='urn:hl7-org:v3'][", STR(?rtAt), "]",
          "/*[local-name()='patientRole' and namespace-uri()='urn:hl7-org:v3'][", STR(?prAt), "]") AS ?refinement)
      }
      UNION
      {
        ?root ?outerSlot ?outer . ?outer a v3:component .
        ?outer ?bodySlot ?body . ?body a v3:structuredBody .
        ?body ?componentSlot ?component . ?component a v3:component .
        ?component ?sectionSlot ?section . ?section a v3:section .
        ?section ?entrySlot ?entry . ?entry a v3:entry .
        ?entry ?actSlot ?act . ?act a v3:act .
        {
          ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship .
          ?relationship ?statementSlot ?statement .
          {
            SELECT ?relationship (COUNT(?earlierEr) AS ?erAt) WHERE {
              ?erParent ?erS ?relationship . ?relationship a v3:entryRelationship .
              ?erParent ?erE ?earlierEr . ?earlierEr a v3:entryRelationship .
              FILTER (xsd:integer(STRAFTER(STR(?erE), "#_")) <= xsd:integer(STRAFTER(STR(?erS), "#_")))
            } GROUP BY ?relationship
          }
          BIND (CONCAT(STRAFTER(STR(?relationshipSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?innerSlots)
          BIND (CONCAT("/*[local-name()='entryRelationship' and namespace-uri()='urn:hl7-org:v3'][", STR(?erAt), "]") AS ?innerStep)
        }
        UNION
        {
          # Not CDA, which wraps an act's observation in an entryRelationship,
          # but how the conformance corpus writes an allergy; docs/format.md.
          ?act ?statementSlot ?statement .
          BIND (STRAFTER(STR(?statementSlot), "#_") AS ?innerSlots)
          BIND ("" AS ?innerStep)
        }
        {
          SELECT DISTINCT ?statement ?class WHERE {
            ?statement a v3:observation ; ?templateSlot ?template .
            ?template a v3:templateId ; xyz:root ?templateRoot .
            VALUES (?templateRoot ?class) {
              ("2.16.840.1.113883.10.20.22.4.7" "AllergyIntolerance")
              ("2.16.840.1.113883.10.20.22.4.4" "Condition")
            }
          }
        }
        OPTIONAL {
          SELECT DISTINCT ?act (true AS ?inConcern) WHERE {
            ?act ?concernSlot ?concern .
            ?concern a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.3" .
          }
        }
        FILTER (?class != "Condition" || BOUND(?inConcern))
        {
          SELECT ?outer (COUNT(?earlierOuter) AS ?outerAt) WHERE {
            ?outerParent ?outerS ?outer . ?outer a v3:component . ?outerParent a fx:root .
            ?outerParent ?outerE ?earlierOuter . ?earlierOuter a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?outerE), "#_")) <= xsd:integer(STRAFTER(STR(?outerS), "#_")))
          } GROUP BY ?outer
        }
        {
          SELECT ?component (COUNT(?earlierComponent) AS ?componentAt) WHERE {
            ?componentParent ?componentS ?component . ?componentParent a v3:structuredBody . ?component a v3:component .
            ?componentParent ?componentE ?earlierComponent . ?earlierComponent a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?componentE), "#_")) <= xsd:integer(STRAFTER(STR(?componentS), "#_")))
          } GROUP BY ?component
        }
        {
          SELECT ?entry (COUNT(?earlierEntry) AS ?entryAt) WHERE {
            ?entryParent ?entryS ?entry . ?entry a v3:entry .
            ?entryParent ?entryE ?earlierEntry . ?earlierEntry a v3:entry .
            FILTER (xsd:integer(STRAFTER(STR(?entryE), "#_")) <= xsd:integer(STRAFTER(STR(?entryS), "#_")))
          } GROUP BY ?entry
        }
        {
          SELECT ?statement (COUNT(DISTINCT ?earlierObservation) AS ?observationAt) WHERE {
            ?observationParent ?observationS ?statement . ?statement a v3:observation ; ?oT ?oTemplate .
            ?oTemplate a v3:templateId ; xyz:root ?oRoot .
            VALUES ?oRoot { "2.16.840.1.113883.10.20.22.4.7" "2.16.840.1.113883.10.20.22.4.4" }
            ?observationParent ?observationE ?earlierObservation . ?earlierObservation a v3:observation .
            FILTER (xsd:integer(STRAFTER(STR(?observationE), "#_")) <= xsd:integer(STRAFTER(STR(?observationS), "#_")))
          } GROUP BY ?statement
        }
        BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
                     STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
                     STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?actSlot), "#_"), ".", ?innerSlots) AS ?slots)
        BIND (CONCAT(
          "*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?outerAt), "]",
          "/*[local-name()='structuredBody' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?componentAt), "]",
          "/*[local-name()='section' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='entry' and namespace-uri()='urn:hl7-org:v3'][", STR(?entryAt), "]",
          "/*[local-name()='act' and namespace-uri()='urn:hl7-org:v3'][1]",
          ?innerStep,
          "/*[local-name()='observation' and namespace-uri()='urn:hl7-org:v3'][", STR(?observationAt), "]") AS ?refinement)
      }
      UNION
      {
        # A statement an entry holds directly. An entry holds one, so it is the
        # first of its name there.
        ?root ?outerSlot ?outer . ?outer a v3:component .
        ?outer ?bodySlot ?body . ?body a v3:structuredBody .
        ?body ?componentSlot ?component . ?component a v3:component .
        ?component ?sectionSlot ?section . ?section a v3:section .
        ?section ?entrySlot ?entry . ?entry a v3:entry .
        ?entry ?statementSlot ?statement .
        {
          SELECT DISTINCT ?statement ?class ?element WHERE {
            ?statement a ?elementType ; ?templateSlot ?template .
            ?template a v3:templateId ; xyz:root ?templateRoot .
            VALUES (?templateRoot ?elementType ?element ?class) {
              ("2.16.840.1.113883.10.20.22.4.52" v3:substanceAdministration "substanceAdministration" "Immunization")
              ("2.16.840.1.113883.10.20.22.4.14" v3:procedure               "procedure"               "Procedure")
              ("2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration "substanceAdministration" "MedicationRequest")
              ("2.16.840.1.113883.10.20.22.4.202" v3:act                    "act"                     "DocumentReference")
            }
          }
        }
        # A Medication Activity is a medication only in a Medications section,
        # only in either mood a medication can be listed in, and never negated:
        # a medication not taken is no entry on a list of what the person takes.
        OPTIONAL {
          SELECT DISTINCT ?section (true AS ?medicationsSection) WHERE {
            ?section ?sectionTemplateSlot ?sectionTemplate .
            ?sectionTemplate a v3:templateId ; xyz:root ?sectionRoot .
            VALUES ?sectionRoot { "2.16.840.1.113883.10.20.22.2.1" "2.16.840.1.113883.10.20.22.2.1.1" }
          }
        }
        FILTER (?class != "MedicationRequest" || (
          EXISTS { ?statement xyz:moodCode ?mood . FILTER (?mood IN ("INT", "EVN")) }
          && NOT EXISTS { ?statement xyz:negationInd "true" }
          && BOUND(?medicationsSection)))
        {
          SELECT ?outer (COUNT(?earlierOuter) AS ?outerAt) WHERE {
            ?outerParent ?outerS ?outer . ?outer a v3:component . ?outerParent a fx:root .
            ?outerParent ?outerE ?earlierOuter . ?earlierOuter a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?outerE), "#_")) <= xsd:integer(STRAFTER(STR(?outerS), "#_")))
          } GROUP BY ?outer
        }
        {
          SELECT ?component (COUNT(?earlierComponent) AS ?componentAt) WHERE {
            ?componentParent ?componentS ?component . ?componentParent a v3:structuredBody . ?component a v3:component .
            ?componentParent ?componentE ?earlierComponent . ?earlierComponent a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?componentE), "#_")) <= xsd:integer(STRAFTER(STR(?componentS), "#_")))
          } GROUP BY ?component
        }
        {
          SELECT ?entry (COUNT(?earlierEntry) AS ?entryAt) WHERE {
            ?entryParent ?entryS ?entry . ?entry a v3:entry .
            ?entryParent ?entryE ?earlierEntry . ?earlierEntry a v3:entry .
            FILTER (xsd:integer(STRAFTER(STR(?entryE), "#_")) <= xsd:integer(STRAFTER(STR(?entryS), "#_")))
          } GROUP BY ?entry
        }
        BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
                     STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
                     STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?slots)
        BIND (CONCAT(
          "*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?outerAt), "]",
          "/*[local-name()='structuredBody' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?componentAt), "]",
          "/*[local-name()='section' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='entry' and namespace-uri()='urn:hl7-org:v3'][", STR(?entryAt), "]",
          "/*[local-name()='", ?element, "' and namespace-uri()='urn:hl7-org:v3'][1]") AS ?refinement)
      }
      UNION
      {
        # A Result Observation of a Result Organizer of a Results section. The
        # organizer, a panel, is no record.
        ?root ?outerSlot ?outer . ?outer a v3:component .
        ?outer ?bodySlot ?body . ?body a v3:structuredBody .
        ?body ?componentSlot ?component . ?component a v3:component .
        ?component ?sectionSlot ?section . ?section a v3:section .
        ?section ?entrySlot ?entry . ?entry a v3:entry .
        ?entry ?organizerSlot ?organizer . ?organizer a v3:organizer .
        ?organizer ?memberSlot ?member . ?member a v3:component .
        ?member ?statementSlot ?statement . ?statement a v3:observation .
        {
          SELECT DISTINCT ?organizer WHERE {
            ?organizer ?organizerTemplateSlot ?organizerTemplate .
            ?organizerTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.1" .
          }
        }
        {
          SELECT DISTINCT ?statement WHERE {
            ?statement ?templateSlot ?template .
            ?template a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.2" .
          }
        }
        {
          SELECT DISTINCT ?section WHERE {
            ?section ?sectionTemplateSlot ?sectionTemplate .
            ?sectionTemplate a v3:templateId ; xyz:root ?sectionRoot .
            VALUES ?sectionRoot { "2.16.840.1.113883.10.20.22.2.3" "2.16.840.1.113883.10.20.22.2.3.1" }
          }
        }
        {
          SELECT ?outer (COUNT(?earlierOuter) AS ?outerAt) WHERE {
            ?outerParent ?outerS ?outer . ?outer a v3:component . ?outerParent a fx:root .
            ?outerParent ?outerE ?earlierOuter . ?earlierOuter a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?outerE), "#_")) <= xsd:integer(STRAFTER(STR(?outerS), "#_")))
          } GROUP BY ?outer
        }
        {
          SELECT ?component (COUNT(?earlierComponent) AS ?componentAt) WHERE {
            ?componentParent ?componentS ?component . ?componentParent a v3:structuredBody . ?component a v3:component .
            ?componentParent ?componentE ?earlierComponent . ?earlierComponent a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?componentE), "#_")) <= xsd:integer(STRAFTER(STR(?componentS), "#_")))
          } GROUP BY ?component
        }
        {
          SELECT ?entry (COUNT(?earlierEntry) AS ?entryAt) WHERE {
            ?entryParent ?entryS ?entry . ?entry a v3:entry .
            ?entryParent ?entryE ?earlierEntry . ?earlierEntry a v3:entry .
            FILTER (xsd:integer(STRAFTER(STR(?entryE), "#_")) <= xsd:integer(STRAFTER(STR(?entryS), "#_")))
          } GROUP BY ?entry
        }
        {
          SELECT ?member (COUNT(?earlierMember) AS ?memberAt) WHERE {
            ?memberParent ?memberS ?member . ?memberParent a v3:organizer . ?member a v3:component .
            ?memberParent ?memberE ?earlierMember . ?earlierMember a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?memberE), "#_")) <= xsd:integer(STRAFTER(STR(?memberS), "#_")))
          } GROUP BY ?member
        }
        BIND ("Observation" AS ?class)
        BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
                     STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
                     STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?organizerSlot), "#_"), ".",
                     STRAFTER(STR(?memberSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?slots)
        BIND (CONCAT(
          "*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?outerAt), "]",
          "/*[local-name()='structuredBody' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?componentAt), "]",
          "/*[local-name()='section' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='entry' and namespace-uri()='urn:hl7-org:v3'][", STR(?entryAt), "]",
          "/*[local-name()='organizer' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?memberAt), "]",
          "/*[local-name()='observation' and namespace-uri()='urn:hl7-org:v3'][1]") AS ?refinement)
      }
      UNION
      {
        # A Result Organizer of a Results section, a report whose results are
        # the Result Observations in it.
        ?root ?outerSlot ?outer . ?outer a v3:component .
        ?outer ?bodySlot ?body . ?body a v3:structuredBody .
        ?body ?componentSlot ?component . ?component a v3:component .
        ?component ?sectionSlot ?section . ?section a v3:section .
        ?section ?entrySlot ?entry . ?entry a v3:entry .
        ?entry ?statementSlot ?statement . ?statement a v3:organizer .
        {
          SELECT DISTINCT ?statement WHERE {
            ?statement ?organizerTemplateSlot ?organizerTemplate .
            ?organizerTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.1" .
          }
        }
        {
          SELECT DISTINCT ?section WHERE {
            ?section ?sectionTemplateSlot ?sectionTemplate .
            ?sectionTemplate a v3:templateId ; xyz:root ?sectionRoot .
            VALUES ?sectionRoot { "2.16.840.1.113883.10.20.22.2.3" "2.16.840.1.113883.10.20.22.2.3.1" }
          }
        }
        {
          SELECT ?outer (COUNT(?earlierOuter) AS ?outerAt) WHERE {
            ?outerParent ?outerS ?outer . ?outer a v3:component . ?outerParent a fx:root .
            ?outerParent ?outerE ?earlierOuter . ?earlierOuter a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?outerE), "#_")) <= xsd:integer(STRAFTER(STR(?outerS), "#_")))
          } GROUP BY ?outer
        }
        {
          SELECT ?component (COUNT(?earlierComponent) AS ?componentAt) WHERE {
            ?componentParent ?componentS ?component . ?componentParent a v3:structuredBody . ?component a v3:component .
            ?componentParent ?componentE ?earlierComponent . ?earlierComponent a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?componentE), "#_")) <= xsd:integer(STRAFTER(STR(?componentS), "#_")))
          } GROUP BY ?component
        }
        {
          SELECT ?entry (COUNT(?earlierEntry) AS ?entryAt) WHERE {
            ?entryParent ?entryS ?entry . ?entry a v3:entry .
            ?entryParent ?entryE ?earlierEntry . ?earlierEntry a v3:entry .
            FILTER (xsd:integer(STRAFTER(STR(?entryE), "#_")) <= xsd:integer(STRAFTER(STR(?entryS), "#_")))
          } GROUP BY ?entry
        }
        BIND ("DiagnosticReport" AS ?class)
        BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
                     STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
                     STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?slots)
        BIND (CONCAT(
          "*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?outerAt), "]",
          "/*[local-name()='structuredBody' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?componentAt), "]",
          "/*[local-name()='section' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='entry' and namespace-uri()='urn:hl7-org:v3'][", STR(?entryAt), "]",
          "/*[local-name()='organizer' and namespace-uri()='urn:hl7-org:v3'][1]") AS ?refinement)
      }
      UNION
      {
        # An unstructured document's body, its nonXMLBody: one note.
        ?root ?outerSlot ?outer . ?outer a v3:component .
        ?outer ?bodySlot ?statement . ?statement a v3:nonXMLBody .
        {
          SELECT ?outer (COUNT(?earlierOuter) AS ?outerAt) WHERE {
            ?outerParent ?outerS ?outer . ?outer a v3:component . ?outerParent a fx:root .
            ?outerParent ?outerE ?earlierOuter . ?earlierOuter a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?outerE), "#_")) <= xsd:integer(STRAFTER(STR(?outerS), "#_")))
          } GROUP BY ?outer
        }
        BIND ("DocumentReference" AS ?class)
        BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_")) AS ?slots)
        BIND (CONCAT(
          "*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?outerAt), "]",
          "/*[local-name()='nonXMLBody' and namespace-uri()='urn:hl7-org:v3'][1]") AS ?refinement)
      }
      UNION
      {
        # A section whose text holds what no entry references: one note, the
        # section itself, if its kept text, its key field below, is not empty
        # (docs/format.md, "What a record is"). A section with a null flavour
        # is no note.
        ?root ?outerSlot ?outer . ?outer a v3:component .
        ?outer ?bodySlot ?body . ?body a v3:structuredBody .
        ?body ?componentSlot ?component . ?component a v3:component .
        ?component ?sectionSlot ?statement . ?statement a v3:section .
        FILTER NOT EXISTS { ?statement xyz:nullFlavor ?sectionNullFlavor }
        BIND (true AS ?noteSection)
        {
          SELECT ?outer (COUNT(?earlierOuter) AS ?outerAt) WHERE {
            ?outerParent ?outerS ?outer . ?outer a v3:component . ?outerParent a fx:root .
            ?outerParent ?outerE ?earlierOuter . ?earlierOuter a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?outerE), "#_")) <= xsd:integer(STRAFTER(STR(?outerS), "#_")))
          } GROUP BY ?outer
        }
        {
          SELECT ?component (COUNT(?earlierComponent) AS ?componentAt) WHERE {
            ?componentParent ?componentS ?component . ?componentParent a v3:structuredBody . ?component a v3:component .
            ?componentParent ?componentE ?earlierComponent . ?earlierComponent a v3:component .
            FILTER (xsd:integer(STRAFTER(STR(?componentE), "#_")) <= xsd:integer(STRAFTER(STR(?componentS), "#_")))
          } GROUP BY ?component
        }
        BIND ("DocumentReference" AS ?class)
        BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
                     STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_")) AS ?slots)
        BIND (CONCAT(
          "*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?outerAt), "]",
          "/*[local-name()='structuredBody' and namespace-uri()='urn:hl7-org:v3'][1]",
          "/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][", STR(?componentAt), "]",
          "/*[local-name()='section' and namespace-uri()='urn:hl7-org:v3'][1]") AS ?refinement)
      }
    }
  }

  OPTIONAL {
    {
      SELECT ?statement (MIN(?ranked) AS ?firstIdentifier) WHERE {
        # An unstructured document's body is named by its document's setId, which
        # its amendments keep, else by its document's id.
        { ?statement ?idSlot ?id . ?id a v3:id . }
        UNION
        { ?statement a v3:nonXMLBody . ?idRootElement a fx:root, v3:ClinicalDocument ; ?idSlot ?id . ?id a v3:setId . }
        UNION
        {
          ?statement a v3:nonXMLBody . ?idRootElement a fx:root, v3:ClinicalDocument ; ?idSlot ?id . ?id a v3:id .
          FILTER NOT EXISTS { ?idRootElement ?setIdSlot ?setId . ?setId a v3:setId ; xyz:root ?setIdRoot . }
        }
        ?id xyz:root ?idRoot .
        FILTER (STRLEN(?idRoot) > 0)
        FILTER NOT EXISTS { ?id xyz:nullFlavor ?idNullFlavor }
        OPTIONAL { ?id xyz:extension ?idExtension FILTER (STRLEN(?idExtension) > 0) }
        BIND (STRAFTER(STR(?idSlot), "#_") AS ?idAt)
        BIND (CONCAT(SUBSTR("0000000000", STRLEN(?idAt) + 1), ?idAt,
                     "|", REPLACE(REPLACE(?idRoot, "%", "%25"), "\\|", "%7C"),
                     "|", REPLACE(REPLACE(COALESCE(?idExtension, ""), "%", "%25"), "\\|", "%7C")) AS ?ranked)
      } GROUP BY ?statement
    }
    BIND (REPLACE(REPLACE(STRBEFORE(STRAFTER(?firstIdentifier, "|"), "|"), "%7C", "|"), "%25", "%") AS ?identifierRoot)
    BIND (REPLACE(REPLACE(STRAFTER(STRAFTER(?firstIdentifier, "|"), "|"), "%7C", "|"), "%25", "%") AS ?identifierExtension)
    BIND (IF(?identifierExtension != "", CONCAT(?identifierRoot, ":", ?identifierExtension), ?identifierRoot) AS ?identifier)
  }

  OPTIONAL {
    {
      SELECT ?statement (STR(SUM(?keyValue)) AS ?keyFingerprint)
             (MAX(IF(STRSTARTS(?field, "text="), SUBSTR(?field, 6), "")) AS ?keptOrEmpty) WHERE {
        {
          SELECT DISTINCT ?statement ?field WHERE {
            {
              ?statement a v3:patientRole ; ?pS ?patient . ?patient a v3:patient .
              {
                SELECT ?patient ?field WHERE {
                  {
                    ?patient ?nS ?name . ?name a v3:name ; ?gS ?part . ?part a ?partType ; ?tS ?text .
                    FILTER (?partType IN (v3:given, v3:family) && isLiteral(?text) && STRSTARTS(STR(?tS), STR(rdf:_)))
                    BIND (CONCAT(STRAFTER(STR(?partType), "urn:hl7-org:v3"), "=", ?text) AS ?field)
                  }
                  UNION
                  { ?patient ?bS ?birth . ?birth a v3:birthTime ; xyz:value ?v . BIND (CONCAT("birthTime=", ?v) AS ?field) }
                  UNION
                  { ?patient ?gcS ?gender . ?gender a v3:administrativeGenderCode ; xyz:code ?v . BIND (CONCAT("gender=", ?v) AS ?field) }
                }
              }
            }
            UNION
            {
              ?statement a v3:observation ; ?tplS ?tpl . ?tpl a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.7" .
              {
                SELECT ?statement ?field WHERE {
                  {
                    ?statement ?paS ?participant . ?participant a v3:participant ; ?prS ?role . ?role a v3:participantRole ;
                      ?peS ?entity . ?entity a v3:playingEntity ; ?cS ?code . ?code a v3:code ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "allergenCode") (xyz:codeSystem "allergenCodeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?paS ?participant . ?participant a v3:participant ; ?prS ?role . ?role a v3:participantRole ;
                      ?peS ?entity . ?entity a v3:playingEntity ; ?nmS ?entityName . ?entityName a v3:name ; ?tS ?text .
                    FILTER (isLiteral(?text) && STRSTARTS(STR(?tS), STR(rdf:_)))
                    BIND (CONCAT("allergenName=", ?text) AS ?field)
                  }
                  UNION
                  { ?statement ?vS ?value . ?value a v3:value ; xyz:code ?v . BIND (CONCAT("type=", ?v) AS ?field) }
                  UNION
                  { ?statement ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?v . BIND (CONCAT("effectiveTime=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?eS ?time . ?time a v3:effectiveTime ; ?bS ?bound . ?bound a ?boundType ; xyz:value ?v .
                    FILTER (?boundType IN (v3:low, v3:high))
                    BIND (CONCAT("effectiveTime", STRAFTER(STR(?boundType), "urn:hl7-org:v3"), "=", ?v) AS ?field)
                  }
                  UNION
                  { ?statement ?sS ?status . ?status a v3:statusCode ; xyz:code ?v . BIND (CONCAT("statusCode=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?rS ?relationship . ?relationship a v3:entryRelationship ; ?oS ?observation .
                    ?observation a v3:observation ; ?otS ?ot ; ?ovS ?ov .
                    ?ot a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.28" .
                    ?ov a v3:value ; xyz:code ?v .
                    BIND (CONCAT("status=", ?v) AS ?field)
                  }
                }
              }
            }
            UNION
            {
              ?statement a v3:observation ; ?tplS ?tpl . ?tpl a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.4" .
              {
                SELECT ?statement ?field WHERE {
                  {
                    ?statement ?vS ?value . ?value a v3:value ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "code") (xyz:codeSystem "codeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?vS ?value . ?value a v3:value ; ?otS ?originalText . ?originalText a v3:originalText ; ?tS ?text .
                    FILTER (isLiteral(?text) && STRSTARTS(STR(?tS), STR(rdf:_)))
                    BIND (CONCAT("originalText=", ?text) AS ?field)
                  }
                  UNION
                  { ?statement ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?v . BIND (CONCAT("effectiveTime=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?eS ?time . ?time a v3:effectiveTime ; ?bS ?bound . ?bound a ?boundType ; xyz:value ?v .
                    FILTER (?boundType IN (v3:low, v3:high))
                    BIND (CONCAT("effectiveTime", STRAFTER(STR(?boundType), "urn:hl7-org:v3"), "=", ?v) AS ?field)
                  }
                  UNION
                  { ?statement ?sS ?status . ?status a v3:statusCode ; xyz:code ?v . BIND (CONCAT("statusCode=", ?v) AS ?field) }
                  UNION
                  { ?statement xyz:negationInd ?v . BIND (CONCAT("negationInd=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?rS ?relationship . ?relationship a v3:entryRelationship ; ?oS ?observation .
                    ?observation a v3:observation ; ?otS ?ot ; ?ovS ?ov .
                    ?ot a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
                    ?ov a v3:value ; xyz:code ?v .
                    BIND (CONCAT("status=", ?v) AS ?field)
                  }
                }
              }
            }
            UNION
            {
              ?statement a ?tplElement ; ?tplS ?tpl . ?tpl a v3:templateId ; xyz:root ?tplRoot .
              VALUES (?tplRoot ?tplElement) {
                ("2.16.840.1.113883.10.20.22.4.52" v3:substanceAdministration)
                ("2.16.840.1.113883.10.20.22.4.14" v3:procedure)
              }
              {
                SELECT ?statement ?field WHERE {
                  {
                    ?statement ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
                    ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial ; ?cS ?code .
                    ?code a v3:code ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "code") (xyz:codeSystem "codeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement a v3:procedure ; ?cS ?code . ?code a v3:code ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "code") (xyz:codeSystem "codeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
                    ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial ; ?cS ?code .
                    ?code a v3:code ; ?otS ?originalText . ?originalText a v3:originalText ; ?tS ?text .
                    FILTER (isLiteral(?text) && STRSTARTS(STR(?tS), STR(rdf:_)))
                    BIND (CONCAT("originalText=", ?text) AS ?field)
                  }
                  UNION
                  {
                    ?statement a v3:procedure ; ?cS ?code . ?code a v3:code ; ?otS ?originalText .
                    ?originalText a v3:originalText ; ?tS ?text .
                    FILTER (isLiteral(?text) && STRSTARTS(STR(?tS), STR(rdf:_)))
                    BIND (CONCAT("originalText=", ?text) AS ?field)
                  }
                  UNION
                  { ?statement ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?v . BIND (CONCAT("effectiveTime=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?eS ?time . ?time a v3:effectiveTime ; ?bS ?bound . ?bound a ?boundType ; xyz:value ?v .
                    FILTER (?boundType IN (v3:low, v3:high))
                    BIND (CONCAT("effectiveTime", STRAFTER(STR(?boundType), "urn:hl7-org:v3"), "=", ?v) AS ?field)
                  }
                  UNION
                  { ?statement ?sS ?status . ?status a v3:statusCode ; xyz:code ?v . BIND (CONCAT("statusCode=", ?v) AS ?field) }
                  UNION
                  { ?statement xyz:negationInd ?v . BIND (CONCAT("negationInd=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
                    ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial ; ?lS ?lot .
                    ?lot a v3:lotNumberText ; ?tS ?text .
                    FILTER (isLiteral(?text) && STRSTARTS(STR(?tS), STR(rdf:_)))
                    BIND (CONCAT("lotNumberText=", ?text) AS ?field)
                  }
                }
              }
            }
            UNION
            {
              ?statement a v3:substanceAdministration ; ?tplS ?tpl .
              ?tpl a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.16" .
              {
                SELECT ?statement ?field WHERE {
                  {
                    ?statement xyz:moodCode ?v .
                    BIND (CONCAT("mood=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
                    ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial ; ?cS ?code .
                    ?code a v3:code ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "drugCode") (xyz:codeSystem "drugCodeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
                    ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial ;
                      ?nmS ?materialName . ?materialName a v3:name ; ?tS ?text .
                    FILTER (isLiteral(?text) && STRSTARTS(STR(?tS), STR(rdf:_)))
                    BIND (CONCAT("drugName=", ?text) AS ?field)
                  }
                  UNION
                  { ?statement ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?v . BIND (CONCAT("effectiveTime=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?eS ?time . ?time a v3:effectiveTime ; ?bS ?bound . ?bound a ?boundType ; xyz:value ?v .
                    FILTER (?boundType IN (v3:low, v3:high))
                    BIND (CONCAT("effectiveTime", STRAFTER(STR(?boundType), "urn:hl7-org:v3"), "=", ?v) AS ?field)
                  }
                  UNION
                  { ?statement ?sS ?status . ?status a v3:statusCode ; xyz:code ?v . BIND (CONCAT("statusCode=", ?v) AS ?field) }
                }
              }
            }
            UNION
            {
              ?statement a v3:observation ; ?tplS ?tpl .
              ?tpl a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.2" .
              {
                SELECT ?statement ?field WHERE {
                  {
                    ?statement ?cS ?code . ?code a v3:code ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "code") (xyz:codeSystem "codeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  { ?statement ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?v . BIND (CONCAT("effectiveTime=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?eS ?time . ?time a v3:effectiveTime ; ?bS ?bound . ?bound a ?boundType ; xyz:value ?v .
                    FILTER (?boundType IN (v3:low, v3:high))
                    BIND (CONCAT("effectiveTime", STRAFTER(STR(?boundType), "urn:hl7-org:v3"), "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?vS ?value . ?value a v3:value ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:value "value") (xyz:unit "unit") (xyz:code "valueCode") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?vS ?value . ?value a v3:value ; ?tS ?v .
                    FILTER (isLiteral(?v) && STRSTARTS(STR(?tS), STR(rdf:_)))
                    BIND (CONCAT("valueText=", ?v) AS ?field)
                  }
                  UNION
                  { ?statement ?sS ?status . ?status a v3:statusCode ; xyz:code ?v . BIND (CONCAT("statusCode=", ?v) AS ?field) }
                }
              }
            }
            UNION
            {
              ?statement a ?tplElement ; ?tplS ?tpl . ?tpl a v3:templateId ; xyz:root ?tplRoot .
              VALUES (?tplRoot ?tplElement) {
                ("2.16.840.1.113883.10.20.22.4.1" v3:organizer)
                ("2.16.840.1.113883.10.20.22.4.202" v3:act)
              }
              {
                SELECT ?statement ?field WHERE {
                  {
                    ?statement ?cS ?code . ?code a v3:code ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "code") (xyz:codeSystem "codeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?cS ?code . ?code a v3:code ; ?trS ?translation . ?translation a v3:translation ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "translationCode") (xyz:codeSystem "translationCodeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  { ?statement ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?v . BIND (CONCAT("effectiveTime=", ?v) AS ?field) }
                  UNION
                  {
                    ?statement ?eS ?time . ?time a v3:effectiveTime ; ?bS ?bound . ?bound a ?boundType ; xyz:value ?v .
                    FILTER (?boundType IN (v3:low, v3:high))
                    BIND (CONCAT("effectiveTime", STRAFTER(STR(?boundType), "urn:hl7-org:v3"), "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    ?statement ?aS ?author . ?author a v3:author ; ?atS ?authorTime . ?authorTime a v3:time ; xyz:value ?v .
                    BIND (CONCAT("authorTime=", ?v) AS ?field)
                  }
                  UNION
                  { ?statement ?sS ?status . ?status a v3:statusCode ; xyz:code ?v . BIND (CONCAT("statusCode=", ?v) AS ?field) }
                }
              }
            }
            UNION
            {
              # A note section's key is its code and its kept text, so the same
              # section sent again in a later document of its source is the same
              # note, and a section whose kept text has changed is another.
              #
              # Its kept text is its text's blocks joined by line feeds in
              # document order. A block is a node of the text at and under which
              # no element is referenced, and none of whose ancestors up to the
              # text is, whose parent is the text itself or a container with a
              # referenced element under it: the text, a table, its thead, tbody
              # and tfoot, and a list are containers, every other element is kept
              # or dropped whole, so a referenced row goes with its unreferenced
              # cells and a referenced table with its rows. Containers nest at
              # most three deep, text, table, tbody, so a block is at most three
              # below the text. A table's thead, tfoot and caption, and a list's
              # caption, are kept only beside a row or item kept. A run of text
              # directly in the text is a block of its own. An element is
              # referenced when some reference nested in a statement this release
              # maps (the narrative holds none; a concern act is none) points to
              # the ID that it alone holds: typeCode DRIV is not trusted, and a
              # reference from an entry this release makes no record of, a vital
              # sign, a social history observation or a planned order, leaves its
              # text in the note. Document order is the order of the rdf:_n slots
              # from the text down, each padded to five digits; a section no
              # reference points into is one block, its whole text.
              ?statement a v3:section .
              {
                SELECT ?statement ?field WHERE {
                  {
                    ?statement a v3:section ; ?cS ?code . ?code a v3:code ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "code") (xyz:codeSystem "codeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  {
                    {
                      SELECT ?statement (GROUP_CONCAT(?blockText; separator="\n") AS ?kept) WHERE {
                        {
                          SELECT ?statement ?key ?blockText WHERE {
                            {
                              {
                                ?statement a v3:section ; ?textSlot ?text . ?text a v3:text .
                                BIND (?text AS ?block) BIND (?text AS ?parent) BIND ("" AS ?key)
                              }
                              UNION
                              {
                                ?statement a v3:section ; ?textSlot ?text . ?text a v3:text ; ?s1 ?block .
                                BIND (?text AS ?parent)
                                BIND (CONCAT(SUBSTR("00000", STRLEN(STRAFTER(STR(?s1), "#_")) + 1), STRAFTER(STR(?s1), "#_")) AS ?key)
                              }
                              UNION
                              {
                                ?statement a v3:section ; ?textSlot ?text . ?text a v3:text ; ?s1 ?parent .
                                ?parent a ?outerContainer ; ?s2 ?block .
                                FILTER (?outerContainer IN (v3:table, v3:list))
                                BIND (CONCAT(SUBSTR("00000", STRLEN(STRAFTER(STR(?s1), "#_")) + 1), STRAFTER(STR(?s1), "#_"),
                                             SUBSTR("00000", STRLEN(STRAFTER(STR(?s2), "#_")) + 1), STRAFTER(STR(?s2), "#_")) AS ?key)
                              }
                              UNION
                              {
                                ?statement a v3:section ; ?textSlot ?text . ?text a v3:text ; ?s1 ?table .
                                ?table a v3:table ; ?s2 ?parent .
                                ?parent a ?innerContainer ; ?s3 ?block .
                                FILTER (?innerContainer IN (v3:thead, v3:tbody, v3:tfoot))
                                BIND (CONCAT(SUBSTR("00000", STRLEN(STRAFTER(STR(?s1), "#_")) + 1), STRAFTER(STR(?s1), "#_"),
                                             SUBSTR("00000", STRLEN(STRAFTER(STR(?s2), "#_")) + 1), STRAFTER(STR(?s2), "#_"),
                                             SUBSTR("00000", STRLEN(STRAFTER(STR(?s3), "#_")) + 1), STRAFTER(STR(?s3), "#_")) AS ?key)
                              }
                              ?block a ?blockType ; bridge:textWithElementBreaks ?blockText .
                            }
                            UNION
                            {
                              ?statement a v3:section ; ?textSlot ?text . ?text a v3:text ; ?s1 ?run .
                              FILTER (isLiteral(?run) && STRSTARTS(STR(?s1), STR(rdf:_)) && REGEX(?run, "[^ \\t\\r\\n]"))
                              BIND (REPLACE(?run, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?blockText)
                              BIND (?run AS ?block) BIND (?text AS ?parent)
                              BIND (CONCAT(SUBSTR("00000", STRLEN(STRAFTER(STR(?s1), "#_")) + 1), STRAFTER(STR(?s1), "#_")) AS ?key)
                            }
                            OPTIONAL {
                              SELECT DISTINCT (?node AS ?parent) (true AS ?parentReferenced) WHERE {
                                {
                                  SELECT DISTINCT ?anchor WHERE {
                                    {
                                      SELECT DISTINCT ?mapped WHERE {
                                        ?entry a v3:entry .
                                        {
                                          ?entry ?actSlot ?act . ?act a v3:act .
                                          { ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?observationSlot ?mapped }
                                          UNION
                                          { ?act ?observationSlot ?mapped }
                                          ?mapped a v3:observation ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                          VALUES (?root ?concernRequired) { ("2.16.840.1.113883.10.20.22.4.7" false) ("2.16.840.1.113883.10.20.22.4.4" true) }
                                          OPTIONAL { SELECT DISTINCT ?act (true AS ?inConcern) WHERE { ?act ?concernSlot ?concern . ?concern a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.3" } }
                                          FILTER (!?concernRequired || BOUND(?inConcern))
                                        }
                                        UNION
                                        {
                                          ?entry ?statementSlot ?mapped . ?mapped a ?element ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                          VALUES (?root ?element) { ("2.16.840.1.113883.10.20.22.4.52" v3:substanceAdministration) ("2.16.840.1.113883.10.20.22.4.14" v3:procedure) ("2.16.840.1.113883.10.20.22.4.202" v3:act) }
                                        }
                                        UNION
                                        {
                                          ?section a v3:section ; ?entrySlot ?entry . ?section ?sectionTemplateSlot ?sectionTemplate . ?sectionTemplate a v3:templateId ; xyz:root ?sectionRoot .
                                          ?entry ?statementSlot ?mapped . ?mapped a ?element ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                          VALUES (?sectionRoot ?root ?element) {
                                            ("2.16.840.1.113883.10.20.22.2.1" "2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration)
                                            ("2.16.840.1.113883.10.20.22.2.1.1" "2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration)
                                            ("2.16.840.1.113883.10.20.22.2.3" "2.16.840.1.113883.10.20.22.4.1" v3:organizer)
                                            ("2.16.840.1.113883.10.20.22.2.3.1" "2.16.840.1.113883.10.20.22.4.1" v3:organizer)
                                          }
                                          FILTER (?element != v3:substanceAdministration
                                                  || (EXISTS { ?mapped xyz:moodCode ?mood . FILTER (?mood IN ("INT", "EVN")) } && NOT EXISTS { ?mapped xyz:negationInd "true" }))
                                        }
                                      }
                                    }
                                    ?mapped (!rdf:type)* ?reference .
                                    ?reference a v3:reference ; xyz:value ?pointer .
                                    BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?trimmed)
                                    FILTER (STRSTARTS(?trimmed, "#") && STRLEN(?trimmed) > 1)
                                    BIND (STRAFTER(?trimmed, "#") AS ?anchor)
                                  }
                                }
                                ?target xyz:ID ?anchor .
                                FILTER NOT EXISTS { ?other xyz:ID ?anchor . FILTER (?other != ?target) }
                                ?node (!rdf:type)* ?target .
                              }
                            }
                            OPTIONAL {
                              SELECT DISTINCT (?node AS ?block) (true AS ?blockReferenced) WHERE {
                                {
                                  SELECT DISTINCT ?anchor WHERE {
                                    {
                                      SELECT DISTINCT ?mapped WHERE {
                                        ?entry a v3:entry .
                                        {
                                          ?entry ?actSlot ?act . ?act a v3:act .
                                          { ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?observationSlot ?mapped }
                                          UNION
                                          { ?act ?observationSlot ?mapped }
                                          ?mapped a v3:observation ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                          VALUES (?root ?concernRequired) { ("2.16.840.1.113883.10.20.22.4.7" false) ("2.16.840.1.113883.10.20.22.4.4" true) }
                                          OPTIONAL { SELECT DISTINCT ?act (true AS ?inConcern) WHERE { ?act ?concernSlot ?concern . ?concern a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.3" } }
                                          FILTER (!?concernRequired || BOUND(?inConcern))
                                        }
                                        UNION
                                        {
                                          ?entry ?statementSlot ?mapped . ?mapped a ?element ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                          VALUES (?root ?element) { ("2.16.840.1.113883.10.20.22.4.52" v3:substanceAdministration) ("2.16.840.1.113883.10.20.22.4.14" v3:procedure) ("2.16.840.1.113883.10.20.22.4.202" v3:act) }
                                        }
                                        UNION
                                        {
                                          ?section a v3:section ; ?entrySlot ?entry . ?section ?sectionTemplateSlot ?sectionTemplate . ?sectionTemplate a v3:templateId ; xyz:root ?sectionRoot .
                                          ?entry ?statementSlot ?mapped . ?mapped a ?element ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                          VALUES (?sectionRoot ?root ?element) {
                                            ("2.16.840.1.113883.10.20.22.2.1" "2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration)
                                            ("2.16.840.1.113883.10.20.22.2.1.1" "2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration)
                                            ("2.16.840.1.113883.10.20.22.2.3" "2.16.840.1.113883.10.20.22.4.1" v3:organizer)
                                            ("2.16.840.1.113883.10.20.22.2.3.1" "2.16.840.1.113883.10.20.22.4.1" v3:organizer)
                                          }
                                          FILTER (?element != v3:substanceAdministration
                                                  || (EXISTS { ?mapped xyz:moodCode ?mood . FILTER (?mood IN ("INT", "EVN")) } && NOT EXISTS { ?mapped xyz:negationInd "true" }))
                                        }
                                      }
                                    }
                                    ?mapped (!rdf:type)* ?reference .
                                    ?reference a v3:reference ; xyz:value ?pointer .
                                    BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?trimmed)
                                    FILTER (STRSTARTS(?trimmed, "#") && STRLEN(?trimmed) > 1)
                                    BIND (STRAFTER(?trimmed, "#") AS ?anchor)
                                  }
                                }
                                ?target xyz:ID ?anchor .
                                FILTER NOT EXISTS { ?other xyz:ID ?anchor . FILTER (?other != ?target) }
                                ?target ((!rdf:type)*|^(!rdf:type)*) ?node .
                              }
                            }
                            OPTIONAL {
                              SELECT DISTINCT ?parent (true AS ?memberKept) WHERE {
                                { ?parent a v3:table ; ?bodySlot ?tableBody . ?tableBody a v3:tbody ; ?memberSlot ?member . ?member a v3:tr }
                                UNION
                                { ?parent a v3:list ; ?memberSlot ?member . ?member a v3:item }
                                OPTIONAL {
                                  SELECT DISTINCT (?node AS ?member) (true AS ?memberReferenced) WHERE {
                                    {
                                      SELECT DISTINCT ?anchor WHERE {
                                        {
                                          SELECT DISTINCT ?mapped WHERE {
                                            ?entry a v3:entry .
                                            {
                                              ?entry ?actSlot ?act . ?act a v3:act .
                                              { ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?observationSlot ?mapped }
                                              UNION
                                              { ?act ?observationSlot ?mapped }
                                              ?mapped a v3:observation ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                              VALUES (?root ?concernRequired) { ("2.16.840.1.113883.10.20.22.4.7" false) ("2.16.840.1.113883.10.20.22.4.4" true) }
                                              OPTIONAL { SELECT DISTINCT ?act (true AS ?inConcern) WHERE { ?act ?concernSlot ?concern . ?concern a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.3" } }
                                              FILTER (!?concernRequired || BOUND(?inConcern))
                                            }
                                            UNION
                                            {
                                              ?entry ?statementSlot ?mapped . ?mapped a ?element ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                              VALUES (?root ?element) { ("2.16.840.1.113883.10.20.22.4.52" v3:substanceAdministration) ("2.16.840.1.113883.10.20.22.4.14" v3:procedure) ("2.16.840.1.113883.10.20.22.4.202" v3:act) }
                                            }
                                            UNION
                                            {
                                              ?section a v3:section ; ?entrySlot ?entry . ?section ?sectionTemplateSlot ?sectionTemplate . ?sectionTemplate a v3:templateId ; xyz:root ?sectionRoot .
                                              ?entry ?statementSlot ?mapped . ?mapped a ?element ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?root .
                                              VALUES (?sectionRoot ?root ?element) {
                                                ("2.16.840.1.113883.10.20.22.2.1" "2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration)
                                                ("2.16.840.1.113883.10.20.22.2.1.1" "2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration)
                                                ("2.16.840.1.113883.10.20.22.2.3" "2.16.840.1.113883.10.20.22.4.1" v3:organizer)
                                                ("2.16.840.1.113883.10.20.22.2.3.1" "2.16.840.1.113883.10.20.22.4.1" v3:organizer)
                                              }
                                              FILTER (?element != v3:substanceAdministration
                                                      || (EXISTS { ?mapped xyz:moodCode ?mood . FILTER (?mood IN ("INT", "EVN")) } && NOT EXISTS { ?mapped xyz:negationInd "true" }))
                                            }
                                          }
                                        }
                                        ?mapped (!rdf:type)* ?reference .
                                        ?reference a v3:reference ; xyz:value ?pointer .
                                        BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?trimmed)
                                        FILTER (STRSTARTS(?trimmed, "#") && STRLEN(?trimmed) > 1)
                                        BIND (STRAFTER(?trimmed, "#") AS ?anchor)
                                      }
                                    }
                                    ?target xyz:ID ?anchor .
                                    FILTER NOT EXISTS { ?other xyz:ID ?anchor . FILTER (?other != ?target) }
                                    ?target ((!rdf:type)*|^(!rdf:type)*) ?node .
                                  }
                                }
                                FILTER (!BOUND(?memberReferenced))
                              }
                            }
                            FILTER (!BOUND(?blockReferenced) && (?key = "" || BOUND(?parentReferenced)))
                            FILTER (!(COALESCE(?blockType, rdf:nil) IN (v3:thead, v3:tfoot, v3:caption)) || BOUND(?memberKept))
                          } ORDER BY ?statement ?key
                        }
                      } GROUP BY ?statement
                    }
                    FILTER (STRLEN(?kept) > 0)
                    BIND (CONCAT("text=", ?kept) AS ?field)
                  }
                }
              }
            }
            UNION
            {
              # An unstructured document's key is its document's code and time.
              ?statement a v3:nonXMLBody .
              {
                SELECT ?statement ?field WHERE {
                  ?statement a v3:nonXMLBody .
                  ?document a fx:root, v3:ClinicalDocument .
                  {
                    ?document ?cS ?code . ?code a v3:code ; ?attribute ?v .
                    VALUES (?attribute ?name) { (xyz:code "code") (xyz:codeSystem "codeSystem") }
                    BIND (CONCAT(?name, "=", ?v) AS ?field)
                  }
                  UNION
                  { ?document ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?v . BIND (CONCAT("effectiveTime=", ?v) AS ?field) }
                }
              }
            }
          }
        }
        BIND (SUBSTR(SHA256(?field), 1, 12) AS ?h)
        BIND ("0123456789abcdef" AS ?digits)
        BIND (STRLEN(STRBEFORE(?digits, SUBSTR(?h, 1, 1))) * 17592186044416
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 2, 1))) * 1099511627776
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 3, 1))) * 68719476736
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 4, 1))) * 4294967296
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 5, 1))) * 268435456
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 6, 1))) * 16777216
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 7, 1))) * 1048576
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 8, 1))) * 65536
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 9, 1))) * 4096
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 10, 1))) * 256
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 11, 1))) * 16
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 12, 1))) AS ?keyValue)
      } GROUP BY ?statement
    }
  }
  BIND (IF(STRLEN(COALESCE(?keptOrEmpty, "")) > 0, ?keptOrEmpty, 1/0) AS ?keptText)
  FILTER (!BOUND(?noteSection) || BOUND(?keptText))

  OPTIONAL {
    {
      SELECT ?statement (STR(SUM(?memberValue)) AS ?membersFingerprint) WHERE {
        {
          SELECT DISTINCT ?statement ?member WHERE {
            {
              SELECT DISTINCT ?statement WHERE {
                {
                  ?statement a ?bodyOrPatient .
                  VALUES ?bodyOrPatient { v3:patientRole v3:nonXMLBody }
                }
                UNION
                {
                  ?statement a v3:observation ; ?mT ?mTemplate .
                  ?mTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.7" .
                }
                UNION
                {
                  ?statement ?mT ?mTemplate .
                  ?mTemplate a v3:templateId ; xyz:root ?mRoot .
                  VALUES ?mRoot { "2.16.840.1.113883.10.20.22.4.4" "2.16.840.1.113883.10.20.22.4.52" "2.16.840.1.113883.10.20.22.4.14"
                         "2.16.840.1.113883.10.20.22.4.16" "2.16.840.1.113883.10.20.22.4.2" "2.16.840.1.113883.10.20.22.4.1"
                         "2.16.840.1.113883.10.20.22.4.202" }
                }
              }
            }
            ?statement (!rdf:type)* ?node .
            ?node a ?nodeType ; ?predicate ?held .
            FILTER (isLiteral(?held) && ?predicate != xyz:ID)
            FILTER (?predicate NOT IN (dom:textcontent, bridge:textWithElementBreaks, bridge:textDecodedFromBase64))
            FILTER (!(?nodeType = v3:reference && ?predicate = xyz:value))
            BIND (IF(STRSTARTS(STR(?predicate), STR(rdf:_)),
                     CONCAT(STR(?nodeType), "=", ?held),
                     CONCAT(STR(?nodeType), "@", STR(?predicate), "=", ?held)) AS ?member)
          }
        }
        BIND (SUBSTR(SHA256(?member), 1, 12) AS ?h)
        BIND ("0123456789abcdef" AS ?digits)
        BIND (STRLEN(STRBEFORE(?digits, SUBSTR(?h, 1, 1))) * 17592186044416
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 2, 1))) * 1099511627776
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 3, 1))) * 68719476736
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 4, 1))) * 4294967296
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 5, 1))) * 268435456
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 6, 1))) * 16777216
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 7, 1))) * 1048576
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 8, 1))) * 65536
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 9, 1))) * 4096
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 10, 1))) * 256
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 11, 1))) * 16
            + STRLEN(STRBEFORE(?digits, SUBSTR(?h, 12, 1))) AS ?memberValue)
      } GROUP BY ?statement
    }
  }
  }
  UNION
  {
    SELECT DISTINCT ?referencedAnchor ?readAnchor WHERE {
      {
        SELECT DISTINCT ?mapped ?templateRoot WHERE {
          ?entry a v3:entry .
          {
            ?entry ?actSlot ?act . ?act a v3:act .
            { ?act ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?observationSlot ?mapped }
            UNION
            { ?act ?observationSlot ?mapped }
            ?mapped a v3:observation ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?templateRoot .
            VALUES (?templateRoot ?concernRequired) { ("2.16.840.1.113883.10.20.22.4.7" false) ("2.16.840.1.113883.10.20.22.4.4" true) }
            OPTIONAL { SELECT DISTINCT ?act (true AS ?inConcern) WHERE { ?act ?concernSlot ?concern . ?concern a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.3" } }
            FILTER (!?concernRequired || BOUND(?inConcern))
          }
          UNION
          {
            ?entry ?statementSlot ?mapped . ?mapped a ?element ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?templateRoot .
            VALUES (?templateRoot ?element) { ("2.16.840.1.113883.10.20.22.4.52" v3:substanceAdministration) ("2.16.840.1.113883.10.20.22.4.14" v3:procedure) ("2.16.840.1.113883.10.20.22.4.202" v3:act) }
          }
          UNION
          {
            ?section a v3:section ; ?entrySlot ?entry . ?section ?sectionTemplateSlot ?sectionTemplate . ?sectionTemplate a v3:templateId ; xyz:root ?sectionRoot .
            ?entry ?statementSlot ?mapped . ?mapped a ?element ; ?templateSlot ?template . ?template a v3:templateId ; xyz:root ?templateRoot .
            VALUES (?sectionRoot ?templateRoot ?element) {
              ("2.16.840.1.113883.10.20.22.2.1" "2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration)
              ("2.16.840.1.113883.10.20.22.2.1.1" "2.16.840.1.113883.10.20.22.4.16" v3:substanceAdministration)
              ("2.16.840.1.113883.10.20.22.2.3" "2.16.840.1.113883.10.20.22.4.1" v3:organizer)
              ("2.16.840.1.113883.10.20.22.2.3.1" "2.16.840.1.113883.10.20.22.4.1" v3:organizer)
            }
            FILTER (?element != v3:substanceAdministration
                    || (EXISTS { ?mapped xyz:moodCode ?mood . FILTER (?mood IN ("INT", "EVN")) } && NOT EXISTS { ?mapped xyz:negationInd "true" }))
          }
        }
      }
      {
        ?mapped (!rdf:type)* ?reference .
        BIND ("referenced" AS ?kind)
      }
      UNION
      {
        {
          # The statement's own text, and an organizer's sdtc:text.
          ?mapped ?ownSlot ?ownText . ?ownText a v3:text ; ?ownReferenceSlot ?reference .
          VALUES ?templateRoot { "2.16.840.1.113883.10.20.22.4.7" "2.16.840.1.113883.10.20.22.4.4" "2.16.840.1.113883.10.20.22.4.52"
                                 "2.16.840.1.113883.10.20.22.4.14" "2.16.840.1.113883.10.20.22.4.16" "2.16.840.1.113883.10.20.22.4.202" }
        }
        UNION
        {
          ?mapped ?reportTextSlot ?reportText . ?reportText a sdtc:text ; ?reportReferenceSlot ?reference .
          VALUES ?templateRoot { "2.16.840.1.113883.10.20.22.4.1" }
        }
        UNION
        {
          # An allergen's name.
          ?mapped ?participantSlot ?participant . ?participant a v3:participant ; ?roleSlot ?role .
          ?role a v3:participantRole ; ?entitySlot ?entity . ?entity a v3:playingEntity ; ?allergenCodeSlot ?allergenCode .
          ?allergenCode a v3:code ; ?allergenTextSlot ?allergenText . ?allergenText a v3:originalText ; ?allergenReferenceSlot ?reference .
          VALUES ?templateRoot { "2.16.840.1.113883.10.20.22.4.7" }
        }
        UNION
        {
          # A condition's name.
          ?mapped ?conditionValueSlot ?conditionValue . ?conditionValue a v3:value ; ?conditionTextSlot ?conditionText .
          ?conditionText a v3:originalText ; ?conditionReferenceSlot ?reference .
          VALUES ?templateRoot { "2.16.840.1.113883.10.20.22.4.4" }
        }
        UNION
        {
          # A vaccine's or a drug's name.
          ?mapped ?consumableSlot ?consumable . ?consumable a v3:consumable ; ?productSlot ?product .
          ?product a v3:manufacturedProduct ; ?materialSlot ?material . ?material a v3:manufacturedMaterial ; ?materialCodeSlot ?materialCode .
          ?materialCode a v3:code ; ?materialTextSlot ?materialText . ?materialText a v3:originalText ; ?materialReferenceSlot ?reference .
          VALUES ?templateRoot { "2.16.840.1.113883.10.20.22.4.52" "2.16.840.1.113883.10.20.22.4.16" }
        }
        UNION
        {
          # A procedure's name.
          ?mapped ?procedureCodeSlot ?procedureCode . ?procedureCode a v3:code ; ?procedureTextSlot ?procedureText .
          ?procedureText a v3:originalText ; ?procedureReferenceSlot ?reference .
          VALUES ?templateRoot { "2.16.840.1.113883.10.20.22.4.14" }
        }
        UNION
        {
          # A medication's sig.
          ?mapped ?sigRelationshipSlot ?sigRelationship . ?sigRelationship a v3:entryRelationship ; ?sigSlot ?sig .
          ?sig a v3:substanceAdministration ; ?sigTemplateSlot ?sigTemplate ; ?sigTextSlot ?sigText .
          ?sigTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.147" .
          ?sigText a v3:text ; ?sigReferenceSlot ?reference .
          VALUES ?templateRoot { "2.16.840.1.113883.10.20.22.4.16" }
        }
        UNION
        {
          # A result of an organizer, as result.rq maps one.
          ?mapped ?memberSlot ?member . ?member a v3:component ; ?resultSlot ?result . ?result a v3:observation ; ?resultTemplateSlot ?resultTemplate .
          ?resultTemplate a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.2" .
          VALUES ?templateRoot { "2.16.840.1.113883.10.20.22.4.1" }
          {
            ?result ?resultTextSlot ?resultText . ?resultText a v3:text ; ?resultReferenceSlot ?reference .
          }
          UNION
          {
            ?result ?resultCodeSlot ?resultCode . ?resultCode a v3:code ; ?resultCodeTextSlot ?resultCodeText .
            ?resultCodeText a v3:originalText ; ?resultCodeReferenceSlot ?reference .
          }
          UNION
          {
            ?result ?firstValueSlot ?firstValue . ?firstValue a v3:value ; xsi:type ?written ; ?firstValueTextSlot ?firstValueText .
            ?firstValueText a v3:originalText ; ?firstValueReferenceSlot ?reference .
            FILTER (REPLACE(?written, "^.*:", "") IN ("CD", "CE", "CV", "CO"))
            FILTER NOT EXISTS {
              ?result ?earlierValueSlot ?earlierValue . ?earlierValue a v3:value .
              FILTER (xsd:integer(STRAFTER(STR(?earlierValueSlot), "#_")) < xsd:integer(STRAFTER(STR(?firstValueSlot), "#_")))
            }
          }
          UNION
          {
            ?result ?firstRangeSlot ?firstRange . ?firstRange a v3:referenceRange ; ?observationRangeSlot ?observationRange .
            ?observationRange a v3:observationRange ; ?rangeTextSlot ?rangeText . ?rangeText a v3:text ; ?rangeReferenceSlot ?reference .
            FILTER NOT EXISTS {
              ?result ?earlierRangeSlot ?earlierRange . ?earlierRange a v3:referenceRange .
              FILTER (xsd:integer(STRAFTER(STR(?earlierRangeSlot), "#_")) < xsd:integer(STRAFTER(STR(?firstRangeSlot), "#_")))
            }
          }
        }
        BIND ("read" AS ?kind)
      }
      ?reference a v3:reference ; xyz:value ?pointer .
      BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?trimmed)
      FILTER (STRSTARTS(?trimmed, "#") && STRLEN(?trimmed) > 1)
      BIND (IF(?kind = "referenced", STRAFTER(?trimmed, "#"), 1/0) AS ?referencedAnchor)
      BIND (IF(?kind = "read", STRAFTER(?trimmed, "#"), 1/0) AS ?readAnchor)
    }
  }
}
