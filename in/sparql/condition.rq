PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX bridge:   <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX v3:       <urn:hl7-org:v3>
PREFIX cascade:  <https://ns.cascadeprotocol.org/cascade#>
PREFIX ccda:     <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A Problem Observation. Where the vocabulary holds one value and the source
# states several, the first in document order is carried:
#   - the name, read in this order: the narrative its value's originalText
#     references, the originalText's own text, the value's displayName;
#   - the status, from its Problem Status Observation, else from its concern
#     act's statusCode where that maps to a clinical status.
# The category is the section's, by its code. Every code of the value and its
# translations is carried: one in SNOMED CT or ICD-10-CM as the IRI
# ../../vocab/ccda-code-systems.ttl gives it, one in another code system as a
# cascade:conditionCodeInOtherSystem literal, as result.rq writes a test's.
# A code with no code system is a finding of condition-findings.rq. Times are written as allergy.rq writes
# them: effectiveTime's value, else its low, is the onset, its high the
# abatement. A problem whose negationInd is true is refuted: the source states
# it is absent.
#
# Each template test, each narrative and each set of fields is a subquery
# joined to the rows, never a FILTER EXISTS, a comparison of strings or a
# UNION beside them: an engine may evaluate those once per row, scanning the
# whole document each time.

CONSTRUCT {
  ?version ?p ?o .
  ?version cascade:paddedDateTime ?paddedNode .
  ?paddedNode cascade:paddedDateTimeProperty ?p ;
    cascade:writtenDate ?writtenTime .
  ?version cascade:valueAbsentForReason ?absentNode .
  ?absentNode cascade:absentValueProperty ?absentProperty ;
    cascade:absentReasonCode ?absentReason .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?actSlot ?act .
  ?act a v3:act .
  {
    SELECT ?act ?condition ?innerSlots WHERE {
      {
        ?act a v3:act ; ?relationshipSlot ?relationship . ?relationship a v3:entryRelationship ; ?statementSlot ?condition .
        BIND (CONCAT(STRAFTER(STR(?relationshipSlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?innerSlots)
      }
      UNION
      {
        ?act a v3:act ; ?statementSlot ?condition .
        BIND (STRAFTER(STR(?statementSlot), "#_") AS ?innerSlots)
      }
    }
  }
  ?condition a v3:observation .
  {
    SELECT DISTINCT ?condition WHERE {
      ?condition ?templateSlot ?template .
      ?template a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.4" .
    }
  }
  {
    SELECT DISTINCT ?act WHERE {
      ?act ?concernSlot ?concern .
      ?concern a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.3" .
    }
  }
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(CONCAT(
          STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
          STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
          STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?actSlot), "#_"), ".", ?innerSlots)))) AS ?version)

  {
    {
      SELECT ?act ?condition ?p (MIN(?ranked) AS ?first) WHERE {
        {
          SELECT ?act ?condition ?p ?tier ?at ?within ?value WHERE {
            {
              ?condition ?vS ?coded . ?coded a v3:value ; ?otS ?originalText . ?originalText a v3:originalText .
              {
                SELECT ?originalText ?within ?value WHERE {
                  ?originalText a v3:originalText ; ?rfS ?reference . ?reference a v3:reference ; xyz:value ?pointer .
                  BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?reference_)
                  FILTER (STRSTARTS(?reference_, "#") && STRLEN(?reference_) > 1)
                  BIND (STRAFTER(?reference_, "#") AS ?anchor)
                  {
                    SELECT ?anchor ?within ?value WHERE {
                      {
                        SELECT ?anchor (SAMPLE(?written) AS ?value) WHERE {
                          ?narrative xyz:ID ?anchor .
                          OPTIONAL {
                            ?narrative bridge:textWithElementBreaks ?text .
                            BIND (REPLACE(REPLACE(?text, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "[ \\t\\r\\n]+", " ") AS ?written)
                          }
                        } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?written) = 1)
                      }
                      FILTER (isLiteral(?value))
                      BIND ("" AS ?within)
                    }
                  }
                }
              }
              BIND (STRAFTER(STR(?vS), "#_") AS ?at)
              BIND (cascade:conditionName AS ?p)
              BIND ("1" AS ?tier)
            }
            UNION
            {
              ?condition ?vS ?coded . ?coded a v3:value ; ?otS ?originalText . ?originalText a v3:originalText ; ?tS2 ?value .
              FILTER (isLiteral(?value) && STRSTARTS(STR(?tS2), STR(rdf:_)))
              BIND (STRAFTER(STR(?vS), "#_") AS ?at)
              BIND (cascade:conditionName AS ?p)
              BIND ("2" AS ?tier)
              BIND (STRAFTER(STR(?tS2), "#_") AS ?within)
            }
            UNION
            {
              ?condition ?vS ?coded . ?coded a v3:value ; xyz:displayName ?value .
              BIND (STRAFTER(STR(?vS), "#_") AS ?at)
              BIND (cascade:conditionName AS ?p)
              BIND ("3" AS ?tier)
            }
            UNION
            {
              ?condition ?rS ?relationship . ?relationship a v3:entryRelationship ; ?oS ?observation .
              ?observation a v3:observation ; ?otS ?ot ; ?ovS ?coded .
              ?ot a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.6" .
              ?coded a v3:value ; xyz:code ?code ; xyz:codeSystem ?codeSystem .
              FILTER (REPLACE(?codeSystem, "^urn:oid:", "") = "2.16.840.1.113883.6.96")
              ?concept skos:inScheme ccda:problemStatuses ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
              ?match skos:notation ?value .
              FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
              BIND (cascade:clinicalStatus AS ?p)
              BIND (STRAFTER(STR(?rS), "#_") AS ?at)
              BIND ("1" AS ?tier)
            }
            UNION
            {
              ?act ?sS ?status . ?status a v3:statusCode ; xyz:code ?code .
              ?concept skos:inScheme ccda:concernStatuses ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
              ?match skos:notation ?value .
              FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
              BIND (cascade:clinicalStatus AS ?p)
              BIND (STRAFTER(STR(?sS), "#_") AS ?at)
              BIND ("2" AS ?tier)
            }
            UNION
            {
              ?condition ?eS ?time . ?time a v3:effectiveTime ; ?bS ?bound . ?bound a v3:low ; xyz:value ?value .
              FILTER (REGEX(?value, "^[0-9]{4}"))
              BIND (cascade:onsetDate AS ?p)
              BIND ("2" AS ?tier)
              BIND (STRAFTER(STR(?eS), "#_") AS ?at)
            }
            UNION
            {
              ?condition ?eS ?time . ?time a v3:effectiveTime ; ?bS ?bound . ?bound a v3:high ; xyz:value ?value .
              FILTER (REGEX(?value, "^[0-9]{4}"))
              BIND (cascade:abatementDate AS ?p)
              BIND ("1" AS ?tier)
              BIND (STRAFTER(STR(?eS), "#_") AS ?at)
            }
            UNION
            {
              ?condition ?eS ?time . ?time a v3:effectiveTime ; xyz:value ?value .
              FILTER (REGEX(?value, "^[0-9]{4}"))
              BIND (cascade:onsetDate AS ?p)
              BIND ("1" AS ?tier)
              BIND (STRAFTER(STR(?eS), "#_") AS ?at)
            }
            UNION
            {
              ?condition ?eS ?time . ?time a v3:effectiveTime .
              { ?time xyz:nullFlavor ?flavour } UNION { ?time ?lS ?low . ?low a v3:low ; xyz:nullFlavor ?flavour }
              ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey ; skos:exactMatch ?flavourCode .
              FILTER (?flavourKey = LCASE(REPLACE(?flavour, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
              BIND (CONCAT("nullFlavor ", STR(?flavourCode)) AS ?value)
              BIND (cascade:onsetDate AS ?p)
              BIND ("9" AS ?tier)
              BIND (STRAFTER(STR(?eS), "#_") AS ?at)
            }
            UNION
            {
              ?condition ?eS ?time . ?time a v3:effectiveTime ; ?hS ?high . ?high a v3:high ; xyz:nullFlavor ?flavour .
              ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey ; skos:exactMatch ?flavourCode .
              FILTER (?flavourKey = LCASE(REPLACE(?flavour, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
              BIND (CONCAT("nullFlavor ", STR(?flavourCode)) AS ?value)
              BIND (cascade:abatementDate AS ?p)
              BIND ("9" AS ?tier)
              BIND (STRAFTER(STR(?eS), "#_") AS ?at)
            }
            UNION
            {
              ?condition xyz:negationInd "true" .
              BIND (cascade:verificationStatus AS ?p)
              BIND ("refuted" AS ?value)
              BIND ("" AS ?at)
              BIND ("1" AS ?tier)
            }
          }
        }
        {
          SELECT DISTINCT ?act ?condition WHERE {
            {
              ?act a v3:act ; ?ers ?er . ?er a v3:entryRelationship ; ?os ?condition .
            }
            UNION
            {
              ?act a v3:act ; ?os ?condition .
            }
            ?condition a v3:observation ; ?tS ?t . ?t a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.4" .
          }
        }
        BIND (COALESCE(?within, "") AS ?inner)
        BIND (CONCAT(?tier, SUBSTR("0000000000", STRLEN(?at) + 1), ?at,
                     SUBSTR("00000000000000000000", STRLEN(?inner) + 1), ?inner, "|", ?value) AS ?ranked)
      } GROUP BY ?act ?condition ?p
    }
    BIND (STRAFTER(?first, "|") AS ?value)
    BIND (IF(?p NOT IN (cascade:onsetDate, cascade:abatementDate), ?value,
          IF(REGEX(?value, "^[0-9]{10}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2),
                          "T", SUBSTR(?value, 9, 2), ":", IF(REGEX(?value, "^[0-9]{12}"), SUBSTR(?value, 11, 2), "00"), ":",
                          IF(REGEX(?value, "^[0-9]{14}"), REPLACE(?value, "^[0-9]{12}([0-9]{2}(\\.[0-9]+)?).*$", "$1"), "00"),
                          IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")),
                   xsd:dateTime),
          IF(REGEX(?value, "^[0-9]{8}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:date),
          IF(REGEX(?value, "^[0-9]{6}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYearMonth),
          IF(REGEX(?value, "^[0-9]{4}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYear),
             1/0))))) AS ?o)
    BIND (IF(?p IN (cascade:onsetDate, cascade:abatementDate) && REGEX(?value, "^[0-9]{10}([0-9]{2})?([+-][0-9]{4})?$"),
             CONCAT("#padded-", STRAFTER(STR(?p), "#")), 1/0) AS ?paddedFragment)
    BIND (IF(BOUND(?paddedFragment), ?value, 1/0) AS ?writtenTime)
    BIND (IF(STRSTARTS(?value, "nullFlavor "), CONCAT("#absent-", STRAFTER(STR(?p), "#")), 1/0) AS ?absentFragment)
    BIND (IF(BOUND(?absentFragment), ?p, 1/0) AS ?absentProperty)
    BIND (IF(BOUND(?absentFragment), IRI(STRAFTER(?value, "nullFlavor ")), 1/0) AS ?absentReason)
  }
  UNION
  {
    ?section ?scS ?sectionCode . ?sectionCode a v3:code ; xyz:code ?code .
    ?concept skos:inScheme ccda:problemCategories ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
    ?match skos:notation ?o .
    FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
    BIND (cascade:conditionCategory AS ?p)
  }
  UNION
  {
    {
      SELECT ?condition ?codeValue ?codeSystem WHERE {
        { ?condition ?vS ?coded . ?coded a v3:value ; xyz:code ?codeValue ; xyz:codeSystem ?codeSystem . }
        UNION
        { ?condition ?vS ?coded . ?coded a v3:value ; ?trS ?translation . ?translation a v3:translation ; xyz:code ?codeValue ; xyz:codeSystem ?codeSystem . }
      }
    }
    ?system skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; cascade:codingSystemUri ?systemUri ; void:uriSpace ?stem .
    FILTER (?systemKey = LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")))
    VALUES (?systemUri ?p) {
      ("http://snomed.info/sct"^^xsd:anyURI            cascade:snomedCode)
      ("http://hl7.org/fhir/sid/icd-10-cm"^^xsd:anyURI cascade:icd10Code)
    }
    BIND (REPLACE(?codeValue, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?trimmedCode)
    FILTER (?trimmedCode != "")
    BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?trimmedCode))) AS ?o)
  }
  UNION
  {
    { ?condition ?vS ?coding . ?coding a v3:value }
    UNION
    { ?condition ?vS ?coded . ?coded a v3:value ; ?trS ?coding . ?coding a v3:translation }
    ?coding xyz:code ?codeValue ; xyz:codeSystem ?codeSystem .
    BIND (COALESCE(LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")), "") AS ?systemKey)
    OPTIONAL { ?listed skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; cascade:codingSystemUri ?listedUri }
    BIND (COALESCE(STR(?listedUri), IF(REGEX(?systemKey, "^[0-2](\\.(0|[1-9][0-9]*))+$"), CONCAT("urn:oid:", ?systemKey), 1/0)) AS ?datatype)
    FILTER (?datatype NOT IN ("http://snomed.info/sct", "http://hl7.org/fhir/sid/icd-10-cm"))
    BIND (REPLACE(?codeValue, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?otherCode)
    FILTER (?otherCode != "")
    BIND (cascade:conditionCodeInOtherSystem AS ?p)
    BIND (STRDT(?otherCode, IRI(?datatype)) AS ?o)
  }
  BIND (IF(BOUND(?paddedFragment), IRI(CONCAT(STR(?version), ?paddedFragment)), 1/0) AS ?paddedNode)
  BIND (IF(BOUND(?absentFragment), IRI(CONCAT(STR(?version), ?absentFragment)), 1/0) AS ?absentNode)
}
