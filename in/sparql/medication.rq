PREFIX rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd:      <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:     <http://www.w3.org/2004/02/skos/core#>
PREFIX void:     <http://rdfs.org/ns/void#>
PREFIX fx:       <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:      <http://sparql.xyz/facade-x/data/>
PREFIX dom:      <https://dom.spec.whatwg.org/#dom-node->
PREFIX v3:       <urn:hl7-org:v3>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX ccda:    <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A Medication Activity the document table makes a record of. A prescription
# and an entry on a list of what the person takes are one kind, told apart by
# the intent the mood states.
#
# Where the vocabulary holds one value and the source states several, the first
# in document order is carried:
#   - the drug's name, read in this order: the narrative its code's
#     originalText references, the originalText's own text, the material's
#     name, the code's displayName, a translation's displayName;
#   - the dosage, a Medication Free Text Sig's text, through its reference
#     first. A structured dosage is a finding of medication-findings.rq.
# Every RxNorm code, and every NDC, of the drug's code and its translations is
# carried, whichever comes first, so codes are a branch of their own. An NDC is
# Cascade's 11-digit code: a C-CDA writes the 10-digit label code with its
# hyphens, in one of three segmentings the missing digit tells apart, or 11
# digits. Ten digits with no hyphens, or any other value, are no code, and
# medication-findings.rq reports them. A code in another system, SNOMED CT
# among them, is a cascade:medicationCodeInOtherSystem literal, as result.rq
# writes a test's; a C-CDA never marks one of the codes as the one a user chose. A time
# is read as allergy.rq reads an onset.

CONSTRUCT {
  ?version ?p ?o .
  ?version cascade:paddedDateTime ?paddedNode .
  ?paddedNode cascade:paddedDateTimeProperty ?p ;
    cascade:writtenDate ?writtenTime .
  ?version cascade:valueAbsentForReason ?absentNode .
  ?absentNode cascade:absentValueProperty ?absentProperty ;
    cascade:absentReasonCode ?absentReason .
}
WHERE {
  ?root a fx:root, v3:ClinicalDocument ; ?outerSlot ?outer .
  ?outer a v3:component ; ?bodySlot ?body .
  ?body a v3:structuredBody ; ?componentSlot ?component .
  ?component a v3:component ; ?sectionSlot ?section .
  ?section a v3:section ; ?entrySlot ?entry .
  ?entry a v3:entry ; ?statementSlot ?medication .
  ?medication a v3:substanceAdministration .
  BIND (CONCAT(STRAFTER(STR(?outerSlot), "#_"), ".", STRAFTER(STR(?bodySlot), "#_"), ".",
               STRAFTER(STR(?componentSlot), "#_"), ".", STRAFTER(STR(?sectionSlot), "#_"), ".",
               STRAFTER(STR(?entrySlot), "#_"), ".", STRAFTER(STR(?statementSlot), "#_")) AS ?slots)
  ?row ccda:statementAt ?slots ; ccda:recordClass "MedicationRequest" .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?slots))) AS ?version)

  {
    ?medication xyz:moodCode ?mood .
    VALUES (?mood ?o) { ("INT" "prescribed") ("EVN" "reportedUse") }
    BIND (cascade:prescribedOrReported AS ?p)
  }
  UNION
  {
    {
      SELECT ?medication ?p (MIN(?ranked) AS ?first) WHERE {
        ?medication a v3:substanceAdministration ; ?tS ?t .
        ?t a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.16" .
        {
          ?medication ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
          ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial .
          BIND (STRAFTER(STR(?cnS), "#_") AS ?at)
          {
            BIND (cascade:drugName AS ?p)
            {
              ?material ?cS ?code . ?code a v3:code ; ?otS ?originalText .
              ?originalText a v3:originalText ; ?rfS ?reference .
              ?reference a v3:reference ; xyz:value ?pointer .
              BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?reference_)
              FILTER (STRSTARTS(?reference_, "#") && STRLEN(?reference_) > 1)
              BIND (STRAFTER(?reference_, "#") AS ?anchor)
              {
                SELECT ?anchor (SAMPLE(?written) AS ?value) WHERE {
                  ?narrative xyz:ID ?anchor .
                  OPTIONAL {
                    ?narrative dom:textcontent ?text .
                    BIND (REPLACE(REPLACE(?text, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "[ \\t\\r\\n]+", " ") AS ?written)
                  }
                } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?written) = 1)
              }
              FILTER (isLiteral(?value))
              BIND ("1" AS ?tier)
              BIND ("" AS ?within)
            }
            UNION
            {
              ?material ?cS ?code . ?code a v3:code ; ?otS ?originalText .
              ?originalText a v3:originalText ; ?vS ?value .
              FILTER (isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
              BIND ("2" AS ?tier)
              BIND (STRAFTER(STR(?vS), "#_") AS ?within)
            }
            UNION
            {
              ?material ?nmS ?name . ?name a v3:name ; ?vS ?value .
              FILTER (isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
              BIND ("3" AS ?tier)
              BIND (CONCAT(SUBSTR("0000000000", STRLEN(STRAFTER(STR(?nmS), "#_")) + 1), STRAFTER(STR(?nmS), "#_"),
                           STRAFTER(STR(?vS), "#_")) AS ?within)
            }
            UNION
            {
              ?material ?cS ?code . ?code a v3:code ; xyz:displayName ?value .
              BIND ("4" AS ?tier)
            }
            UNION
            {
              ?material ?cS ?code . ?code a v3:code ; ?trS ?translation .
              ?translation a v3:translation ; xyz:displayName ?value .
              BIND ("5" AS ?tier)
              BIND (STRAFTER(STR(?trS), "#_") AS ?within)
            }
          }
        }
        UNION
        {
          ?medication ?eS ?time . ?time a v3:effectiveTime .
          BIND (STRAFTER(STR(?eS), "#_") AS ?at)
          {
            ?time ?lS ?low . ?low a v3:low ; xyz:value ?value .
            BIND (cascade:medicationUseStartDate AS ?p)
            BIND ("1" AS ?tier)
          }
          UNION
          {
            ?time xyz:value ?value .
            BIND (cascade:medicationUseStartDate AS ?p)
            BIND ("2" AS ?tier)
          }
          UNION
          {
            ?time ?hS ?high . ?high a v3:high ; xyz:value ?value .
            BIND (cascade:medicationUseEndDate AS ?p)
            BIND ("1" AS ?tier)
          }
          FILTER (REGEX(?value, "^[0-9]{4}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?)?)?)?([+-][0-9]{4})?$"))
        }
        UNION
        {
          ?medication ?eS ?time . ?time a v3:effectiveTime .
          { ?time xyz:nullFlavor ?flavour } UNION { ?time ?lS ?low . ?low a v3:low ; xyz:nullFlavor ?flavour }
          ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey ; skos:exactMatch ?flavourCode .
          FILTER (?flavourKey = LCASE(REPLACE(?flavour, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
          BIND (CONCAT("nullFlavor ", STR(?flavourCode)) AS ?value)
          BIND (cascade:medicationUseStartDate AS ?p)
          BIND ("9" AS ?tier)
          BIND (STRAFTER(STR(?eS), "#_") AS ?at)
        }
        UNION
        {
          ?medication ?eS ?time . ?time a v3:effectiveTime ; ?hS ?high . ?high a v3:high ; xyz:nullFlavor ?flavour .
          ?flavourConcept skos:inScheme ccda:nullFlavors ; skos:notation ?flavourKey ; skos:exactMatch ?flavourCode .
          FILTER (?flavourKey = LCASE(REPLACE(?flavour, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
          BIND (CONCAT("nullFlavor ", STR(?flavourCode)) AS ?value)
          BIND (cascade:medicationUseEndDate AS ?p)
          BIND ("9" AS ?tier)
          BIND (STRAFTER(STR(?eS), "#_") AS ?at)
        }
        UNION
        {
          ?medication ?rS ?relationship . ?relationship a v3:entryRelationship ; ?sigS ?sig .
          ?sig a v3:substanceAdministration ; ?stS ?st ; ?txS ?text .
          ?st a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.147" .
          ?text a v3:text .
          BIND (cascade:dosage AS ?p)
          BIND (STRAFTER(STR(?rS), "#_") AS ?at)
          {
            ?text ?rfS ?reference . ?reference a v3:reference ; xyz:value ?pointer .
            BIND (REPLACE(?pointer, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?reference_)
            FILTER (STRSTARTS(?reference_, "#") && STRLEN(?reference_) > 1)
            BIND (STRAFTER(?reference_, "#") AS ?anchor)
            {
              SELECT ?anchor (SAMPLE(?written) AS ?value) WHERE {
                ?narrative xyz:ID ?anchor .
                OPTIONAL {
                  ?narrative dom:textcontent ?text .
                  BIND (REPLACE(REPLACE(?text, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "[ \\t\\r\\n]+", " ") AS ?written)
                }
              } GROUP BY ?anchor HAVING (COUNT(DISTINCT ?narrative) = 1 && COUNT(?written) = 1)
            }
            FILTER (isLiteral(?value))
            BIND ("1" AS ?tier)
            BIND ("" AS ?within)
          }
          UNION
          {
            ?text ?vS ?value .
            FILTER (isLiteral(?value) && STRSTARTS(STR(?vS), STR(rdf:_)))
            BIND ("2" AS ?tier)
            BIND (STRAFTER(STR(?vS), "#_") AS ?within)
          }
        }
        UNION
        {
          ?medication ?sS ?statusCode . ?statusCode a v3:statusCode ; xyz:code ?code .
          ?concept skos:inScheme ccda:medicationStatuses ; skos:notation ?key ; skos:exactMatch|skos:broadMatch ?match .
          ?match skos:notation ?value .
          FILTER (?key = LCASE(REPLACE(?code, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "")))
          BIND (cascade:workflowStatus AS ?p)
          BIND (STRAFTER(STR(?sS), "#_") AS ?at)
          BIND ("1" AS ?tier)
        }
        BIND (COALESCE(?within, "") AS ?inner)
        BIND (CONCAT(?tier, SUBSTR("0000000000", STRLEN(?at) + 1), ?at,
                     SUBSTR("00000000000000000000", STRLEN(?inner) + 1), ?inner, "|", ?value) AS ?ranked)
      } GROUP BY ?medication ?p
    }
    BIND (STRAFTER(?first, "|") AS ?value)
    BIND (IF(?p NOT IN (cascade:medicationUseStartDate, cascade:medicationUseEndDate), ?value,
          IF(REGEX(?value, "^[0-9]{10}([0-9]{2}([0-9]{2}(\\.[0-9]+)?)?)?([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2),
                          "T", SUBSTR(?value, 9, 2), ":", IF(REGEX(?value, "^[0-9]{12}"), SUBSTR(?value, 11, 2), "00"), ":",
                          IF(REGEX(?value, "^[0-9]{14}"), REPLACE(?value, "^[0-9]{12}([0-9]{2}(\\.[0-9]+)?).*$", "$1"), "00"),
                          IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")),
                   xsd:dateTime),
          IF(REGEX(?value, "^[0-9]{8}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), "-", SUBSTR(?value, 7, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:date),
          IF(REGEX(?value, "^[0-9]{6}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), "-", SUBSTR(?value, 5, 2), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYearMonth),
          IF(REGEX(?value, "^[0-9]{4}([+-][0-9]{4})?$"),
             STRDT(CONCAT(SUBSTR(?value, 1, 4), IF(REGEX(?value, "[+-][0-9]{4}$"), REPLACE(?value, "^.*([+-][0-9]{2})([0-9]{2})$", "$1:$2"), "")), xsd:gYear),
             1/0))))) AS ?o)
    BIND (IF(?p IN (cascade:medicationUseStartDate, cascade:medicationUseEndDate) && REGEX(?value, "^[0-9]{10}([0-9]{2})?([+-][0-9]{4})?$"),
             CONCAT("#padded-", STRAFTER(STR(?p), "#")), 1/0) AS ?paddedFragment)
    BIND (IF(BOUND(?paddedFragment), ?value, 1/0) AS ?writtenTime)
    BIND (IF(STRSTARTS(?value, "nullFlavor "), CONCAT("#absent-", STRAFTER(STR(?p), "#")), 1/0) AS ?absentFragment)
    BIND (IF(BOUND(?absentFragment), ?p, 1/0) AS ?absentProperty)
    BIND (IF(BOUND(?absentFragment), IRI(STRAFTER(?value, "nullFlavor ")), 1/0) AS ?absentReason)
  }
  UNION
  {
    ?medication ?tS ?t . ?t a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.16" .
    ?medication ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
    ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial .
    { ?material ?cS ?coding . ?coding a v3:code }
    UNION
    { ?material ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
    ?coding xyz:code ?statedCode ; xyz:codeSystem ?codeSystem .
    BIND (REPLACE(?statedCode, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?codeValue)
    FILTER (?codeValue != "")
    VALUES (?systemKey ?p) {
      ("2.16.840.1.113883.6.88" cascade:rxNormCode)
      ("2.16.840.1.113883.6.69" cascade:ndcCode)
    }
    ?system skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; void:uriSpace ?stem .
    FILTER (?systemKey = LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")))
    BIND (IF(?p = cascade:rxNormCode, ?codeValue,
          IF(REGEX(?codeValue, "^[0-9]{11}$"), ?codeValue,
          IF(REGEX(?codeValue, "^[0-9]{5}-[0-9]{4}-[0-9]{2}$"), REPLACE(?codeValue, "-", ""),
          IF(REGEX(?codeValue, "^[0-9]{4}-[0-9]{4}-[0-9]{2}$"), CONCAT("0", REPLACE(?codeValue, "-", "")),
          IF(REGEX(?codeValue, "^[0-9]{5}-[0-9]{3}-[0-9]{2}$"),
             CONCAT(SUBSTR(?codeValue, 1, 5), "0", SUBSTR(?codeValue, 7, 3), SUBSTR(?codeValue, 11, 2)),
          IF(REGEX(?codeValue, "^[0-9]{5}-[0-9]{4}-[0-9]$"),
             CONCAT(SUBSTR(?codeValue, 1, 5), SUBSTR(?codeValue, 7, 4), "0", SUBSTR(?codeValue, 12, 1)),
             1/0)))))) AS ?digits)
    BIND (IRI(CONCAT(?stem, ENCODE_FOR_URI(?digits))) AS ?o)
  }
  UNION
  {
    ?medication ?tS ?t . ?t a v3:templateId ; xyz:root "2.16.840.1.113883.10.20.22.4.16" .
    ?medication ?cnS ?consumable . ?consumable a v3:consumable ; ?mpS ?product .
    ?product a v3:manufacturedProduct ; ?mmS ?material . ?material a v3:manufacturedMaterial .
    { ?material ?cS ?coding . ?coding a v3:code }
    UNION
    { ?material ?cS ?code . ?code a v3:code ; ?trS ?coding . ?coding a v3:translation }
    ?coding xyz:code ?codeValue ; xyz:codeSystem ?codeSystem .
    BIND (COALESCE(LCASE(REPLACE(REPLACE(?codeSystem, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", ""), "^urn:oid:", "", "i")), "") AS ?systemKey)
    OPTIONAL { ?listed skos:inScheme ccda:codeSystems ; skos:notation ?systemKey ; cascade:codingSystemUri ?listedUri }
    BIND (COALESCE(STR(?listedUri), IF(REGEX(?systemKey, "^[0-2](\\.(0|[1-9][0-9]*))+$"), CONCAT("urn:oid:", ?systemKey), 1/0)) AS ?datatype)
    FILTER (?datatype NOT IN ("http://www.nlm.nih.gov/research/umls/rxnorm", "http://hl7.org/fhir/sid/ndc"))
    BIND (REPLACE(?codeValue, "^[ \\t\\r\\n]+|[ \\t\\r\\n]+$", "") AS ?otherCode)
    FILTER (?otherCode != "")
    BIND (cascade:medicationCodeInOtherSystem AS ?p)
    BIND (STRDT(?otherCode, IRI(?datatype)) AS ?o)
  }
  BIND (IF(BOUND(?paddedFragment), IRI(CONCAT(STR(?version), ?paddedFragment)), 1/0) AS ?paddedNode)
  BIND (IF(BOUND(?absentFragment), IRI(CONCAT(STR(?version), ?absentFragment)), 1/0) AS ?absentNode)
}
