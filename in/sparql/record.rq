PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov:    <http://www.w3.org/ns/prov#>
PREFIX oa:      <http://www.w3.org/ns/oa#>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX v3:      <urn:hl7-org:v3>
PREFIX bridge:  <https://ns.cascadeprotocol.org/bridge/v1-draft#>
PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX ccda:    <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#>

# A record is named by one of cascade-vocabulary's rules, picked as
# ../../docs/format.md#names says from what document-table.rq holds of its
# statement: RecordFromCcdaNamingRule for one with an id and
# RecordFromCcdaWithoutIdNamingRule for one without, each in the custodian's and
# the patient's scope; RecordFromDocumentNamingRule, with no source URL, where
# the document states no scope, or where the statement's id is another's of the
# document with other content. Each rule's text is its
# tests/vectors/naming/<rule>.rq body, copied, and the one picked is hashed once.
#
# The patient's name is computed again, by the same lines, for the link a
# version makes to it: a subquery cannot read another's result. A version names
# its patient only where the document has one recordTarget: with more, which
# one an entry is about is not stated.

CONSTRUCT {
  ?name a ?type ;
    cascade:sourceUrl ?sourceUrl ;
    cascade:sourceRecordId ?identifier .
  ?version prov:specializationOf ?name ;
    cascade:patient ?patient .
  [] bridge:arrivedAs ?version ;
    oa:hasSelector [ a oa:XPathSelector ; rdf:value ?selector ] .
}
WHERE {
  {
    SELECT ?row ?type ?identifier ?identifierRoot ?identifierExtension ?scoped ?selector ?name WHERE {
      bridge:thisDocument bridge:sha256 ?document .
      bridge:thisRecord bridge:selector ?recordSelector .
      ?row ccda:statementAt ?slots ;
        ccda:recordClass ?class ;
        ccda:refinement ?refinement .
      VALUES (?class ?type) {
        ("Patient"            cascade:PatientProfile)
        ("AllergyIntolerance" cascade:AllergyOrIntolerance)
        ("Condition"          cascade:ProblemOrDiagnosis)
        ("Immunization"       cascade:Vaccination)
        ("Procedure"          cascade:MedicalProcedure)
        ("MedicationRequest"  cascade:PrescribedOrReportedMedication)
        ("Observation"        cascade:LaboratoryTestResult)
      }
      OPTIONAL { ?row ccda:identifier ?identifier ; ccda:identifierRoot ?identifierRoot ; ccda:identifierExtension ?identifierExtension }
      OPTIONAL { ?row ccda:keyFingerprint ?key }
      OPTIONAL { ?row ccda:membersFingerprint ?members }
      OPTIONAL {
        {
          SELECT (MIN(?ranked) AS ?firstCustodianId) WHERE {
            ?root a fx:root, v3:ClinicalDocument ; ?custodianSlot ?custodian .
            ?custodian a v3:custodian ; ?assignedSlot ?assigned .
            ?assigned a v3:assignedCustodian ; ?organizationSlot ?organization .
            ?organization a v3:representedCustodianOrganization ; ?idSlot ?id .
            ?id a v3:id ; xyz:root ?idRoot .
            FILTER (STRLEN(?idRoot) > 0)
            FILTER NOT EXISTS { ?id xyz:nullFlavor ?idNullFlavor }
            OPTIONAL { ?id xyz:extension ?idExtension FILTER (STRLEN(?idExtension) > 0) }
            BIND (STRAFTER(STR(?idSlot), "#_") AS ?idAt)
            BIND (CONCAT(SUBSTR("0000000000", STRLEN(?idAt) + 1), ?idAt,
                         "|", REPLACE(REPLACE(?idRoot, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(COALESCE(?idExtension, ""), "%", "%25"), "\\|", "%7C")) AS ?ranked)
          }
        }
        BIND (REPLACE(REPLACE(STRBEFORE(STRAFTER(?firstCustodianId, "|"), "|"), "%7C", "|"), "%25", "%") AS ?custodianRoot)
        BIND (REPLACE(REPLACE(STRAFTER(STRAFTER(?firstCustodianId, "|"), "|"), "%7C", "|"), "%25", "%") AS ?custodianExtension)
      }
      OPTIONAL {
        {
          SELECT (SAMPLE(?patientIdRoot) AS ?patientRoot) (SAMPLE(?patientIdExtension) AS ?patientExtension)
                 (COUNT(?patientRow) AS ?patients) WHERE {
            ?patientRow ccda:recordClass "Patient" .
            OPTIONAL { ?patientRow ccda:identifierRoot ?patientIdRoot ; ccda:identifierExtension ?patientIdExtension }
          }
        }
        FILTER (?patients = 1 && BOUND(?patientRoot))
      }
      BIND (BOUND(?identifier) && EXISTS {
              ?other ccda:identifierRoot ?identifierRoot ; ccda:identifierExtension ?identifierExtension ;
                ccda:recordClass ?otherClass .
              OPTIONAL { ?other ccda:keyFingerprint ?otherKey }
              OPTIONAL { ?other ccda:membersFingerprint ?otherMembers }
              FILTER (?otherClass != ?class || COALESCE(?otherKey, "") != COALESCE(?key, "")
                      || (!BOUND(?otherKey) && !BOUND(?key) && COALESCE(?otherMembers, "") != COALESCE(?members, "")))
            } AS ?repeated)
      BIND (?patientRoot AS ?input3)
      BIND (?patientExtension AS ?input4)
      BIND (BOUND(?custodianRoot) && BOUND(?input3) && !?repeated AS ?scoped)
      BIND (CONCAT(?recordSelector, "/", ?refinement) AS ?selector)
      BIND (IF(?scoped, ?custodianRoot, ?document) AS ?input1)
      BIND (IF(?scoped, ?custodianExtension, ?selector) AS ?input2)
      BIND (IF(BOUND(?identifier), ?identifierRoot, STR(?type)) AS ?input5)
      BIND (IF(BOUND(?identifier), ?identifierExtension, COALESCE(?key, "")) AS ?input6)
      BIND (IF(BOUND(?key), "", COALESCE(?members, "")) AS ?input7)
      BIND (IF(!?scoped,
               CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromDocumentNamingRule",
                       "|", REPLACE(REPLACE(?input1, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input2, "%", "%25"), "\\|", "%7C")),
            IF(BOUND(?identifier),
               CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromCcdaNamingRule",
                       "|", REPLACE(REPLACE(?input1, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input2, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input3, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input4, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input5, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input6, "%", "%25"), "\\|", "%7C")),
               CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromCcdaWithoutIdNamingRule",
                       "|", REPLACE(REPLACE(?input1, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input2, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input3, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input4, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input5, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input6, "%", "%25"), "\\|", "%7C"),
                       "|", REPLACE(REPLACE(?input7, "%", "%25"), "\\|", "%7C")))) AS ?named)
      BIND (SHA256(?named) AS ?hash)
      BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?hash, 17, 1), "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b")
            AS ?variant)
      BIND (IRI(CONCAT("urn:uuid:", SUBSTR(?hash, 1, 8), "-", SUBSTR(?hash, 9, 4), "-8", SUBSTR(?hash, 14, 3), "-", ?variant,
                       SUBSTR(?hash, 18, 3), "-", SUBSTR(?hash, 21, 12))) AS ?name)
    }
  }
  ?row ccda:statementAt ?slots ;
    ccda:recordClass ?class .
  BIND (IRI(CONCAT("urn:cascade:version-at:", SHA256(?slots))) AS ?version)
  BIND (IF(!?scoped || !BOUND(?identifier), 1/0,
        IF(?identifierExtension != "",
           IRI(CONCAT("urn:hl7ii:", ENCODE_FOR_URI(?identifierRoot), ":", ENCODE_FOR_URI(?identifierExtension))),
        IF(REGEX(?identifierRoot, "^[0-2](\\.(0|[1-9][0-9]*))+$"), IRI(CONCAT("urn:oid:", ?identifierRoot)),
        IF(REGEX(?identifierRoot, "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"),
           IRI(CONCAT("urn:uuid:", LCASE(?identifierRoot))), 1/0)))) AS ?sourceUrl)

  OPTIONAL {
    FILTER (?class != "Patient")
    {
      SELECT (SAMPLE(?name) AS ?patient) (COUNT(?row) AS ?patientRecords) WHERE {
        bridge:thisDocument bridge:sha256 ?document .
        bridge:thisRecord bridge:selector ?recordSelector .
        ?row ccda:statementAt ?slots ;
          ccda:recordClass ?class ;
          ccda:refinement ?refinement .
        VALUES (?class ?type) {
          ("Patient"            cascade:PatientProfile)
        }
        OPTIONAL { ?row ccda:identifier ?identifier ; ccda:identifierRoot ?identifierRoot ; ccda:identifierExtension ?identifierExtension }
        OPTIONAL { ?row ccda:keyFingerprint ?key }
        OPTIONAL { ?row ccda:membersFingerprint ?members }
        OPTIONAL {
          {
            SELECT (MIN(?ranked) AS ?firstCustodianId) WHERE {
              ?root a fx:root, v3:ClinicalDocument ; ?custodianSlot ?custodian .
              ?custodian a v3:custodian ; ?assignedSlot ?assigned .
              ?assigned a v3:assignedCustodian ; ?organizationSlot ?organization .
              ?organization a v3:representedCustodianOrganization ; ?idSlot ?id .
              ?id a v3:id ; xyz:root ?idRoot .
              FILTER (STRLEN(?idRoot) > 0)
              FILTER NOT EXISTS { ?id xyz:nullFlavor ?idNullFlavor }
              OPTIONAL { ?id xyz:extension ?idExtension FILTER (STRLEN(?idExtension) > 0) }
              BIND (STRAFTER(STR(?idSlot), "#_") AS ?idAt)
              BIND (CONCAT(SUBSTR("0000000000", STRLEN(?idAt) + 1), ?idAt,
                         "|", REPLACE(REPLACE(?idRoot, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(COALESCE(?idExtension, ""), "%", "%25"), "\\|", "%7C")) AS ?ranked)
            }
          }
          BIND (REPLACE(REPLACE(STRBEFORE(STRAFTER(?firstCustodianId, "|"), "|"), "%7C", "|"), "%25", "%") AS ?custodianRoot)
          BIND (REPLACE(REPLACE(STRAFTER(STRAFTER(?firstCustodianId, "|"), "|"), "%7C", "|"), "%25", "%") AS ?custodianExtension)
        }
        BIND (BOUND(?identifier) && EXISTS {
                ?other ccda:identifierRoot ?identifierRoot ; ccda:identifierExtension ?identifierExtension ;
                  ccda:recordClass ?otherClass .
                OPTIONAL { ?other ccda:keyFingerprint ?otherKey }
                OPTIONAL { ?other ccda:membersFingerprint ?otherMembers }
                FILTER (?otherClass != ?class || COALESCE(?otherKey, "") != COALESCE(?key, "")
                        || (!BOUND(?otherKey) && !BOUND(?key) && COALESCE(?otherMembers, "") != COALESCE(?members, "")))
              } AS ?repeated)
        BIND (?identifierRoot AS ?input3)
        BIND (?identifierExtension AS ?input4)
        BIND (BOUND(?custodianRoot) && BOUND(?input3) && !?repeated AS ?scoped)
        BIND (CONCAT(?recordSelector, "/", ?refinement) AS ?selector)
        BIND (IF(?scoped, ?custodianRoot, ?document) AS ?input1)
        BIND (IF(?scoped, ?custodianExtension, ?selector) AS ?input2)
        BIND (IF(BOUND(?identifier), ?identifierRoot, STR(?type)) AS ?input5)
        BIND (IF(BOUND(?identifier), ?identifierExtension, COALESCE(?key, "")) AS ?input6)
        BIND (IF(BOUND(?key), "", COALESCE(?members, "")) AS ?input7)
        BIND (IF(!?scoped,
                 CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromDocumentNamingRule",
                         "|", REPLACE(REPLACE(?input1, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input2, "%", "%25"), "\\|", "%7C")),
              IF(BOUND(?identifier),
                 CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromCcdaNamingRule",
                         "|", REPLACE(REPLACE(?input1, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input2, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input3, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input4, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input5, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input6, "%", "%25"), "\\|", "%7C")),
                 CONCAT("90c60849-c5ef-4ca6-bfb8-8662bd07d2b5|https://ns.cascadeprotocol.org/cascade#RecordFromCcdaWithoutIdNamingRule",
                         "|", REPLACE(REPLACE(?input1, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input2, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input3, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input4, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input5, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input6, "%", "%25"), "\\|", "%7C"),
                         "|", REPLACE(REPLACE(?input7, "%", "%25"), "\\|", "%7C")))) AS ?named)
        BIND (SHA256(?named) AS ?hash)
        BIND (REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(?hash, 17, 1), "[048c]", "8"), "[159d]", "9"), "[26ae]", "a"), "[37bf]", "b")
              AS ?variant)
        BIND (IRI(CONCAT("urn:uuid:", SUBSTR(?hash, 1, 8), "-", SUBSTR(?hash, 9, 4), "-8", SUBSTR(?hash, 14, 3), "-", ?variant,
                         SUBSTR(?hash, 18, 3), "-", SUBSTR(?hash, 21, 12))) AS ?name)
      }
    }
    FILTER (?patientRecords = 1)
  }
}
