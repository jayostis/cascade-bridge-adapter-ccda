@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:criticalities a skos:ConceptScheme ;
  skos:prefLabel "C-CDA criticality to FHIR AllergyIntolerance criticality"@en .

ccda:criticalityHigh a skos:Concept ;
  skos:inScheme ccda:criticalities ;
  skos:notation "crith" ;
  skos:exactMatch [ skos:notation "high" ; skos:inScheme <http://hl7.org/fhir/allergy-intolerance-criticality> ] .

ccda:criticalityLow a skos:Concept ;
  skos:inScheme ccda:criticalities ;
  skos:notation "critl" ;
  skos:exactMatch [ skos:notation "low" ; skos:inScheme <http://hl7.org/fhir/allergy-intolerance-criticality> ] .

ccda:criticalityUnableToAssess a skos:Concept ;
  skos:inScheme ccda:criticalities ;
  skos:notation "critu" ;
  skos:exactMatch [ skos:notation "unable-to-assess" ; skos:inScheme <http://hl7.org/fhir/allergy-intolerance-criticality> ] .
