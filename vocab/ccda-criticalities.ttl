@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:criticalities a skos:ConceptScheme ;
  skos:prefLabel "C-CDA criticality to FHIR AllergyIntolerance criticality"@en .

ccda:criticalityHigh a skos:Concept ;
  skos:inScheme ccda:criticalities ;
  skos:notation "crith" ;
  skos:exactMatch <http://hl7.org/fhir/allergy-intolerance-criticality/high> .

ccda:criticalityLow a skos:Concept ;
  skos:inScheme ccda:criticalities ;
  skos:notation "critl" ;
  skos:exactMatch <http://hl7.org/fhir/allergy-intolerance-criticality/low> .

ccda:criticalityUnableToAssess a skos:Concept ;
  skos:inScheme ccda:criticalities ;
  skos:notation "critu" ;
  skos:exactMatch <http://hl7.org/fhir/allergy-intolerance-criticality/unable-to-assess> .
