@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:medicationStatuses a skos:ConceptScheme ;
  skos:prefLabel "C-CDA medication activity status to FHIR MedicationRequest status"@en .

ccda:medicationStatusActive a skos:Concept ;
  skos:inScheme ccda:medicationStatuses ;
  skos:notation "active" ;
  skos:exactMatch [ skos:notation "active" ; skos:inScheme <http://hl7.org/fhir/CodeSystem/medicationrequest-status> ] .

ccda:medicationStatusSuspended a skos:Concept ;
  skos:inScheme ccda:medicationStatuses ;
  skos:notation "suspended" ;
  skos:exactMatch [ skos:notation "on-hold" ; skos:inScheme <http://hl7.org/fhir/CodeSystem/medicationrequest-status> ] .

ccda:medicationStatusAborted a skos:Concept ;
  skos:inScheme ccda:medicationStatuses ;
  skos:notation "aborted" ;
  skos:exactMatch [ skos:notation "stopped" ; skos:inScheme <http://hl7.org/fhir/CodeSystem/medicationrequest-status> ] .

ccda:medicationStatusCompleted a skos:Concept ;
  skos:inScheme ccda:medicationStatuses ;
  skos:notation "completed" ;
  skos:exactMatch [ skos:notation "completed" ; skos:inScheme <http://hl7.org/fhir/CodeSystem/medicationrequest-status> ] .

ccda:medicationStatusNullified a skos:Concept ;
  skos:inScheme ccda:medicationStatuses ;
  skos:notation "nullified" ;
  skos:exactMatch [ skos:notation "entered-in-error" ; skos:inScheme <http://hl7.org/fhir/CodeSystem/medicationrequest-status> ] .
