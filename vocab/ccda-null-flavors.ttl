@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:nullFlavors a skos:ConceptScheme ;
  skos:prefLabel "HL7 v3 NullFlavor codes, each to the code IRI cascade-vocabulary gives it (cascade:NullFlavor), read 2026-10-24"@en ;
  dct:source <https://terminology.hl7.org/CodeSystem-v3-NullFlavor.html> , <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/partial-dates-and-absent-reasons.md> .

ccda:nullFlavorNI a skos:Concept ;
  skos:inScheme ccda:nullFlavors ;
  skos:notation "ni" ;
  skos:exactMatch <https://ns.cascadeprotocol.org/codes/nullflavor/NI> .

