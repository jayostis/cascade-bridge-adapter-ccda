  void:uriSpace "https://ns.cascadeprotocol.org/codes/rxnorm/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/issues/111> , <https://github.com/jayostis/cascade-vocabulary/blob/main/decisions/code-iris.md> .

