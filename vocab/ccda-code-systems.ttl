@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:codeSystems a skos:ConceptScheme ;
  skos:prefLabel "HL7 code system OIDs to FHIR code system URIs, each with the stem of its codes' IRIs"@en .

ccda:codeSystemRxNorm a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.6.88" ;
  skos:exactMatch <http://www.nlm.nih.gov/research/umls/rxnorm> ;
  void:uriSpace "http://www.nlm.nih.gov/research/umls/rxnorm/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/issues/111> .

ccda:codeSystemSnomedCt a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.6.96" ;
  skos:exactMatch <http://snomed.info/sct> ;
  void:uriSpace "http://snomed.info/id/" ;
  dct:source <https://terminology.hl7.org/SNOMEDCT.html> , <https://github.com/jayostis/cascade-vocabulary/issues/111> .

ccda:codeSystemLoinc a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.6.1" ;
  skos:exactMatch <http://loinc.org> ;
  void:uriSpace "http://loinc.org/rdf/" ;
  dct:source <https://github.com/HL7/UTG/blob/18bfa0662fbf6c9f6f51922e46c534b00d987848/input/sourceOfTruth/external/v3/namingSystems/v3-loinc.xml> , <https://github.com/jayostis/cascade-vocabulary/issues/111> .

ccda:codeSystemIcd10Cm a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.6.90" ;
  skos:exactMatch <http://hl7.org/fhir/sid/icd-10-cm> ;
  void:uriSpace "http://hl7.org/fhir/sid/icd-10-cm/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/issues/111> .

ccda:codeSystemIcd9Cm a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.6.103" ;
  skos:exactMatch <http://hl7.org/fhir/sid/icd-9-cm> ;
  void:uriSpace "http://hl7.org/fhir/sid/icd-9-cm/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/issues/111> .

ccda:codeSystemCpt a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.6.12" ;
  skos:exactMatch <http://www.ama-assn.org/go/cpt> ;
  void:uriSpace "http://www.ama-assn.org/go/cpt/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/issues/111> .

ccda:codeSystemCvx a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.12.292" ;
  skos:exactMatch <http://hl7.org/fhir/sid/cvx> ;
  void:uriSpace "http://hl7.org/fhir/sid/cvx/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/issues/111> .

ccda:codeSystemNdc a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.6.69" ;
  skos:exactMatch <http://hl7.org/fhir/sid/ndc> ;
  void:uriSpace "http://hl7.org/fhir/sid/ndc/" ;
  rdfs:comment "A C-CDA's NDC codes arrive as the document gives them, not normalised to 11 digits, so they are not the vocabulary's rec:NDC codes, which live in Cascade's own space."@en ;
  dct:source <https://hl7.org/fhir/R4/terminologies-systems.html> , <https://github.com/jayostis/cascade-vocabulary/issues/104> .

ccda:codeSystemUnii a skos:Concept ;
  skos:inScheme ccda:codeSystems ;
  skos:notation "2.16.840.1.113883.4.9" ;
  skos:exactMatch <http://fdasis.nlm.nih.gov> ;
  void:uriSpace "http://fdasis.nlm.nih.gov/" ;
  dct:source <https://github.com/jayostis/cascade-vocabulary/issues/111> .
