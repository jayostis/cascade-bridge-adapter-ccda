@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:allergyIntoleranceCategories a skos:ConceptScheme ;
  skos:prefLabel "C-CDA allergy and intolerance type to FHIR AllergyIntolerance category"@en .

ccda:categoryIntoleranceToFood a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceCategories ;
  skos:notation "235719002" ;
  skos:broadMatch [ skos:notation "food" ; ccda:fhirCodingSystem "http://hl7.org/fhir/allergy-intolerance-category"^^xsd:anyURI ] .

ccda:categoryAllergyToFood a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceCategories ;
  skos:notation "414285001" ;
  skos:broadMatch [ skos:notation "food" ; ccda:fhirCodingSystem "http://hl7.org/fhir/allergy-intolerance-category"^^xsd:anyURI ] .

ccda:categoryPropensityToFood a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceCategories ;
  skos:notation "418471000" ;
  skos:broadMatch [ skos:notation "food" ; ccda:fhirCodingSystem "http://hl7.org/fhir/allergy-intolerance-category"^^xsd:anyURI ] .

ccda:categoryAllergyToDrug a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceCategories ;
  skos:notation "416098002" ;
  skos:broadMatch [ skos:notation "medication" ; ccda:fhirCodingSystem "http://hl7.org/fhir/allergy-intolerance-category"^^xsd:anyURI ] .

ccda:categoryPropensityToDrug a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceCategories ;
  skos:notation "419511003" ;
  skos:broadMatch [ skos:notation "medication" ; ccda:fhirCodingSystem "http://hl7.org/fhir/allergy-intolerance-category"^^xsd:anyURI ] .

ccda:categoryIntoleranceToDrug a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceCategories ;
  skos:notation "59037007" ;
  skos:broadMatch [ skos:notation "medication" ; ccda:fhirCodingSystem "http://hl7.org/fhir/allergy-intolerance-category"^^xsd:anyURI ] .
