@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:concernStatuses a skos:ConceptScheme ;
  skos:prefLabel "C-CDA problem concern act status to FHIR Condition clinical status"@en .

ccda:concernStatusActive a skos:Concept ;
  skos:inScheme ccda:concernStatuses ;
  skos:notation "active" ;
  skos:exactMatch [ skos:notation "active" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .

ccda:concernStatusCompleted a skos:Concept ;
  skos:inScheme ccda:concernStatuses ;
  skos:notation "completed" ;
  skos:broadMatch [ skos:notation "inactive" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .

ccda:concernStatusAborted a skos:Concept ;
  skos:inScheme ccda:concernStatuses ;
  skos:notation "aborted" ;
  skos:broadMatch [ skos:notation "inactive" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .

ccda:concernStatusSuspended a skos:Concept ;
  skos:inScheme ccda:concernStatuses ;
  skos:notation "suspended" ;
  skos:broadMatch [ skos:notation "inactive" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .
