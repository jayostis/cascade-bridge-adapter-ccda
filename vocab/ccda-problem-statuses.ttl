@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:problemStatuses a skos:ConceptScheme ;
  skos:prefLabel "C-CDA problem status to FHIR Condition clinical status"@en .

ccda:problemStatusRecurrence a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "246455001" ;
  skos:exactMatch <http://terminology.hl7.org/CodeSystem/condition-clinical/recurrence> .

ccda:problemStatusRelapse a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "263855007" ;
  skos:exactMatch <http://terminology.hl7.org/CodeSystem/condition-clinical/relapse> .

ccda:problemStatusRemission a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "277022003" ;
  skos:exactMatch <http://terminology.hl7.org/CodeSystem/condition-clinical/remission> .

ccda:problemStatusResolved a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "413322009" ;
  skos:exactMatch <http://terminology.hl7.org/CodeSystem/condition-clinical/resolved> .

ccda:problemStatusActive a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "55561003" ;
  skos:exactMatch <http://terminology.hl7.org/CodeSystem/condition-clinical/active> .

ccda:problemStatusInactive a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "73425007" ;
  skos:exactMatch <http://terminology.hl7.org/CodeSystem/condition-clinical/inactive> .
