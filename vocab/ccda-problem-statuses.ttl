@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:problemStatuses a skos:ConceptScheme ;
  skos:prefLabel "C-CDA problem status to FHIR Condition clinical status"@en .

ccda:problemStatusRecurrence a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "246455001" ;
  skos:exactMatch [ skos:notation "recurrence" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .

ccda:problemStatusRelapse a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "263855007" ;
  skos:exactMatch [ skos:notation "relapse" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .

ccda:problemStatusRemission a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "277022003" ;
  skos:exactMatch [ skos:notation "remission" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .

ccda:problemStatusResolved a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "413322009" ;
  skos:exactMatch [ skos:notation "resolved" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .

ccda:problemStatusActive a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "55561003" ;
  skos:exactMatch [ skos:notation "active" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .

ccda:problemStatusInactive a skos:Concept ;
  skos:inScheme ccda:problemStatuses ;
  skos:notation "73425007" ;
  skos:exactMatch [ skos:notation "inactive" ; skos:inScheme <http://terminology.hl7.org/CodeSystem/condition-clinical> ] .
