@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ccda: <https://ns.cascadeprotocol.org/adapter/ccda/v1-draft#> .

ccda:allergyIntoleranceTypes a skos:ConceptScheme ;
  skos:prefLabel "C-CDA allergy and intolerance type to FHIR AllergyIntolerance type"@en .

ccda:typeIntoleranceToFood a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceTypes ;
  skos:notation "235719002" ;
  skos:broadMatch [ skos:notation "intolerance" ; skos:inScheme <http://hl7.org/fhir/allergy-intolerance-type> ] .

ccda:typeAllergyToFood a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceTypes ;
  skos:notation "414285001" ;
  skos:broadMatch [ skos:notation "allergy" ; skos:inScheme <http://hl7.org/fhir/allergy-intolerance-type> ] .

ccda:typeAllergyToDrug a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceTypes ;
  skos:notation "416098002" ;
  skos:broadMatch [ skos:notation "allergy" ; skos:inScheme <http://hl7.org/fhir/allergy-intolerance-type> ] .

ccda:typeAllergyToSubstance a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceTypes ;
  skos:notation "419199007" ;
  skos:broadMatch [ skos:notation "allergy" ; skos:inScheme <http://hl7.org/fhir/allergy-intolerance-type> ] .

ccda:typeIntoleranceToDrug a skos:Concept ;
  skos:inScheme ccda:allergyIntoleranceTypes ;
  skos:notation "59037007" ;
  skos:broadMatch [ skos:notation "intolerance" ; skos:inScheme <http://hl7.org/fhir/allergy-intolerance-type> ] .
