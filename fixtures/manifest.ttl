  mf:name "organization-ids-in-one-order" ;
  rdfs:comment "A custodian and two authors naming one organization, each listing its ids in another order, the custodian's first an id no identifier maps from: one record, one version read from the custodian, and one attribution in each role." ;
  mf:action [
    bridge:input <in/organization-ids-in-one-order.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
