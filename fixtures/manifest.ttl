<#results-value-kinds> a bridge:IsomorphicConversionTest ;
  mf:name "results-value-kinds" ;
  rdfs:comment "Results of every kind of value but text: a quantity written with an exponent, a ratio, a range, a one-bound range as a value with the comparator <, and a coded answer as its LOINC code; a potassium whose PQ value is not a number is text, <2.5 in mmol/L, the refused number a finding; of the reference range interpreted N neither bound is typed, since its low bound is not inclusive, which is a finding, and half a range would read as one-sided; the local translation and the first range's values are findings too." ;
  mf:action [
    bridge:input <in/results-value-kinds.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
    bridge:facts <facts/portal-download.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/results-value-kinds.ttl> ;
    bridge:expectedFindings <findings/results-value-kinds.ttl>
  ] .

<#results-identifiers> a bridge:IsomorphicConversionTest ;
  mf:name "results-identifiers" ;
  rdfs:comment "A result's ids as business identifiers, as HL7's CDA-to-FHIR identifier mapping makes them: a root and extension as the extension typed by urn:oid: and the root, a root alone as its urn:oid: IRI typed urn:ietf:rfc:3986, a UUID root as its urn:uuid: IRI in lower case; an id with a null flavour and one whose root is neither an OID nor a UUID give none." ;
  mf:action [
    bridge:input <in/results-identifiers.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
    bridge:facts <facts/portal-download.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/results-identifiers.ttl> ;
    bridge:expectedFindings <findings/results-identifiers.ttl>
  ] .

