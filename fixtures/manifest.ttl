<#medications-ndc-translations> a bridge:IsomorphicConversionTest ;
  mf:name "medications-ndc-translations" ;
  rdfs:comment "A Medication Activity whose material is coded in a portal's own code system, with two RxNorm translations and three NDC translations: both RxNorm codes and the two NDCs of a hyphenated form, as 11-digit codes, are carried, the portal's own code is a finding, and so is the NDC of ten digits with no hyphens, whose segments cannot be told." ;
  mf:action [
    bridge:input <in/medications-ndc-translations.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
    bridge:facts <facts/portal-download.ttl>
