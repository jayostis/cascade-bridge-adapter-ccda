<#result-code-system-not-an-oid> a bridge:IsomorphicConversionTest ;
  mf:name "result-code-system-not-an-oid" ;
  rdfs:comment "A result whose code names its code system as LOINC instead of by OID: the code is not carried and is a finding, ccda:codeNotCarried." ;
