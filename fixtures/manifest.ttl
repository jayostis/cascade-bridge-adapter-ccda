<#result-code-without-code> a bridge:IsomorphicConversionTest ;
  mf:name "result-code-without-code" ;
  rdfs:comment "A result whose code states a code system and no code: nothing is carried for it and it is a finding, ccda:codeNotCarried." ;
  mf:action [
