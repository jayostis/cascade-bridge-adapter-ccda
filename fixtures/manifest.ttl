<#custodian-and-author> a bridge:IsomorphicConversionTest ;
  mf:name "custodian-and-author" ;
  rdfs:comment "A custodian and an author naming one organization by one id: one record, its version read from the custodian; the author's address, which that version does not carry, is a finding." ;
  mf:action [
    bridge:input <in/custodian-and-author.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
    bridge:facts <facts/portal-download.ttl>
