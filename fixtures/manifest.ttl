<#download-twice-names-one-allergy> a bridge:IdentityRelationTest ;
  mf:name "download-twice-names-one-allergy" ;
  mf:action [
    bridge:conversion [
      bridge:input <in/download-a.xml> ;
      bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
      bridge:facts <facts/portal-download.ttl> ;
      bridge:selector "/*[local-name()='ClinicalDocument' and namespace-uri()='urn:hl7-org:v3']/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='structuredBody' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='section' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='entry' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='act' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='entryRelationship' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='observation' and namespace-uri()='urn:hl7-org:v3'][1]"
    ] , [
      bridge:input <in/download-b.xml> ;
      bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
      bridge:facts <facts/portal-download.ttl> ;
      bridge:selector "/*[local-name()='ClinicalDocument' and namespace-uri()='urn:hl7-org:v3']/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='structuredBody' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='component' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='section' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='entry' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='act' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='entryRelationship' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='observation' and namespace-uri()='urn:hl7-org:v3'][1]"
    ]
  ] ;
  mf:result [ bridge:sameRecord true ] .

<#two-documents-name-one-custodian> a bridge:IdentityRelationTest ;
  mf:name "two-documents-name-one-custodian" ;
  rdfs:comment "Two documents whose custodians carry one id name one organization record." ;
  mf:action [
    bridge:conversion [
      bridge:input <in/custodian-and-author.xml> ;
      bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
      bridge:facts <facts/portal-download.ttl> ;
      bridge:selector "/*[local-name()='ClinicalDocument' and namespace-uri()='urn:hl7-org:v3']/*[local-name()='custodian' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='assignedCustodian' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='representedCustodianOrganization' and namespace-uri()='urn:hl7-org:v3'][1]"
    ] , [
      bridge:input <in/download-a.xml> ;
      bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
      bridge:facts <facts/portal-download.ttl> ;
      bridge:selector "/*[local-name()='ClinicalDocument' and namespace-uri()='urn:hl7-org:v3']/*[local-name()='custodian' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='assignedCustodian' and namespace-uri()='urn:hl7-org:v3'][1]/*[local-name()='representedCustodianOrganization' and namespace-uri()='urn:hl7-org:v3'][1]"
    ]
  ] ;
  mf:result [ bridge:sameRecord true ] .

