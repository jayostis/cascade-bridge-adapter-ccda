@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix bridge: <https://ns.cascadeprotocol.org/bridge/v1-draft#> .

<> a mf:Manifest ;
  rdfs:label "cascade-bridge-adapter-ccda fixture cases" ;
  bridge:adapter <../> ;
  mf:entries (
    <#allergies-section>
    <#cerner-summarization>
    <#epic-summarization>
    <#full-summarization>
    <#immunizations-section>
    <#labs-section>
    <#narrative-only-section>
    <#custodian-and-author>
    <#organizations-root-and-extension>
    <#organization-ids-in-one-order>
    <#allergy-unii-allergen>
    <#medications-ndc-translations>
    <#several-ids>
    <#repeated-ids>
    <#download-a>
    <#download-b>
    <#not-a-ccda>
    <#procedures>
    <#shared-id>
    <#negations>
    <#concern-status-beside-a-problem-status>
    <#narrative-reference-without-hash>
    <#narrative-id-twice>
    <#download-c>
    <#download-d>
    <#medications-and-results-a>
    <#medications-and-results-edges>
    <#results-value-kinds>
    <#null-flavors>
    <#null-flavors-not-listed>
    <#times-by-precision>
    <#results-identifiers>
    <#medications-and-results-b>
    <#fingerprint-keys>
    <#download-twice-names-one-allergy>
    <#two-documents-name-one-custodian>
    <#ids-in-two-orders-name-one-organization>
    <#ids-in-two-orders-scope-one-patient>
    <#download-twice-nullflavor-id-names-one-allergy>
    <#id-bearing-differs-from-nullflavor-id>
    <#one-id-two-keys-names-two-records>
    <#one-id-one-key-differs-from-one-id-two-keys>
    <#one-id-on-an-allergy-and-a-problem-names-two-records>
    <#download-twice-id-less-problem-names-one-record>
    <#download-twice-id-less-immunization-names-one-record>
    <#id-bearing-procedure-differs-from-id-less>
    <#download-twice-names-one-medication>
    <#download-twice-id-less-medication-names-one-record>
    <#download-twice-id-less-result-names-one-record>
    <#two-patients>
    <#no-record-target>
    <#one-id-equal-keys>
    <#narrative-reference-to-markup>
    <#fingerprint-repeated-and-reordered>
    <#id-root-with-bar>
    <#custodian-ids-naming-no-organization>
    <#fingerprint-values-reordered>
    <#a-patient-of-two-is-not-named-by-its-id>
    <#one-id-on-a-problem-and-a-procedure-with-equal-keys-names-two-records>
    <#one-id-on-two-procedures-without-key-and-other-members-names-two-records>
    <#a-value-stated-twice-names-the-record-of-it-stated-once>
    <#values-in-another-order-name-one-record>
    <#patient-deceased>
    <#patient-gender-and-death-edges>
    <#codes-in-other-systems>
    <#result-interpretation-in-another-system>
    <#result-interpretation-not-carried>
    <#result-interpretation-null-flavor>
    <#procedure-two-cpt-codes>
    <#procedure-two-snomed-ct-codes>
    <#procedure-icd9-cm-procedure-oid>
    <#condition-icd9-cm-under-its-other-oids>
    <#result-codes-padded-with-spaces>
    <#result-code-system-urn-oid-capitals>
    <#result-code-blank>
    <#result-code-without-code>
    <#result-code-system-not-an-oid>
    <#result-test-code-in-snomed-ct>
    <#allergy-codes-in-other-systems>
  ) .

<#allergies-section> a bridge:IsomorphicConversionTest ;
  mf:name "allergies-section" ;
  mf:action [
    bridge:input <in/allergies-section.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
    bridge:facts <facts/portal-download.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/allergies-section.ttl> ;
    bridge:expectedFindings <findings/allergies-section.ttl>
  ] .

<#cerner-summarization> a bridge:IsomorphicConversionTest ;
  mf:name "cerner-summarization" ;
  mf:action [
    bridge:input <in/cerner-summarization.xml> ;
