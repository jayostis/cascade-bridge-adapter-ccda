<#medications-ndc-translations> a bridge:IsomorphicConversionTest ;
  mf:name "medications-ndc-translations" ;
  rdfs:comment "A Medication Activity whose material is coded in a portal's own code system, with two RxNorm translations and three NDC translations: both RxNorm codes and the two NDCs of a hyphenated form, as 11-digit codes, are carried, the portal's own code as a cascade:medicationCodeInOtherSystem literal typed by urn:oid: and the portal's OID, and the NDC of ten digits with no hyphens, whose segments cannot be told, is a finding." ;
  mf:action [
    bridge:input <in/medications-ndc-translations.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
    bridge:facts <facts/portal-download.ttl>
  ] ;
  mf:result [
    bridge:expectedGraph <expected/medications-ndc-translations.ttl> ;
    bridge:expectedFindings <findings/medications-ndc-translations.ttl>
  ] .

