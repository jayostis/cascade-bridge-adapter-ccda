    bridge:expectedFindings <findings/custodian-and-author.ttl>
  ] .

<#organizations-root-and-extension> a bridge:IsomorphicConversionTest ;
  mf:name "organizations-root-and-extension" ;
  rdfs:comment "The custodian's NPI names its organization record, the name the FHIR R4 adapter's bundle-document-custodian-and-authors gives an Organization with that NPI: cascade-vocabulary's organization-from-npi naming vector." ;
  mf:action [
    bridge:input <in/organizations-root-and-extension.xml> ;
    bridge:envelope <../ro-crate-metadata.json#envelope-document> ;
    bridge:facts <facts/portal-download.ttl>
