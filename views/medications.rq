PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?drugName ?rxNormCode ?prescribedOrReported ?workflowStatus ?medicationUseStartDate ?medicationUseEndDate ?prescriptionWrittenDate ?dosage
WHERE {
  ?record a cascade:PrescribedOrReportedMedication .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record cascade:currentRevision/cascade:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record cascade:sourceRecordId ?id } UNION { ?version cascade:sourceRecordId ?id } }
  OPTIONAL { ?version cascade:drugName ?n }
  OPTIONAL { ?version cascade:rxNormCode ?c }
  OPTIONAL { ?version cascade:prescribedOrReported ?i }
  OPTIONAL { ?version cascade:workflowStatus ?s }
  OPTIONAL { ?version cascade:medicationUseStartDate ?b }
  OPTIONAL { ?version cascade:medicationUseEndDate ?e }
  OPTIONAL { ?version cascade:prescriptionWrittenDate ?w }
  OPTIONAL { ?version cascade:dosage ?g }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?n) AS ?drugName)
  BIND (REPLACE(STR(?c), "^https://ns.cascadeprotocol.org/codes/rxnorm/", "") AS ?rxNormCode)
  BIND (STR(?i) AS ?prescribedOrReported)
  BIND (STR(?s) AS ?workflowStatus)
  BIND (STR(?b) AS ?medicationUseStartDate)
  BIND (STR(?e) AS ?medicationUseEndDate)
  BIND (STR(?w) AS ?prescriptionWrittenDate)
  BIND (STR(?g) AS ?dosage)
}
