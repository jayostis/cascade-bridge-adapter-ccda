PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?drugName ?rxNormCode ?clinicalIntent ?status ?startDate ?endDate ?dosage
WHERE {
  ?record a clinical:Medication .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record rec:currentRevision/rec:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record clinical:sourceRecordId ?id } UNION { ?version clinical:sourceRecordId ?id } }
  OPTIONAL { ?version clinical:drugName ?n }
  OPTIONAL { ?version clinical:rxNormCode ?c }
  OPTIONAL { ?version clinical:clinicalIntent ?i }
  OPTIONAL { ?version clinical:status ?s }
  OPTIONAL { ?version clinical:startDate ?b }
  OPTIONAL { ?version clinical:endDate ?e }
  OPTIONAL { ?version clinical:dosage ?g }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?n) AS ?drugName)
  BIND (REPLACE(STR(?c), "^http://www.nlm.nih.gov/research/umls/rxnorm/", "") AS ?rxNormCode)
  BIND (STR(?i) AS ?clinicalIntent)
  BIND (STR(?s) AS ?status)
  BIND (STR(?b) AS ?startDate)
  BIND (STR(?e) AS ?endDate)
  BIND (STR(?g) AS ?dosage)
}
