PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?dateOfBirth ?givenName ?familyName ?name
WHERE {
  ?record a cascade:PatientProfile .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record rec:currentRevision/rec:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record cascade:sourceRecordId ?id } UNION { ?version cascade:sourceRecordId ?id } }
  OPTIONAL { ?version cascade:dateOfBirth ?b }
  OPTIONAL { ?version foaf:givenName ?g }
  OPTIONAL { ?version foaf:familyName ?f }
  OPTIONAL { ?version foaf:name ?n }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?b) AS ?dateOfBirth)
  BIND (STR(?g) AS ?givenName)
  BIND (STR(?f) AS ?familyName)
  BIND (STR(?n) AS ?name)
}
