PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?testName ?loincCode ?resultValue ?resultUnit ?referenceRange ?interpretation ?status ?performedDate
WHERE {
  ?record a health:LabResultRecord .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record rec:currentRevision/rec:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record health:sourceRecordId ?id } UNION { ?version health:sourceRecordId ?id } }
  OPTIONAL { ?version health:testName ?n }
  OPTIONAL { ?version health:testCode ?c }
  OPTIONAL { ?version health:resultValue ?v }
  OPTIONAL { ?version health:resultUnit ?u }
  OPTIONAL { ?version health:referenceRange ?r }
  OPTIONAL { ?version health:interpretation ?i }
  OPTIONAL { ?version clinical:status ?s }
  OPTIONAL { ?version health:performedDate ?d }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?n) AS ?testName)
  BIND (REPLACE(STR(?c), "^http://loinc.org/rdf/", "") AS ?loincCode)
  BIND (STR(?v) AS ?resultValue)
  BIND (STR(?u) AS ?resultUnit)
  BIND (STR(?r) AS ?referenceRange)
  BIND (STR(?i) AS ?interpretation)
  BIND (STR(?s) AS ?status)
  BIND (STR(?d) AS ?performedDate)
}
