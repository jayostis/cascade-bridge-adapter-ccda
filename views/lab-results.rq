PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?testName ?loincCode ?resultValue ?resultUnit ?referenceRange ?resultInterpretation ?workflowStatus ?resultClinicallyRelevantTime
WHERE {
  ?record a cascade:LaboratoryTestResult .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record cascade:currentRevision/cascade:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record cascade:sourceRecordId ?id } UNION { ?version cascade:sourceRecordId ?id } }
  OPTIONAL { ?version cascade:testName ?n }
  OPTIONAL { ?version cascade:testCode ?c }
  OPTIONAL { ?version cascade:resultValue ?text }
  OPTIONAL {
    ?version cascade:resultQuantity ?quantity .
    ?quantity cascade:writtenValue ?written .
    OPTIONAL { ?quantity cascade:quantityComparator ?comparator }
    OPTIONAL { ?quantity cascade:unitText ?unitText }
    OPTIONAL { ?quantity cascade:ucumUnit ?ucumUnit }
  }
  OPTIONAL { ?version cascade:referenceRange ?r }
  OPTIONAL { ?version cascade:resultInterpretation ?i }
  OPTIONAL { ?version cascade:workflowStatus ?s }
  OPTIONAL { ?version cascade:resultClinicallyRelevantTime ?d }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?n) AS ?testName)
  BIND (REPLACE(STR(?c), "^http://loinc.org/rdf/", "") AS ?loincCode)
  BIND (STR(COALESCE(CONCAT(COALESCE(?comparator, ""), ?written), ?text)) AS ?resultValue)
  BIND (STR(COALESCE(?unitText, ?ucumUnit)) AS ?resultUnit)
  BIND (STR(?r) AS ?referenceRange)
  BIND (STR(?i) AS ?resultInterpretation)
  BIND (STR(?s) AS ?workflowStatus)
  BIND (STR(?d) AS ?resultClinicallyRelevantTime)
}
