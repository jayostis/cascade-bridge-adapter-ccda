PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?allergen ?allergenCode ?status ?verificationStatus ?criticality ?onsetDate
WHERE {
  ?record a health:AllergyRecord .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record rec:currentRevision/rec:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record health:sourceRecordId ?id } UNION { ?version health:sourceRecordId ?id } }
  OPTIONAL { ?version health:allergen ?a }
  OPTIONAL { ?version health:allergenCode ?c }
  OPTIONAL { ?version clinical:status ?s }
  OPTIONAL { ?version clinical:verificationStatus ?v }
  OPTIONAL { ?version clinical:criticality ?k }
  OPTIONAL { ?version health:onsetDate ?o }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?a) AS ?allergen)
  BIND (STR(?c) AS ?allergenCode)
  BIND (STR(?s) AS ?status)
  BIND (STR(?v) AS ?verificationStatus)
  BIND (STR(?k) AS ?criticality)
  BIND (STR(?o) AS ?onsetDate)
}
