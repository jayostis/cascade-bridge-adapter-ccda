PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?vaccineName ?vaccineCode ?workflowStatus ?vaccinationOccurrenceTime
WHERE {
  ?record a cascade:Vaccination .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record cascade:currentRevision/cascade:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record cascade:sourceRecordId ?id } UNION { ?version cascade:sourceRecordId ?id } }
  OPTIONAL { ?version cascade:vaccineName ?n }
  OPTIONAL { ?version cascade:vaccineCode ?c }
  OPTIONAL { ?version cascade:workflowStatus ?s }
  OPTIONAL { ?version cascade:vaccinationOccurrenceTime ?d }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?n) AS ?vaccineName)
  BIND (REPLACE(STR(?c), "^https://ns.cascadeprotocol.org/codes/cvx/", "") AS ?vaccineCode)
  BIND (STR(?s) AS ?workflowStatus)
  BIND (STR(?d) AS ?vaccinationOccurrenceTime)
}
