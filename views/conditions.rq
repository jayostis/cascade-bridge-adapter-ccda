PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?conditionName ?clinicalStatus ?verificationStatus ?onsetDate ?abatementDate ?snomedCode ?icd10Code
WHERE {
  ?record a cascade:ProblemOrDiagnosis .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record cascade:currentRevision/cascade:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record cascade:sourceRecordId ?id } UNION { ?version cascade:sourceRecordId ?id } }
  OPTIONAL { ?version cascade:conditionName ?n }
  OPTIONAL { ?version cascade:clinicalStatus ?s }
  OPTIONAL { ?version cascade:verificationStatus ?v }
  OPTIONAL { ?version cascade:onsetDate ?o }
  OPTIONAL { ?version cascade:abatementDate ?e }
  OPTIONAL { ?version cascade:snomedCode ?sct }
  OPTIONAL { ?version cascade:icd10Code ?icd }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?n) AS ?conditionName)
  BIND (STR(?s) AS ?clinicalStatus)
  BIND (STR(?v) AS ?verificationStatus)
  BIND (STR(?o) AS ?onsetDate)
  BIND (STR(?e) AS ?abatementDate)
  BIND (REPLACE(STR(?sct), "^http://snomed.info/id/", "") AS ?snomedCode)
  BIND (REPLACE(STR(?icd), "^https://ns.cascadeprotocol.org/codes/icd10cm/", "") AS ?icd10Code)
}
