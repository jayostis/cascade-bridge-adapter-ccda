PREFIX cascade: <https://ns.cascadeprotocol.org/cascade#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?procedureName ?snomedCode ?workflowStatus ?procedureDate
WHERE {
  ?record a cascade:MedicalProcedure .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record cascade:currentRevision/cascade:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record cascade:sourceRecordId ?id } UNION { ?version cascade:sourceRecordId ?id } }
  OPTIONAL { ?version cascade:procedureName ?n }
  OPTIONAL { ?version cascade:snomedCode ?c }
  OPTIONAL { ?version cascade:workflowStatus ?s }
  OPTIONAL { ?version cascade:procedureDate ?d }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?n) AS ?procedureName)
  BIND (REPLACE(STR(?c), "^http://snomed.info/id/", "") AS ?snomedCode)
  BIND (STR(?s) AS ?workflowStatus)
  BIND (STR(?d) AS ?procedureDate)
}
