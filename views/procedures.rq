PREFIX health: <https://ns.cascadeprotocol.org/health/v1#>
PREFIX clinical: <https://ns.cascadeprotocol.org/clinical/v1#>
PREFIX cascade: <https://ns.cascadeprotocol.org/core/v1#>
PREFIX rec: <https://ns.cascadeprotocol.org/records/v1-draft#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT DISTINCT ?record ?sourceRecordId ?procedureName ?snomedCode ?status ?procedureDate
WHERE {
  ?record a clinical:Procedure .
  ?version prov:specializationOf ?record .
  OPTIONAL { ?record rec:currentRevision/rec:version ?current }
  FILTER (!BOUND(?current) || ?current = ?version)
  OPTIONAL { { ?record clinical:sourceRecordId ?id } UNION { ?version clinical:sourceRecordId ?id } }
  OPTIONAL { ?version clinical:procedureName ?n }
  OPTIONAL { ?version clinical:snomedCode ?c }
  OPTIONAL { ?version clinical:status ?s }
  OPTIONAL { ?version clinical:procedureDate ?d }
  BIND (STR(?id) AS ?sourceRecordId)
  BIND (STR(?n) AS ?procedureName)
  BIND (REPLACE(STR(?c), "^http://snomed.info/sct/", "") AS ?snomedCode)
  BIND (STR(?s) AS ?status)
  BIND (STR(?d) AS ?procedureDate)
}
